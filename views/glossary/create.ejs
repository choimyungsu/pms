<%- include('../partials/header', { page: 'glossary_create' }) %>
<%- include('../partials/sidebar', { page: 'glossary_create' }) %>

<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">용어 등록</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <% if (message) { %>
                        <div class="alert alert-success" role="alert">
                            <%= message %>
                        </div>
                    <% } %>
                    <% if (error) { %>
                        <div class="alert alert-danger" role="alert">
                            <%= error %>
                        </div>
                    <% } %>
                    <form action="/glossary" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="term" class="form-label">용어</label>
                            <input type="text" class="form-control" id="term" name="term" required>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">설명</label>
                            <textarea class="form-control" id="description" name="description" rows="10"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="image" class="form-label">대표 이미지</label>
                            <input type="file" class="form-control" id="image" name="image" accept="image/*">
                            <small class="form-text text-muted">용어의 대표 이미지를 등록합니다. (선택 사항)</small>
                        </div>
                        <button type="submit" class="btn btn-primary">등록</button>
                        <a href="/glossary" class="btn btn-secondary">취소</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="https://cdn.ckeditor.com/ckeditor5/35.3.2/classic/ckeditor.js"></script>
<script>
    // Custom Upload Adapter Plugin
    function MyUploadAdapterPlugin(editor) {
        editor.plugins.get('FileRepository').createUploadAdapter = (loader) => {
            return new MyUploadAdapter(loader);
        };
    }

    // Custom Upload Adapter Class
    class MyUploadAdapter {
        constructor(loader) {
            this.loader = loader;
        }

        upload() {
            return this.loader.file
                .then(file => new Promise((resolve, reject) => {
                    const formData = new FormData();
                    formData.append('image', file);

                    fetch('/glossary/upload-image', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => {
                        if (response.ok) {
                            return response.json();
                        } else {
                            return response.text().then(text => {
                                throw new Error(`Server responded with ${response.status}: ${text}`);
                            });
                        }
                    })
                    .then(data => {
                        if (data.success && data.filePath) {
                            resolve({
                                default: data.filePath
                            });
                        } else {
                            reject(data.message || 'Upload failed');
                        }
                    })
                    .catch(error => {
                        console.error('CKEditor image upload failed:', error);
                        reject(error);
                    });
                }));
        }

        abort() {
            // Abort logic can be implemented here
        }
    }

    // Initialize CKEditor with the custom adapter
    ClassicEditor
        .create(document.querySelector('#description'), {
            extraPlugins: [MyUploadAdapterPlugin],
        })
        .catch(error => {
            console.error(error);
        });
</script>

<%- include('../partials/footer') %>