<%- include('../partials/header', { page: 'knowledge' }) %>
<%- include('../partials/sidebar', { page: 'knowledge' }) %>

<%
  // ---------- 화면 표시용 헬퍼 (기능 변경 없음, 표현만 개선) ----------
  const TYPE_CLASS = {
    '회의': 'k-type-meeting',
    '보고': 'k-type-report',
    '요구사항': 'k-type-req',
    '설명': 'k-type-desc',
    '이슈': 'k-type-issue',
    '자료': 'k-type-data'
  };
  const STATUS_CLASS = {
    '완료': 'k-status-done',
    '종료': 'k-status-done',
    '진행중': 'k-status-ing',
    '진행': 'k-status-ing',
    '검토중': 'k-status-wait',
    '대기': 'k-status-wait',
    '보류': 'k-status-wait'
  };

  const isBlank = (v) => (v === null || v === undefined || String(v).trim() === '');
  const dateOnly = (v) => (isBlank(v) ? '' : String(v).substring(0, 10));
  const dateTimeText = (v) => {
    if (isBlank(v)) return '';
    const raw = String(v);
    const datePart = raw.substring(0, 10);
    const m = raw.match(/(\d{2}:\d{2})/);
    return m ? datePart + ' ' + m[1] : datePart;
  };
  const fileIconOf = (name) => {
    const ext = String(name || '').split('.').pop().toLowerCase();
    if (['xls', 'xlsx', 'csv'].indexOf(ext) !== -1) return 'fa-file-excel';
    if (['doc', 'docx', 'hwp', 'hwpx', 'odt', 'txt', 'md', 'rtf'].indexOf(ext) !== -1) return 'fa-file-word';
    if (['ppt', 'pptx', 'odp'].indexOf(ext) !== -1) return 'fa-file-powerpoint';
    if (ext === 'pdf') return 'fa-file-pdf';
    if (['zip', '7z', 'rar', 'tar', 'gz'].indexOf(ext) !== -1) return 'fa-file-archive';
    if (['png', 'jpg', 'jpeg', 'gif', 'bmp', 'webp', 'svg'].indexOf(ext) !== -1) return 'fa-file-image';
    return 'fa-file';
  };

  const itemType = item ? (item.type || '') : '';
  const itemStatus = item ? String(item.status || '').trim() : '';
  const attCount = (attachments && attachments.length) ? attachments.length : 0;
  const canEdit = currentUser && item && (currentUser.role === 'admin' || currentUser.id === item.creator_id);
  const hasPeriod = item && (!isBlank(item.start_date) || !isBlank(item.end_date) || !isBlank(item.planned_date));
%>

<style>
/* =================== 지식 상세 (개편) =================== */
.knowledge-page .app-content {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 135px);
}
.knowledge-page .app-content > .container-fluid {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
}

#split-row {
    display: flex;
    flex-wrap: nowrap;
    position: relative;
    flex: 1;
    min-height: 0;
}
#tree-col {
    min-width: 210px;
    max-width: 560px;
    flex: 0 0 300px;
    display: flex;
    flex-direction: column;
    min-height: 0;
}
#tree-col .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    margin-bottom: 0;
}
#tree-col .card-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: .6rem .7rem;
}
#splitter-bar {
    width: 8px;
    background: transparent;
    cursor: col-resize;
    z-index: 10;
    position: relative;
}
#splitter-bar::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 50%;
    transform: translateY(-50%);
    width: 2px;
    height: 44px;
    border-radius: 2px;
    background: #e3e8ef;
    transition: background .15s ease;
}
#splitter-bar:hover::before { background: #b9c6d6; }

#right-col {
    min-width: 0;
    flex: 1 1 0%;
    display: flex;
    flex-direction: column;
    gap: .85rem;
    overflow-y: auto;
    padding-right: 2px;
    padding-bottom: .5rem;
}
#right-col .card { flex: 0 0 auto; margin-bottom: 0; }

/* ---- 상세 헤더 ---- */
.k-detail-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
}
.k-detail-title {
    font-size: 1.12rem;
    font-weight: 700;
    color: #1f2a3a;
    margin: 0 0 .4rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
}
.k-detail-badges { display: flex; gap: .35rem; align-items: center; flex-wrap: wrap; }
.k-detail-actions { display: flex; gap: .35rem; flex-shrink: 0; flex-wrap: wrap; }
.k-detail-actions .btn { white-space: nowrap; }

/* ---- 배지 ---- */
.k-type {
    display: inline-block;
    padding: .16rem .55rem;
    border-radius: 1rem;
    font-size: .74rem;
    font-weight: 600;
    white-space: nowrap;
    background: #eef2f7;
    color: #55637a;
}
.k-type-meeting { background: #e7f1ff; color: #2f6bbd; }
.k-type-report  { background: #e8f6ec; color: #2b7a45; }
.k-type-req     { background: #f0eaff; color: #6a45c2; }
.k-type-desc    { background: #eaf6f8; color: #21717f; }
.k-type-issue   { background: #fdecec; color: #b93a3a; }
.k-type-data    { background: #fdf3e3; color: #96631a; }

.k-status {
    display: inline-block;
    padding: .16rem .55rem;
    border-radius: .25rem;
    font-size: .74rem;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid transparent;
}
.k-status-done { background: #eef8f1; color: #2b7a45; border-color: #cfe9d8; }
.k-status-ing  { background: #eaf3ff; color: #2f6bbd; border-color: #cfe2fb; }
.k-status-wait { background: #fff8e6; color: #9a6b00; border-color: #ffe6ae; }
.k-status-default { background: #f1f3f6; color: #5b6779; border-color: #e2e6ec; }

.k-none { color: #c3cad3; font-size: .76rem; font-style: italic; }

/* ---- 메타 그리드 ---- */
.k-section { padding: 1rem 1.15rem; }
.k-section + .k-section { border-top: 1px solid #eef1f5; }
.k-section-title {
    font-size: .78rem;
    font-weight: 700;
    color: #6b7788;
    letter-spacing: .02em;
    margin: 0 0 .7rem;
    display: flex;
    align-items: center;
    gap: .4rem;
}
.k-section-title i { color: #9aa8ba; font-size: .78rem; }
.k-section-title .k-count {
    font-weight: 600;
    font-size: .68rem;
    color: #4a6fa5;
    background: #e8eefb;
    border-radius: .7rem;
    padding: .06rem .45rem;
}

.k-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(168px, 1fr));
    gap: .1rem 1.4rem;
    margin: 0;
}
.k-meta-grid .k-meta-item { display: flex; gap: .5rem; padding: .34rem 0; min-width: 0; }
.k-meta-grid dt {
    flex: 0 0 62px;
    font-weight: 500;
    font-size: .78rem;
    color: #8b95a4;
    margin: 0;
}
.k-meta-grid dd {
    flex: 1 1 auto;
    margin: 0;
    font-size: .84rem;
    color: #2b3648;
    min-width: 0;
    overflow-wrap: anywhere;
}
.k-meta-grid dd a { color: #1a4b8c; text-decoration: none; font-weight: 500; }
.k-meta-grid dd a:hover { text-decoration: underline; }

/* ---- 기간 정보 ---- */
.k-period {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: .6rem;
}
.k-period-item {
    background: #f8fafc;
    border: 1px solid #eaeef4;
    border-radius: .4rem;
    padding: .5rem .65rem;
}
.k-period-item .k-period-label {
    display: block;
    font-size: .72rem;
    color: #8b95a4;
    margin-bottom: .1rem;
}
.k-period-item .k-period-value {
    font-size: .86rem;
    font-weight: 600;
    color: #2b3648;
    font-variant-numeric: tabular-nums;
}

/* ---- 설명 ---- */
.k-desc-block + .k-descr-block { margin-top: .8rem; }
.k-desc-label {
    font-size: .75rem;
    font-weight: 600;
    color: #7b8798;
    margin-bottom: .35rem;
}
.k-desc-body {
    background: #fbfcfd;
    border: 1px solid #eef1f5;
    border-left: 3px solid #dbe4f0;
    border-radius: .35rem;
    padding: .75rem .9rem;
    font-size: .86rem;
    line-height: 1.65;
    color: #2b3648;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin: 0;
    font-family: inherit;
}

/* ---- 첨부파일 ---- */
.k-att-list { display: flex; flex-direction: column; gap: .35rem; }
.k-att-item {
    display: flex;
    align-items: center;
    gap: .55rem;
    padding: .5rem .65rem;
    border: 1px solid #eaeef4;
    border-radius: .4rem;
    background: #fbfcfd;
    text-decoration: none;
    color: #2b3648;
    transition: border-color .15s ease, background .15s ease;
}
.k-att-item:hover {
    background: #f3f8ff;
    border-color: #c5d9f5;
    color: #1a4b8c;
    text-decoration: none;
}
.k-att-item > i { color: #7a93b5; font-size: .95rem; flex: 0 0 auto; width: 1.1rem; text-align: center; }
.k-att-item .k-att-name { flex: 1 1 auto; font-size: .84rem; overflow-wrap: anywhere; }
.k-att-item .k-att-dl { color: #a8b4c4; font-size: .74rem; flex: 0 0 auto; }
.k-att-empty {
    color: #a9b1bc;
    font-size: .82rem;
    font-style: italic;
    padding: .35rem 0;
}

/* ---- 댓글 ---- */
.k-comment-list { display: flex; flex-direction: column; gap: .55rem; margin-bottom: .9rem; }
.k-comment {
    display: flex;
    gap: .6rem;
    padding: .65rem .8rem;
    border: 1px solid #eef1f5;
    border-radius: .45rem;
    background: #fff;
}
.k-comment-avatar {
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #e8eefb;
    color: #40679b;
    font-size: .78rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    user-select: none;
}
.k-comment-main { flex: 1 1 auto; min-width: 0; }
.k-comment-top {
    display: flex;
    align-items: center;
    gap: .45rem;
    flex-wrap: wrap;
    margin-bottom: .2rem;
}
.k-comment-author { font-size: .82rem; font-weight: 600; color: #2b3648; }
.k-comment-time { font-size: .71rem; color: #a3acb9; }
.k-comment-actions { margin-left: auto; display: flex; gap: .2rem; }
.k-comment-actions .btn { padding: .08rem .38rem; font-size: .7rem; line-height: 1.4; }
.k-comment-body {
    font-size: .84rem;
    line-height: 1.55;
    color: #3b4759;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}
.k-comment-empty {
    color: #a9b1bc;
    font-size: .82rem;
    font-style: italic;
    padding: .6rem .2rem;
}

#comment-content { resize: vertical; min-height: 74px; }
.k-comment-form-foot { display: flex; justify-content: flex-end; margin-top: .5rem; }

/* ---- 트리: 문서수 / 문서없음 ---- */
#category-tree a[data-empty="1"] { color: #a9b1bc !important; font-style: italic; }
#category-tree a[data-empty="1"]::after {
    content: "문서없음";
    margin-left: .35rem;
    font-size: .62rem;
    font-style: normal;
    color: #b6bdc7;
    border: 1px dashed #d9dee6;
    border-radius: .65rem;
    padding: 0 .32rem;
    white-space: nowrap;
}
#category-tree a[data-empty="0"]::after {
    content: attr(data-count);
    margin-left: .35rem;
    font-size: .62rem;
    font-weight: 600;
    color: #4a6fa5;
    background: #e8eefb;
    border-radius: .65rem;
    padding: 0 .32rem;
    min-width: 1rem;
    display: inline-block;
    text-align: center;
    white-space: nowrap;
}
#category-tree .jstree-clicked[data-empty="1"] { color: #8b93a0 !important; }

/* 현재 보고 있는 문서의 분류 강조 (선택이 아닌 표시 전용) */
#category-tree a.k-tree-current {
    font-weight: 700 !important;
    color: #1a4b8c !important;
    background: #e8eefb;
    border-radius: .3rem;
    box-shadow: inset 2px 0 0 #1a4b8c;
}
#category-tree a.k-tree-current::before {
    content: "\f02e";
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    font-size: .6rem;
    margin-right: .3rem;
    color: #1a4b8c;
    opacity: .85;
}
.dark-mode #category-tree a.k-tree-current {
    color: #8ab4f8 !important;
    background: #364a63;
    box-shadow: inset 2px 0 0 #8ab4f8;
}
.dark-mode #category-tree a.k-tree-current::before { color: #8ab4f8; }
#category-tree .tree-legend {
    font-size: .66rem;
    color: #9aa4b2;
    padding: .4rem .3rem 0;
    border-top: 1px dashed #eceff4;
    margin-top: .4rem;
    line-height: 1.45;
}
#category-tree .tree-legend .lg-empty { font-style: italic; color: #a9b1bc; }

/* ---- 모바일 ---- */
@media (max-width: 991px) {
    .knowledge-page .app-content { height: auto; }
    #split-row { flex-direction: column; }
    #tree-col { flex: none; width: 100%; max-width: none; margin-bottom: .85rem; }
    #tree-col .card-body { max-height: 240px; }
    #splitter-bar { display: none; }
    #right-col { flex: none; width: 100%; overflow-y: visible; }
}

/* ---- 다크모드 ---- */
.dark-mode .k-detail-title { color: #e8ecf2; }
.dark-mode .k-meta-grid dt { color: #9aa5b4; }
.dark-mode .k-meta-grid dd { color: #dce2ea; }
.dark-mode .k-meta-grid dd a { color: #8ab4f8; }
.dark-mode .k-section + .k-section { border-top-color: #444; }
.dark-mode .k-section-title { color: #b3bdcb; }
.dark-mode .k-period-item { background: #313131; border-color: #474747; }
.dark-mode .k-period-item .k-period-value { color: #e0e0e0; }
.dark-mode .k-desc-body { background: #2f2f2f; border-color: #474747; border-left-color: #4a6fa5; color: #dce2ea; }
.dark-mode .k-att-item { background: #2f2f2f; border-color: #474747; color: #dce2ea; }
.dark-mode .k-att-item:hover { background: #364a63; border-color: #4a6fa5; color: #cfe2ff; }
.dark-mode .k-comment { background: #2f2f2f; border-color: #474747; }
.dark-mode .k-comment-avatar { background: #3a4a60; color: #cfe2ff; }
.dark-mode .k-comment-author { color: #e0e0e0; }
.dark-mode .k-comment-body { color: #cfd6e0; }
.dark-mode .k-none, .dark-mode .k-att-empty, .dark-mode .k-comment-empty { color: #7b8595; }
.dark-mode #splitter-bar::before { background: #4a4a4a; }
.dark-mode #category-tree a[data-empty="0"]::after { background: #3a4a60; color: #cfe2ff; }
.dark-mode .k-type { background: #3a3a3a; color: #cfd6e0; }
</style>

<main class="app-main">
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row align-items-center">
        <div class="col-sm-6">
          <h3 class="mb-0"><i class="fas fa-book-open me-2"></i>지식 상세정보</h3>
        </div>
        <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
          <a href="/knowledge" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>목록으로
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="app-content">
    <div class="container-fluid">
      <% if (error) { %>
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i><%= error %></div>
      <% } else if (item) { %>
        <div id="split-row">

          <!-- ===================== 좌측: 분류 트리 ===================== -->
          <aside id="tree-col">
            <div class="card card-primary card-outline">
              <div class="card-header py-2">
                <h6 class="card-title mb-0">
                  <i class="fas fa-sitemap me-1"></i>분류
                </h6>
                <div class="card-tools">
                  <button type="button" class="btn btn-tool btn-sm" id="expand-all-btn" title="모두 확장">
                    <i class="fas fa-plus-square"></i>
                  </button>
                  <button type="button" class="btn btn-tool btn-sm" id="collapse-all-btn" title="모두 축소">
                    <i class="fas fa-minus-square"></i>
                  </button>
                </div>
              </div>
              <div class="px-2 pt-2">
                <input type="text" id="tree-search-input" class="form-control form-control-sm"
                       placeholder="분류명 찾기" autocomplete="off">
              </div>
              <div class="card-body">
                <div id="category-tree"></div>
              </div>
            </div>
          </aside>

          <div id="splitter-bar" title="드래그하여 폭 조절"></div>

          <!-- ===================== 우측: 상세 내용 ===================== -->
          <div id="right-col">

            <!-- 기본 정보 -->
            <div class="card card-primary card-outline">
              <div class="card-header">
                <div class="k-detail-head">
                  <div style="min-width:0;">
                    <h4 class="k-detail-title"><%= item.title %></h4>
                    <div class="k-detail-badges">
                      <% if (!isBlank(itemType)) { %>
                        <span class="k-type <%= TYPE_CLASS[itemType] || '' %>"><%= itemType %></span>
                      <% } else { %>
                        <span class="k-none">구분 없음</span>
                      <% } %>
                      <% if (!isBlank(itemStatus)) { %>
                        <span class="k-status <%= STATUS_CLASS[itemStatus] || 'k-status-default' %>"><%= itemStatus %></span>
                      <% } else { %>
                        <span class="k-none">상태 없음</span>
                      <% } %>
                      <% if (attCount > 0) { %>
                        <span class="k-none" style="font-style:normal;color:#5b6779;">
                          <i class="fas fa-paperclip me-1"></i>첨부 <%= attCount %>건
                        </span>
                      <% } %>
                    </div>
                  </div>
                  <div class="k-detail-actions">
                    <a href="/knowledge" class="btn btn-sm btn-outline-secondary">
                      <i class="fas fa-list me-1"></i>목록
                    </a>
                    <% if (canEdit) { %>
                      <a href="/knowledge/edit/<%= item.id %>" class="btn btn-sm btn-primary">
                        <i class="fas fa-pen me-1"></i>수정
                      </a>
                      <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteKnowledgeItem(<%= item.id %>)">
                        <i class="fas fa-trash me-1"></i>삭제
                      </button>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="card-body p-0">
                <!-- 메타 정보 -->
                <section class="k-section">
                  <h6 class="k-section-title"><i class="fas fa-circle-info"></i>기본 정보</h6>
                  <dl class="k-meta-grid">
                    <div class="k-meta-item">
                      <dt>카테고리</dt>
                      <dd>
                        <% if (!isBlank(item.category_name)) { %>
                          <a href="/knowledge?category_id=<%= item.category_id %>">
                            <i class="fas fa-folder me-1" style="color:#c7ae6b;"></i><%= item.category_name %>
                          </a>
                        <% } else { %>
                          <span class="k-none">미지정</span>
                        <% } %>
                      </dd>
                    </div>
                    <div class="k-meta-item">
                      <dt>작성자</dt>
                      <dd><%= isBlank(item.creator_name) ? '-' : item.creator_name %></dd>
                    </div>
                    <div class="k-meta-item">
                      <dt>담당자</dt>
                      <dd><%= isBlank(item.assignee) ? '-' : item.assignee %></dd>
                    </div>
                    <div class="k-meta-item">
                      <dt>등록일</dt>
                      <dd><%= isBlank(item.created_at) ? '-' : dateTimeText(item.created_at) %></dd>
                    </div>
                    <div class="k-meta-item">
                      <dt>수정일</dt>
                      <dd><%= isBlank(item.updated_at) ? '-' : dateTimeText(item.updated_at) %></dd>
                    </div>
                    <div class="k-meta-item">
                      <dt>문서번호</dt>
                      <dd><span style="color:#8b95a4;font-variant-numeric:tabular-nums;">#<%= item.id %></span></dd>
                    </div>
                  </dl>
                </section>

                <!-- 기간 정보 -->
                <section class="k-section">
                  <h6 class="k-section-title"><i class="fas fa-calendar-days"></i>일정 정보</h6>
                  <div class="k-period">
                    <div class="k-period-item">
                      <span class="k-period-label">시작일</span>
                      <span class="k-period-value">
                        <%= isBlank(item.start_date) ? '없음' : dateOnly(item.start_date) %>
                      </span>
                    </div>
                    <div class="k-period-item">
                      <span class="k-period-label">종료일</span>
                      <span class="k-period-value">
                        <%= isBlank(item.end_date) ? '없음' : dateOnly(item.end_date) %>
                      </span>
                    </div>
                    <div class="k-period-item">
                      <span class="k-period-label">계획일</span>
                      <span class="k-period-value">
                        <%= isBlank(item.planned_date) ? '없음' : dateOnly(item.planned_date) %>
                      </span>
                    </div>
                  </div>
                </section>

                <!-- 설명 -->
                <section class="k-section">
                  <h6 class="k-section-title"><i class="fas fa-align-left"></i>내용</h6>
                  <% if (isBlank(item.description1) && isBlank(item.description2)) { %>
                    <div class="k-att-empty">등록된 설명이 없습니다.</div>
                  <% } else { %>
                    <% if (!isBlank(item.description1)) { %>
                      <div class="k-desc-block">
                        <div class="k-desc-label">설명 1</div>
                        <pre class="k-desc-body"><%= item.description1 %></pre>
                      </div>
                    <% } %>
                    <% if (!isBlank(item.description2)) { %>
                      <div class="k-desc-block" style="margin-top:.8rem;">
                        <div class="k-desc-label">설명 2</div>
                        <pre class="k-desc-body"><%= item.description2 %></pre>
                      </div>
                    <% } %>
                  <% } %>
                </section>

                <!-- 첨부파일 -->
                <section class="k-section">
                  <h6 class="k-section-title">
                    <i class="fas fa-paperclip"></i>첨부파일
                    <% if (attCount > 0) { %><span class="k-count"><%= attCount %></span><% } %>
                  </h6>
                  <% if (attCount > 0) { %>
                    <div class="k-att-list">
                      <% attachments.forEach(function(attachment) {
                           const attName = attachment.original_name || String(attachment.file_path || '').split('/').pop();
                      %>
                        <a class="k-att-item" href="/knowledge/api/attachments/<%= attachment.id %>/download">
                          <i class="fas <%= fileIconOf(attName) %>"></i>
                          <span class="k-att-name"><%= attName %></span>
                          <i class="fas fa-download k-att-dl"></i>
                        </a>
                      <% }); %>
                    </div>
                  <% } else { %>
                    <div class="k-att-empty">첨부된 파일이 없습니다.</div>
                  <% } %>
                </section>
              </div>
            </div>

            <!-- 댓글 -->
            <div class="card card-primary card-outline">
              <div class="card-header">
                <h5 class="card-title mb-0">
                  <i class="fas fa-comments me-1"></i>댓글
                </h5>
              </div>
              <div class="card-body">
                <div id="comments-list" class="k-comment-list"></div>
                <form id="comment-form">
                  <div class="mb-2">
                    <textarea class="form-control" id="comment-content" rows="3"
                              placeholder="댓글을 입력하세요." required></textarea>
                  </div>
                  <div class="k-comment-form-foot">
                    <button type="submit" class="btn btn-primary btn-sm">
                      <i class="fas fa-paper-plane me-1"></i>댓글 추가
                    </button>
                  </div>
                </form>
              </div>
            </div>

          </div>
        </div>
      <% } %>
    </div>
  </div>
</main>


<!-- Delete Comment Modal -->
<div class="modal fade" id="deleteCommentModal" tabindex="-1" aria-labelledby="deleteCommentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteCommentModalLabel">댓글 삭제 확인</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        정말로 이 댓글을 삭제하시겠습니까?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
        <button type="button" class="btn btn-danger" id="confirmDeleteCommentBtn">삭제</button>
      </div>
    </div>
  </div>
</div>

<!-- Success Message Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="successModalLabel">알림</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="successModalBody">
        <!-- Message will be inserted here -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">확인</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Comment Modal -->
<div class="modal fade" id="editCommentModal" tabindex="-1" aria-labelledby="editCommentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editCommentModalLabel">댓글 수정</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <textarea class="form-control" id="editCommentContent" rows="5"></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
        <button type="button" class="btn btn-primary" id="saveEditedCommentBtn">저장</button>
      </div>
    </div>
  </div>
