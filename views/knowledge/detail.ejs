<%- include('../partials/footer') %>

<script>
  // ===================== 분류 트리 (좌측) =====================
  const currentCategoryId = Number(<%- JSON.stringify(item ? item.category_id : null) %>);

  $(function () {
    const $tree = $('#category-tree');

    function escapeHtml(value) {
      return String(value === null || value === undefined ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    $.get('/knowledge/api/categories', function (categories) {
      const list = categories || [];

      // 현재 문서의 분류는 "표시(하이라이트)"만 하고, 선택 이벤트로 페이지 이동이
      // 일어나지 않도록 state.selected 는 사용하지 않는다.
      const jstreeData = list.map(function (cat) {
        const total = Number(cat.doc_count) || 0;
        const isEmpty = total === 0;
        const isCurrent = Number(cat.id) === currentCategoryId;
        return {
          id: String(cat.id),
          parent: cat.parent_id === null ? '#' : String(cat.parent_id),
          text: cat.name,
          li_attr: {
            'data-empty': isEmpty ? '1' : '0',
            'data-count': String(total),
            'data-current': isCurrent ? '1' : '0'
          },
          a_attr: { 'data-empty': isEmpty ? '1' : '0', 'data-count': String(total) }
        };
      });

      $tree.jstree('destroy').empty();
      $tree.jstree({
        core: {
          data: jstreeData,
          check_callback: true,
          themes: { name: 'default', dots: true, icons: true }
        },
        plugins: ['wholerow', 'search']
      });

      $tree.on('ready.jstree', function () {
        const tree = $tree.jstree(true);
        tree.open_all();

        // 현재 문서의 분류는 select_node() 를 호출하지 않고 CSS 로만 강조한다.
        // (select_node 는 select_node.jstree 이벤트를 발생시켜 목록 페이지로
        //  이동하는 문제가 있으므로 사용하지 않는다)
        if (currentCategoryId) {
          const $current = $tree.find('li[data-current="1"] > a');
          $current.addClass('k-tree-current');
          if ($current.length) {
            $current[0].scrollIntoView({ block: 'nearest' });
          }
        }

        if (!$tree.find('.tree-legend').length) {
          $tree.append(
            '<div class="tree-legend">숫자 = 문서 수 · ' +
            '<span class="lg-empty">문서없음</span> = 연결된 문서가 없는 분류</div>'
          );
        }
      });

      // 분류 클릭 = 목록 페이지로 이동 (기존과 동일한 동작)
      $tree.on('select_node.jstree', function (e, data) {
        if (!data || !data.node || !data.node.id) return;
        window.location.href = '/knowledge?category_id=' + encodeURIComponent(data.node.id);
      });

      let searchTimer = null;
      $('#tree-search-input').on('keyup', function () {
        const v = $(this).val();
        if (searchTimer) clearTimeout(searchTimer);
        searchTimer = setTimeout(function () {
          $tree.jstree(true).search(v);
        }, 250);
      });

      $('#expand-all-btn').on('click', function () { $tree.jstree(true).open_all(); });
      $('#collapse-all-btn').on('click', function () { $tree.jstree(true).close_all(); });
    }).fail(function () {
      $tree.html('<p class="k-att-empty">분류를 불러오지 못했습니다.</p>');
    });

    // ----- 좌우 폭 조절 -----
    const splitter = document.getElementById('splitter-bar');
    const treeCol = document.getElementById('tree-col');
    if (splitter && treeCol) {
      let dragging = false;
      splitter.addEventListener('mousedown', function (e) {
        dragging = true;
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        const startX = e.pageX;
        const startWidth = treeCol.offsetWidth;

        function onMove(ev) {
          if (!dragging) return;
          const next = startWidth + (ev.pageX - startX);
          treeCol.style.flexBasis = Math.max(210, Math.min(560, next)) + 'px';
        }
        function onUp() {
          dragging = false;
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
        }
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      });
    }
  });
</script>

<script>
  // ===================== 댓글 / 삭제 (기능 동일) =====================
  const knowledgeId = <%- JSON.stringify(item ? item.id : null) %>;
  const currentUserId = <%- JSON.stringify(currentUser ? currentUser.id : null) %>;
  const isAdmin = <%- JSON.stringify(!!isAdmin) %>;

  let commentIdToDelete = null;
  let commentIdToEdit = null;

  function escapeText(value) {
    return String(value === null || value === undefined ? '' : value);
  }

  function pad2(n) { return String(n).padStart(2, '0'); }

  function formatCommentTime(raw) {
    if (!raw) return '';
    const d = new Date(String(raw).replace(' ', 'T'));
    if (isNaN(d.getTime())) return String(raw).substring(0, 16);
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()) +
      ' ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes());
  }

  async function fetchComments() {
    try {
      const response = await fetch('/knowledge/api/items/' + knowledgeId + '/comments');
      const comments = await response.json();
      const commentsList = document.getElementById('comments-list');
      if (!commentsList) return;
      commentsList.innerHTML = '';

      if (!Array.isArray(comments) || comments.length === 0) {
        commentsList.innerHTML = '<div class="k-comment-empty">아직 댓글이 없습니다.</div>';
        return;
      }

      comments.forEach(function (comment) {
        const article = document.createElement('article');
        article.className = 'k-comment';

        // 아바타
        const avatar = document.createElement('div');
        avatar.className = 'k-comment-avatar';
        avatar.textContent = escapeText(comment.author || '?').trim().substring(0, 1) || '?';

        const main = document.createElement('div');
        main.className = 'k-comment-main';

        const top = document.createElement('div');
        top.className = 'k-comment-top';

        const author = document.createElement('span');
        author.className = 'k-comment-author';
        author.textContent = escapeText(comment.author);

        const time = document.createElement('span');
        time.className = 'k-comment-time';
        time.textContent = formatCommentTime(comment.created_at);

        top.appendChild(author);
        top.appendChild(time);

        // 본인 또는 관리자만 수정/삭제 가능 (기존과 동일한 조건)
        if (currentUserId === comment.user_id || isAdmin) {
          const actions = document.createElement('div');
          actions.className = 'k-comment-actions';

          const editBtn = document.createElement('button');
          editBtn.type = 'button';
          editBtn.className = 'btn btn-outline-secondary';
          editBtn.innerHTML = '<i class="fas fa-pen"></i>';
          editBtn.title = '수정';
          editBtn.addEventListener('click', function () {
            showEditCommentModal(comment.id, comment.content);
            const el = document.getElementById('editCommentModal');
            bootstrap.Modal.getOrCreateInstance(el).show();
          });

          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'btn btn-outline-danger';
          delBtn.innerHTML = '<i class="fas fa-trash"></i>';
          delBtn.title = '삭제';
          delBtn.addEventListener('click', function () {
            showDeleteCommentModal(comment.id);
            const el = document.getElementById('deleteCommentModal');
            bootstrap.Modal.getOrCreateInstance(el).show();
          });

          actions.appendChild(editBtn);
          actions.appendChild(delBtn);
          top.appendChild(actions);
        }

        const body = document.createElement('div');
        body.className = 'k-comment-body';
        body.textContent = escapeText(comment.content);

        main.appendChild(top);
        main.appendChild(body);
        article.appendChild(avatar);
        article.appendChild(main);
        commentsList.appendChild(article);
      });
    } catch (error) {
      console.error('Error fetching comments:', error);
      alert('댓글을 불러오는 중 오류가 발생했습니다.');
    }
  }

  async function addComment(event) {
    event.preventDefault();
    const content = document.getElementById('comment-content').value;

    try {
      const response = await fetch('/knowledge/api/items/' + knowledgeId + '/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: content })
      });
      const data = await response.json();
      if (response.ok) {
        document.getElementById('comment-content').value = '';
        fetchComments();
      } else {
        alert(data.message || '댓글 추가 중 오류가 발생했습니다.');
      }
    } catch (error) {
      console.error('Error adding comment:', error);
      alert('댓글 추가 중 오류가 발생했습니다.');
    }
  }

  function showDeleteCommentModal(commentId) {
    commentIdToDelete = commentId;
  }

  function showEditCommentModal(commentId, currentContent) {
    commentIdToEdit = commentId;
    document.getElementById('editCommentContent').value = currentContent;
  }

  async function saveEditedComment() {
    if (commentIdToEdit === null) return;
    const newContent = document.getElementById('editCommentContent').value;

    try {
      const response = await fetch('/knowledge/api/comments/' + commentIdToEdit, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: newContent })
      });
      const data = await response.json();
      if (response.ok) {
        showSuccessModal(data.message);
        fetchComments();
      } else {
        showSuccessModal(data.message || '댓글 수정 중 오류가 발생했습니다.');
      }
    } catch (error) {
      console.error('Error updating comment:', error);
      showSuccessModal('댓글 수정 중 오류가 발생했습니다.');
    } finally {
      commentIdToEdit = null;
      const editModalElement = document.getElementById('editCommentModal');
      const editModal = bootstrap.Modal.getOrCreateInstance(editModalElement);
      editModal.hide();
    }
  }

  async function confirmDeleteComment() {
    if (commentIdToDelete === null) return;

    try {
      const response = await fetch('/knowledge/api/comments/' + commentIdToDelete, {
        method: 'DELETE'
      });
      const data = await response.json();
      if (response.ok) {
        showSuccessModal(data.message);
        fetchComments();
      } else {
        showSuccessModal(data.message || '댓글 삭제 중 오류가 발생했습니다.');
      }
    } catch (error) {
      console.error('Error deleting comment:', error);
      showSuccessModal('댓글 삭제 중 오류가 발생했습니다.');
    } finally {
      commentIdToDelete = null;
      const deleteModalElement = document.getElementById('deleteCommentModal');
      const deleteModal = bootstrap.Modal.getOrCreateInstance(deleteModalElement);
      deleteModal.hide();
    }
  }

  function showSuccessModal(message) {
    const successModalBody = document.getElementById('successModalBody');
    successModalBody.textContent = message;
    const successModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('successModal'));
    successModal.show();
  }

  document.addEventListener('DOMContentLoaded', function () {
    if (knowledgeId) {
      fetchComments();
      const commentForm = document.getElementById('comment-form');
      if (commentForm) commentForm.addEventListener('submit', addComment);
    }
    const confirmDeleteBtn = document.getElementById('confirmDeleteCommentBtn');
    if (confirmDeleteBtn) confirmDeleteBtn.addEventListener('click', confirmDeleteComment);
    const saveEditedBtn = document.getElementById('saveEditedCommentBtn');
    if (saveEditedBtn) saveEditedBtn.addEventListener('click', saveEditedComment);
  });

  function deleteKnowledgeItem(id) {
    if (confirm('정말로 이 지식 정보를 삭제하시겠습니까?')) {
      fetch('/knowledge/api/items/' + id, { method: 'DELETE' })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (data.message) {
            showSuccessModal(data.message);
            window.location.href = '/knowledge';
          } else {
            showSuccessModal('삭제 중 오류가 발생했습니다.');
          }
        })
        .catch(function (error) {
          console.error('Error:', error);
          showSuccessModal('삭제 처리 중 오류가 발생했습니다.');
        });
    }
  }
</script>
