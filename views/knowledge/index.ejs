<%- include('../partials/header', { page: 'knowledge' }) %>
<%- include('../partials/sidebar', { page: 'knowledge' }) %>

<style>
/* Knowledge page specific styles */
.knowledge-page .app-content {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 135px); /* Adjust this value based on header/footer heights */
}
.knowledge-page .app-content > .container-fluid {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
}
.knowledge-page #split-row {
  display: flex;
  flex-wrap: nowrap;
  position: relative;
  flex: 1;
  min-height: 0;
}
.knowledge-page #tree-col {
  min-width: 200px;
  max-width: 600px;
  flex: 0 0 320px;
  transition: flex-basis 0.1s;
  display: flex;
  flex-direction: column;
}
.knowledge-page #splitter-bar {
  width: 6px;
  background: #eee;
  cursor: col-resize;
  z-index: 10;
}
.knowledge-page #right-col {
  min-width: 0;
  flex: 1 1 0%;
  display: flex;
  flex-direction: column;
}
.knowledge-page .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
}
.knowledge-page .card-body {
    flex: 1;
    overflow-y: auto;
}

/* Mobile responsive styles for knowledge page */
@media (max-width: 768px) {
  .knowledge-page .app-content {
    height: auto; /* Reset height for mobile */
  }
  .knowledge-page #split-row {
    flex-direction: column;
  }
  .knowledge-page #tree-col {
    flex: none;
    width: 100%;
    max-width: none;
    margin-bottom: 1rem;
  }
  .knowledge-page #splitter-bar {
    display: none;
  }
  .knowledge-page #right-col {
    flex: none;
    width: 100%;
  }
  .knowledge-page .card-tools {
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .knowledge-page .card-tools .btn {
    margin-bottom: 0.25rem;
  }
  .knowledge-page #category-search-input {
    width: 100% !important;
    margin-top: 0.5rem;
  }
  .knowledge-page .table-responsive {
    font-size: 0.875rem;
  }
  .knowledge-page .table-responsive th,
  .knowledge-page .table-responsive td {
    padding: 0.5rem 0.25rem;
  }
  .knowledge-page .btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
  }
}

/* Drop zone styles */
#drop-zone {
  transition: background-color 0.2s ease;
}
#drop-zone.dragover {
  background-color: #e9ecef;
}

/* ===================== 지식 목록 (업그레이드) ===================== */
.knowledge-count-badge {
    background: #e8eefb;
    color: #3f6bab;
    font-weight: 600;
    font-size: .72rem;
    border-radius: .7rem;
    padding: .22rem .55rem;
}

/* 검색 툴바 */
.knowledge-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    align-items: center;
    padding: .6rem .85rem;
    background: #f8f9fc;
    border-bottom: 1px solid #e6e9ef;
}
.knowledge-toolbar .search-wrap {
    position: relative;
    flex: 1 1 280px;
    min-width: 200px;
    max-width: 460px;
}
.knowledge-toolbar .search-wrap > i.fa-search {
    position: absolute;
    left: .65rem;
    top: 50%;
    transform: translateY(-50%);
    color: #9aa4b2;
    font-size: .8rem;
    pointer-events: none;
}
.knowledge-toolbar #knowledge-search-input {
    padding-left: 1.9rem;
    padding-right: 1.9rem;
    background: #fff;
    border-color: #dde2ea;
}
.knowledge-toolbar #knowledge-search-input:focus {
    border-color: #86b7fe;
    box-shadow: 0 0 0 .15rem rgba(13, 110, 253, .1);
}
.knowledge-toolbar #knowledge-search-input::-webkit-search-cancel-button {
    display: none;
}
.knowledge-toolbar .search-clear {
    position: absolute;
    right: .3rem;
    top: 50%;
    transform: translateY(-50%);
    border: 0;
    background: transparent;
    color: #b3bac4;
    line-height: 1;
    padding: .15rem .3rem;
    display: none;
}
.knowledge-toolbar .search-clear:hover { color: #6b7684; }
.knowledge-toolbar .knowledge-type-filter {
    flex: 0 0 auto;
    width: auto;
    min-width: 108px;
    border-color: #dde2ea;
    background-color: #fff;
}
.knowledge-search-scope {
    font-size: .72rem;
    color: #8b95a4;
    background: #fff;
    border: 1px solid #e3e8ef;
    border-radius: .7rem;
    padding: .15rem .55rem;
    white-space: nowrap;
}
.knowledge-search-scope.is-search {
    background: #fff7e6;
    border-color: #ffe0a3;
    color: #a06800;
}

/* 표 */
.knowledge-table-wrap { padding: .25rem .5rem .5rem; }
#knowledge-table { margin-bottom: 0 !important; font-size: .85rem; }
#knowledge-table thead th {
    background: #f4f6f9;
    color: #5b6779;
    font-weight: 600;
    font-size: .76rem;
    letter-spacing: .01em;
    white-space: nowrap;
    vertical-align: middle;
    border-bottom: 1px solid #e3e7ed !important;
    border-top: 0 !important;
    padding: .6rem .55rem;
}
#knowledge-table tbody td {
    vertical-align: middle;
    padding: .5rem .55rem;
    border-color: #eef1f5;
    border-top: 1px solid #f1f4f8;
}
#knowledge-table tbody tr:hover { background: #f7fbff; }
#knowledge-table tbody td:first-child,
#knowledge-table thead th:first-child { padding-left: .8rem; }

.knowledge-title-link {
    font-weight: 600;
    color: #1a4b8c;
    text-decoration: none;
    display: inline-flex;
    align-items: flex-start;
    gap: .35rem;
    line-height: 1.35;
    max-width: 100%;
}
.knowledge-title-link:hover { color: #0d2f5c; text-decoration: underline; }
.knowledge-title-link span { overflow-wrap: anywhere; }
.knowledge-title-att { color: #8fa4bf; font-size: .72rem; margin-top: .12rem; }

.k-none { color: #c3cad3; font-size: .72rem; font-style: italic; }

/* 구분 배지 */
.k-type {
    display: inline-block;
    padding: .16rem .5rem;
    border-radius: 1rem;
    font-size: .71rem;
    font-weight: 600;
    white-space: nowrap;
    background: #eef2f7;
    color: #55637a;
}
.k-type-meeting { background: #e7f1ff; color: #2f6bbd; }
.k-type-report  { background: #e8f6ec; color: #2b7a45; }
.k-type-req     { background: #f0eaff; color: #6a45c2; }
.k-type-desc    { background: #eaf6f8; color: #21717f; }
.k-type-issue   { background: #fdecec; color: #b93a3a; }
.k-type-data    { background: #fdf3e3; color: #96631a; }

/* 상태 배지 */
.k-status {
    display: inline-block;
    padding: .16rem .5rem;
    border-radius: .25rem;
    font-size: .71rem;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid transparent;
}
.k-status-done { background: #eef8f1; color: #2b7a45; border-color: #cfe9d8; }
.k-status-ing  { background: #eaf3ff; color: #2f6bbd; border-color: #cfe2fb; }
.k-status-wait { background: #fff8e6; color: #9a6b00; border-color: #ffe6ae; }
.k-status-default { background: #f1f3f6; color: #5b6779; border-color: #e2e6ec; }

.k-category-tag {
    display: inline-block;
    font-size: .72rem;
    color: #5b6779;
    background: #f3f5f9;
    border: 1px solid #e7ebf1;
    border-radius: .25rem;
    padding: .1rem .4rem;
    max-width: 130px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: middle;
}

.k-date { color: #445063; font-size: .8rem; font-variant-numeric: tabular-nums; }
.k-time { color: #a3acb9; font-size: .7rem; }

/* 첨부파일명 */
.att-list { display: flex; flex-direction: column; gap: .12rem; }
.att-chip {
    display: inline-flex;
    align-items: center;
    gap: .32rem;
    font-size: .75rem;
    color: #3d6fb4;
    text-decoration: none;
    max-width: 230px;
    line-height: 1.3;
}
.att-chip i { flex: 0 0 auto; color: #93a7c2; font-size: .72rem; }
.att-chip .att-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.att-chip:hover { color: #1a4b8c; text-decoration: underline; }
.att-chip:hover i { color: #3d6fb4; }
.att-none { color: #c9cfd7; font-size: .72rem; font-style: italic; }
.att-more { font-size: .7rem; color: #9aa4b2; margin-top: .1rem; }

.kgmt-actions .btn { padding: .18rem .4rem; line-height: 1.2; }
.kgmt-actions .btn i { font-size: .72rem; }

/* 트리: 문서수 / 문서없음 표시 */
#category-tree a[data-empty="1"] {
    color: #a9b1bc !important;
    font-style: italic;
}
#category-tree a[data-empty="1"]::after {
    content: "문서없음";
    margin-left: .4rem;
    font-size: .63rem;
    font-style: normal;
    color: #b6bdc7;
    border: 1px dashed #d9dee6;
    border-radius: .65rem;
    padding: 0 .35rem;
    white-space: nowrap;
}
#category-tree a[data-empty="0"]::after {
    content: attr(data-count);
    margin-left: .4rem;
    font-size: .63rem;
    font-weight: 600;
    color: #4a6fa5;
    background: #e8eefb;
    border-radius: .65rem;
    padding: 0 .35rem;
    min-width: 1.05rem;
    display: inline-block;
    text-align: center;
    white-space: nowrap;
}
#category-tree .jstree-clicked[data-empty="1"] { color: #8b93a0 !important; }
#category-tree .tree-legend {
    font-size: .68rem;
    color: #9aa4b2;
    padding: .35rem .5rem 0;
    border-top: 1px dashed #eceff4;
    margin-top: .35rem;
}
#category-tree .tree-legend .lg-empty {
    font-style: italic;
    color: #a9b1bc;
}
</style>

<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">지식 관리</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            <div id="split-row">
                <div id="tree-col">
                    <div class="card card-primary card-outline">
                        <div class="card-header">
                            <div class="card-tools">
                                <button type="button" class="btn btn-tool" id="add-category-btn" title="새 카테고리 추가">
                                    <i class="fas fa-plus"></i>
                                </button>
                                <button type="button" class="btn btn-tool" id="edit-category-btn" title="카테고리명 수정">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-tool" id="delete-category-btn" title="선택된 카테고리 삭제" style="<%= isAdmin ? '' : 'display:none;' %>">
                                    <i class="fas fa-trash"></i>
                                </button>
                                <button type="button" class="btn btn-tool" id="expand-all-btn" title="모두 확장">
                                    <i class="fas fa-plus-square"></i>
                                </button>
                                <button type="button" class="btn btn-tool" id="collapse-all-btn" title="모두 축소">
                                    <i class="fas fa-minus-square"></i>
                                </button>
                                <input type="text" id="category-search-input" class="form-control form-control-sm d-inline-block w-auto ms-2" placeholder="트리명 찾기">
                            </div>
                        </div>
                        <div class="card-body">
                            <div id="category-tree"></div>
                        </div>
                    </div>
                </div>
                <div id="splitter-bar"></div>
                <div id="right-col">
                    <div class="card card-primary card-outline">
                        <div class="card-header">
                            <h3 class="card-title" id="knowledge-list-title">지식 목록</h3>
                            <span class="knowledge-count-badge ms-2" id="knowledge-count-badge" style="display:none;">0건</span>
                            <div class="card-tools">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="refresh-knowledge-btn" title="새로고침">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                                <button type="button" class="btn btn-primary btn-sm" id="add-knowledge-btn" title="지식 등록">
                                    <i class="fas fa-plus"></i> 지식등록
                                </button>
                            </div>
                        </div>

                        <!-- 검색 툴바 -->
                        <div class="knowledge-toolbar">
                            <div class="search-wrap">
                                <i class="fas fa-search"></i>
                                <input type="search" id="knowledge-search-input" class="form-control form-control-sm"
                                       placeholder="제목 · 담당자 · 구분 · 상태 · 첨부파일명 검색"
                                       autocomplete="off">
                                <button type="button" class="search-clear" id="knowledge-search-clear" title="검색어 지우기">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <select id="knowledge-type-filter" class="form-select form-select-sm knowledge-type-filter">
                                <option value="">전체 구분</option>
                                <option value="회의">회의</option>
                                <option value="보고">보고</option>
                                <option value="요구사항">요구사항</option>
                                <option value="설명">설명</option>
                                <option value="이슈">이슈</option>
                                <option value="자료">자료</option>
                            </select>
                            <label class="form-check form-check-inline mb-0 ms-1" title="선택한 카테고리와 하위 카테고리 문서를 함께 표시">
                                <input class="form-check-input" type="checkbox" id="include-sub-category">
                                <span class="form-check-label" style="font-size:.78rem;">하위 포함</span>
                            </label>
                            <span class="knowledge-search-scope" id="knowledge-search-scope">전체 보기</span>
                        </div>

                        <div class="card-body knowledge-table-wrap">
                            <div class="table-responsive">
                                <table id="knowledge-table" class="table table-hover align-middle" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th style="min-width:230px;">제목</th>
                                            <th style="width:88px;">구분</th>
                                            <th style="min-width:120px;">분류</th>
                                            <th style="width:80px">상태</th>
                                            <th style="width:100px">담당자</th>
                                            <th style="min-width:120px">첨부파일</th>
                                            <th style="width:105px">등록일</th>
                                            <th style="width:80px">작성자</th>
                                            <th style="width:76px" class="text-center">관리</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- 지식 목록은 /knowledge/api/items 에서 로드 -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Modal (for editing existing categories) -->
    <div class="modal fade" id="category-modal" tabindex="-1" aria-labelledby="category-modal-label" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="category-modal-label">카테고리 관리</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="category-form">
                        <input type="hidden" id="category-id" name="id">
                        <div class="mb-3">
                            <label for="category-name" class="form-label">카테고리 이름</label>
                            <input type="text" class="form-control" id="category-name" name="name" required />
                        </div>
                        <div class="mb-3">
                            <label for="category-parent" class="form-label">상위 카테고리</label>
                            <select class="form-select" id="category-parent" name="parent_id">
                                <option value="">없음</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">닫기</button>
                    <button type="button" class="btn btn-primary" id="save-category-btn">저장</button>
                    <button type="button" class="btn btn-danger" id="delete-category-btn" style="display:none;">삭제</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Knowledge Item Modal -->
    <div class="modal fade" id="knowledge-modal" tabindex="-1" aria-labelledby="knowledge-modal-label" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="knowledge-modal-label">지식 정보</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="knowledge-form">
                        <input type="hidden" id="knowledge-id" name="id">
                        <input type="hidden" id="knowledge-category-id" name="category_id">
                        <div class="mb-3">
                            <label for="knowledge-title" class="form-label">제목</label>
                            <input type="text" class="form-control" id="knowledge-title" name="title" required>
                        </div>
                        <div class="mb-3">
                            <label for="knowledge-type" class="form-label">구분</label>
                            <select class="form-select" id="knowledge-type" name="type" required>
                                <option value="">선택</option>
                                <option value="회의">회의</option>
                                <option value="보고">보고</option>
                                <option value="요구사항">요구사항</option>
                                <option value="설명">설명</option>
                                <option value="이슈">이슈</option>
                                <option value="자료">자료</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="knowledge-description1" class="form-label">설명1</label>
                            <textarea class="form-control" id="knowledge-description1" name="description1" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="knowledge-description2" class="form-label">설명2</label>
                            <textarea class="form-control" id="knowledge-description2" name="description2" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="knowledge-status" class="form-label">상태</label>
                            <input type="text" class="form-control" id="knowledge-status" name="status">
                        </div>
                        <div class="mb-3">
                            <label for="knowledge-assignee" class="form-label">담당자</label>
                            <input type="text" class="form-control" id="knowledge-assignee" name="assignee">
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="knowledge-start-date" class="form-label">시작일</label>
                                <input type="date" class="form-control" id="knowledge-start-date" name="start_date">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="knowledge-end-date" class="form-label">종료일</label>
                                <input type="date" class="form-control" id="knowledge-end-date" name="end_date">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="knowledge-planned-date" class="form-label">계획일</label>
                                <input type="date" class="form-control" id="knowledge-planned-date" name="planned_date">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="knowledge-attachments" class="form-label">첨부파일</label>
                            <div id="drop-zone" class="border rounded p-5 text-center" style="border-style: dashed !important;">
                                <p>여기로 파일을 드래그하거나 클릭하여 업로드하세요.</p>
                                <input type="file" class="form-control" id="knowledge-attachments" name="attachments" multiple style="display: none;">
                            </div>
                            <div id="file-list" class="mt-2"></div>
                            <div id="current-attachments" class="mt-2"></div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">닫기</button>
                    <button type="button" class="btn btn-primary" id="save-knowledge-btn">저장</button>
                    <button type="button" class="btn btn-danger" id="delete-knowledge-btn" style="display:none;">삭제</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification Modal -->
    <div class="modal fade" id="notificationModal" tabindex="-1" aria-labelledby="notificationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center pb-4">
                    <div class="mb-3">
                        <i id="notificationIcon" class="fas fa-check-circle" style="font-size: 4rem; color: #28a745;"></i>
                    </div>
                    <h5 class="modal-title" id="notificationModalLabel">성공!</h5>
                    <p id="notificationMessage" class="text-muted">작업이 완료되었습니다.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteConfirmModalLabel">삭제 확인</h5>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                </div>
                <div class="modal-body" id="deleteConfirmModalBody">
                    <p>이 노드를 삭제하시겠습니까? 하위 노드도 함께 삭제됩니다.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                    <button type="button" class="btn btn-danger" id="confirm-delete-btn">삭제</button>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    function showNotification(type, message) {
        const colors = {
            success: '#28a745',
            error: '#dc3545',
            warning: '#ffc107'
        };
        const icons = {
            success: 'fa-check-circle',
            error: 'fa-exclamation-circle',
            warning: 'fa-exclamation-triangle'
        };
        const titles = {
            success: '성공',
            error: '오류',
            warning: '경고'
        };
        $('#notificationIcon').removeClass().addClass('fas ' + icons[type]).css('color', colors[type]);
        $('#notificationModalLabel').text(titles[type]);
        $('#notificationMessage').text(message);
        $('#notificationModal').modal('show');
        setTimeout(() => {
            $('#notificationModal').modal('hide');
        }, 2000);
    }

    $(document).ready(function() {
        // Initialize Bootstrap dropdowns for dynamic elements
        $(document).on('click', '.dropdown-toggle', function() {
            console.log('Dropdown toggle clicked:', this);
            if (!$(this).hasClass('dropdown-initialized')) {
                try {
                    new bootstrap.Dropdown(this);
                    $(this).addClass('dropdown-initialized');
                    console.log('Dropdown initialized for:', this);
                } catch (e) {
                    console.error('Dropdown initialization error:', e);
                }
            }
        });

        const currentUser = <%- JSON.stringify(currentUser || {}) %>;
        let currentCategoryId = null;
        let currentSearch = '';
        let knowledgeTable;
        let uploadedFiles = [];
        let categoryMap = {};
        let categoryChildren = {};

        const isAdmin = currentUser && currentUser.role === 'admin';

        // ---------- 공통 유틸 ----------
        function escapeHtml(value) {
            return String(value === null || value === undefined ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function fileIcon(name) {
            const ext = String(name || '').split('.').pop().toLowerCase();
            if (['xls', 'xlsx', 'csv'].indexOf(ext) !== -1) return 'fa-file-excel';
            if (['doc', 'docx', 'hwp', 'hwpx', 'odt', 'txt', 'md', 'rtf'].indexOf(ext) !== -1) return 'fa-file-word';
            if (['ppt', 'pptx', 'odp'].indexOf(ext) !== -1) return 'fa-file-powerpoint';
            if (ext === 'pdf') return 'fa-file-pdf';
            if (['zip', '7z', 'rar', 'tar', 'gz'].indexOf(ext) !== -1) return 'fa-file-archive';
            if (['png', 'jpg', 'jpeg', 'gif', 'bmp', 'webp', 'svg'].indexOf(ext) !== -1) return 'fa-file-image';
            return 'fa-file';
        }

        function typeClass(type) {
            const map = {
                '회의': 'k-type-meeting',
                '보고': 'k-type-report',
                '요구사항': 'k-type-req',
                '설명': 'k-type-desc',
                '이슈': 'k-type-issue',
                '자료': 'k-type-data'
            };
            return map[type] || '';
        }

        function statusClass(status) {
            const s = String(status || '').trim().toLowerCase();
            if (!s) return 'k-status-default';
            if (['완료', '종료', 'done', 'closed', 'complete', 'completed'].indexOf(s) !== -1) return 'k-status-done';
            if (['진행중', '진행', 'inprogress', 'in progress', 'open'].indexOf(s) !== -1) return 'k-status-ing';
            if (['검토중', '대기', '보류', 'pending', 'waiting', 'hold', 'review'].indexOf(s) !== -1) return 'k-status-wait';
            return 'k-status-default';
        }

        function formatDate(value) {
            const raw = String(value === null || value === undefined ? '' : value).trim();
            if (!raw) return '';
            const m = raw.match(/^(\d{4})[-/.](\d{2})[-/.](\d{2})/);
            if (m) return `${m[1]}-${m[2]}-${m[3]}`;
            const m2 = raw.match(/^(\d{4})[-/.](\d{2})/);
            if (m2) return `${m2[1]}-${m2[2]}`;
            return raw.substring(0, 10);
        }

        function timeText(value) {
            const m = String(value === null || value === undefined ? '' : value).match(/(\d{2}:\d{2})/);
            return m ? m[1] : '';
        }

        function toTime(value) {
            const t = Date.parse(String(value || '').replace(' ', 'T'));
            return Number.isNaN(t) ? 0 : t;
        }

        // ---------- 렌더 헬퍼 ----------
        function renderType(type) {
            if (!type) return '<span class="k-none">없음</span>';
            return '<span class="k-type ' + typeClass(type) + '">' + escapeHtml(type) + '</span>';
        }

        function renderStatus(status) {
            const s = String(status || '').trim();
            if (!s) return '<span class="k-none">없음</span>';
            return '<span class="k-status ' + statusClass(s) + '">' + escapeHtml(s) + '</span>';
        }

        function renderAttachments(row) {
            const atts = row.attachments || [];
            if (!atts.length) return '<span class="att-none">없음</span>';

            const maxShow = 2;
            const clips = atts.slice(0, maxShow).map(function(att) {
                const name = att.original_name || att.file_path || '첨부파일';
                return '<a class="att-chip" href="/knowledge/api/attachments/' + att.id + '/download" ' +
                       'title="' + escapeHtml(name) + '" target="_blank" rel="noopener">' +
                       '<i class="fas ' + fileIcon(name) + '"></i>' +
                       '<span class="att-name">' + escapeHtml(name) + '</span></a>';
            });

            let html = '<div class="att-list">' + clips.join('') + '</div>';
            if (atts.length > maxShow) {
                const rest = atts.slice(maxShow).map(function(a) { return a.original_name || '첨부파일'; }).join(' / ');
                html += '<div class="att-more" title="' + escapeHtml(rest) + '">+' + (atts.length - maxShow) + '건 더보기</div>';
            }
            return html;
        }

        function updateCountBadge(count) {
            const $badge = $('#knowledge-count-badge');
            if (!$badge.length) return;
            $badge.text((currentSearch ? '검색 ' : '') + count + '건').show();
        }

        function updateScopeLabel() {
            const $scope = $('#knowledge-search-scope');
            if (!$scope.length) return;
            if (currentSearch) {
                $scope.addClass('is-search').text('검색: ' + currentSearch);
            } else if (currentCategoryId) {
                const cat = categoryMap[String(currentCategoryId)];
                $scope.removeClass('is-search').text(cat ? '분류: ' + cat.name : '분류 선택됨');
            } else {
                $scope.removeClass('is-search').text('전체 보기');
            }
        }

        // ---------- DataTable ----------
        knowledgeTable = $('#knowledge-table').DataTable({
            "paging": true,
            "pageLength": 25,
            "lengthChange": false,
            "searching": false,
            "ordering": true,
            "info": true,
            "autoWidth": false,
            "responsive": true,
            "order": [[6, 'desc']],
            "dom": "<'row'<'col-12'tr>>" + "<'row mt-2'<'col-sm-6'i><'col-sm-6'p>>",
            "ajax": {
                "url": '/knowledge/api/items',
                "dataSrc": function(json) {
                    const rows = Array.isArray(json) ? json : [];
                    updateCountBadge(rows.length);
                    return rows;
                },
                "data": function(d) {
                    if (currentCategoryId) {
                        d.category_id = currentCategoryId;
                        const includeSub = $('#include-sub-category').is(':checked');
                        d.include_sub = includeSub ? '1' : '0';
                    } else {
                        d.scope = 'all';
                    }
                    if (currentSearch) d.search = currentSearch;
                    d._ts = Date.now();
                },
                "error": function(xhr) {
                    console.error('DataTable Ajax error:', xhr.responseJSON || xhr.statusText);
                    let errorMessage = '지식 목록을 불러오는 중 오류가 발생했습니다.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.status === 403) {
                        errorMessage = '이 카테고리의 지식을 볼 수 있는 권한이 없습니다.';
                    }
                    showNotification('error', errorMessage);
                    updateCountBadge(0);
                    knowledgeTable.clear().draw();
                }
            },
            "columns": [
                {
                    "data": "title",
                    "render": function(data, type, row) {
                        const title = escapeHtml(data);
                        if (type !== 'display') return title;
                        const atts = row.attachments || [];
                        const clip = atts.length
                            ? '<i class="fas fa-paperclip knowledge-title-att" title="첨부 ' + atts.length + '건"></i>'
                            : '';
                        return '<a class="knowledge-title-link" href="/knowledge/detail/' + row.id + '" title="' + title + '">' +
                               '<span>' + title + '</span>' + clip + '</a>';
                    }
                },
                {
                    "data": "type",
                    "render": function(data, type, row) {
                        return type === 'display' ? renderType(data) : (data || '');
                    }
                },
                {
                    "data": "category_name",
                    "render": function(data, type, row) {
                        const name = data || (categoryMap[String(row.category_id)] && categoryMap[String(row.category_id)].name);
                        if (!name) return '<span class="k-none">미분류</span>';
                        if (type !== 'display') return name;
                        return '<span class="k-category-tag" title="' + escapeHtml(name) + '">' + escapeHtml(name) + '</span>';
                    }
                },
                {
                    "data": "status",
                    "render": function(data, type, row) {
                        return type === 'display' ? renderStatus(data) : (data || '');
                    }
                },
                {
                    "data": "assignee",
                    "render": function(data, type) {
                        if (!data) return type === 'display' ? '<span class="k-none">없음</span>' : '';
                        return escapeHtml(data);
                    }
                },
                {
                    "data": "attachments",
                    "render": function(data, type, row) {
                        if (type !== 'display') {
                            return String((data || []).length);
                        }
                        return renderAttachments(row);
                    },
                    "orderable": false
                },
                {
                    "data": "created_at",
                    "render": function(data, type, row) {
                        if (!data) return type === 'display' ? '<span class="k-none">-</span>' : '';
                        const datePart = formatDate(data);
                        if (type !== 'display') return datePart;
                        const t = timeText(data);
                        return '<span class="k-date">' + escapeHtml(datePart) + '</span>' +
                               (t ? '<div class="k-time">' + t + '</div>' : '');
                    }
                },
                {
                    "data": "creator_name",
                    "render": function(data, type) {
                        if (!data) return type === 'display' ? '<span class="k-none">-</span>' : '';
                        return escapeHtml(data);
                    }
                },
                {
                    "data": null,
                    "render": function(data, type, row) {
                        if (type !== 'display') return '';
                        const isCreator = currentUser.id === row.creator_id;
                        const adminUser = currentUser.role === 'admin';
                        let buttons = '<div class="btn-group kgmt-actions">';
                        buttons += '<a href="/knowledge/detail/' + row.id + '" class="btn btn-outline-primary" title="상세보기"><i class="fas fa-eye"></i></a>';
                        if (isCreator || adminUser) {
                            buttons += '<a href="/knowledge/edit/' + row.id + '" class="btn btn-outline-secondary" title="수정"><i class="fas fa-pen"></i></a>';
                            buttons += '<button type="button" class="btn btn-outline-danger delete-knowledge-btn" data-id="' + row.id + '" title="삭제"><i class="fas fa-trash"></i></button>';
                        }
                        buttons += '</div>';
                        return buttons;
                    },
                    "orderable": false,
                    "className": "text-center"
                }
            ],
            "language": {
                "url": "/js/datatables/ko.json"
            }
        });

        // ---------- 검색 / 필터 ----------
        let searchTimer = null;

        function applySearch(keyword) {
            currentSearch = String(keyword || '').trim();
            $('#knowledge-search-clear').toggle(currentSearch.length > 0);
            updateScopeLabel();
            knowledgeTable.ajax.reload();
        }

        $('#knowledge-search-input').on('input', function() {
            const v = $(this).val();
            if (searchTimer) clearTimeout(searchTimer);
            searchTimer = setTimeout(function() { applySearch(v); }, 320);
        });

        $('#knowledge-search-input').on('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (searchTimer) clearTimeout(searchTimer);
                applySearch($(this).val());
            }
        });

        $('#knowledge-search-clear').on('click', function() {
            $('#knowledge-search-input').val('').focus();
            applySearch('');
        });

        $('#refresh-knowledge-btn').on('click', function() {
            loadCategoriesForJSTree();
            knowledgeTable.ajax.reload();
        });

        $('#include-sub-category').on('change', function() {
            knowledgeTable.ajax.reload();
        });

        // 구분(회의/보고/...) 필터 - DataTables 컬럼 필터
        $.fn.dataTable.ext.search.push(function(settings, data, dataIndex, rowData) {
            if (settings.nTable && settings.nTable.id === 'knowledge-table') {
                const selected = $('#knowledge-type-filter').val();
                if (!selected) return true;
                return String((rowData && rowData.type) || data[1] || '') === selected;
            }
            return true;
        });

        $('#knowledge-type-filter').on('change', function() {
            knowledgeTable.draw();
            const total = knowledgeTable.page.info().recordsDisplay;
            updateCountBadge(total);
        });

        // 키보드 단축키: / 또는 Ctrl+K 로 검색창 포커스
        $(document).on('keydown', function(e) {
            const tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : '';
            const typing = ['input', 'textarea', 'select'].indexOf(tag) !== -1 || (e.target && e.target.isContentEditable);
            if (typing) return;
            if (e.key === '/' || (e.key === 'k' && (e.ctrlKey || e.metaKey))) {
                e.preventDefault();
                $('#knowledge-search-input').focus().select();
            }
        });

        function loadCategoriesForJSTree() {
            $.get('/knowledge/api/categories', function(categories) {
                // 카테고리 맵 구성 (문서 수 / 문서없음 표시에 사용)
                categoryMap = {};
                categoryChildren = {};
                (categories || []).forEach(function(cat) {
                    categoryMap[String(cat.id)] = {
                        name: cat.name,
                        parent_id: cat.parent_id,
                        own_count: Number(cat.own_count) || 0,
                        doc_count: Number(cat.doc_count) || 0
                    };
                    const key = cat.parent_id === null ? '#root' : String(cat.parent_id);
                    if (!categoryChildren[key]) categoryChildren[key] = [];
                    categoryChildren[key].push(String(cat.id));
                });

                const jstreeData = (categories || []).map(function(cat) {
                    const info = categoryMap[String(cat.id)];
                    const isEmpty = (info.doc_count === 0);
                    return {
                        id: String(cat.id),
                        parent: cat.parent_id === null ? '#' : String(cat.parent_id),
                        text: cat.name,
                        li_attr: { 'data-empty': isEmpty ? '1' : '0', 'data-count': String(info.doc_count) },
                        a_attr: { 'data-empty': isEmpty ? '1' : '0', 'data-count': String(info.doc_count) },
                        data: {
                            name: cat.name,
                            parent_id: cat.parent_id,
                            doc_count: info.doc_count
                        }
                    };
                });

                $('#category-tree').jstree('destroy').empty();
                $('#category-tree').jstree({
                    'core': {
                        'data': jstreeData,
                        'check_callback': true,
                        'themes': {
                            'name': 'default',
                            'dots': true,
                            'icons': true
                        }
                    },
                    'plugins': ['wholerow', 'contextmenu', 'search'],
                    'contextmenu': {
                        'items': function(node) {
                            var tree = $('#category-tree').jstree(true);
                            var items = {
                                "Create": {
                                    "separator_before": false,
                                    "separator_after": true,
                                    "label": "새 카테고리 생성",
                                    "action": function(obj) {
                                        node = tree.create_node(node, {
                                            text: '새 카테고리'
                                        });
                                        tree.edit(node);
                                    }
                                },
                                "Rename": {
                                    "separator_before": false,
                                    "separator_after": false,
                                    "label": "카테고리명 수정",
                                    "action": function(obj) {
                                        tree.edit(node);
                                    }
                                }
                            };
                            if (isAdmin) {
                                items["Delete"] = {
                                    "separator_before": true,
                                    "separator_after": false,
                                    "label": "카테고리 삭제",
                                    "action": function(obj) {
                                        $('#deleteConfirmModalBody').html('<p>이 카테고리를 삭제하시겠습니까? 하위 카테고리도 함께 삭제됩니다.</p>');
                                        $('#deleteConfirmModal').modal('show');
                                        $('#confirm-delete-btn').off('click').on('click', function() {
                                            $.ajax({
                                                url: `/knowledge/api/categories/${node.id}`,
                                                method: 'DELETE',
                                                success: function(response) {
                                                    showNotification('success', response.message || '카테고리 삭제 완료');
                                                    $('#deleteConfirmModal').modal('hide');
                                                    tree.delete_node(node);
                                                    if (currentCategoryId === node.id) {
                                                        currentCategoryId = null;
                                                        $('#knowledge-list-title').text('지식 목록');
                                                        knowledgeTable.ajax.reload();
                                                    }
                                                },
                                                error: function(xhr) {
                                                    const errorMessage = xhr.responseJSON ? xhr.responseJSON.message : '카테고리 삭제 실패';
                                                    showNotification('error', errorMessage);
                                                    $('#deleteConfirmModal').modal('hide');
                                                }
                                            });
                                        });
                                    }
                                };
                            }
                            return items;
                        }
                    }
                });

                $('#category-tree').on('ready.jstree', function() {
                    const tree = $(this).jstree(true);
                    tree.open_all();
                    // 문서 없는 카테고리 범례
                    if (!$('#category-tree .tree-legend').length) {
                        $('#category-tree').append(
                            '<div class="tree-legend">숫자 = 문서 수 · ' +
                            '<span class="lg-empty">문서없음</span> = 연결된 문서가 없는 분류</div>'
                        );
                    }
                    const categoryIdFromUrl = new URLSearchParams(window.location.search).get('category_id');
                    if (categoryIdFromUrl) {
                        tree.select_node(categoryIdFromUrl);
                    } else {
                        // 기본은 '전체 보기' : 모든 분류의 문서를 한 번에 보여준다.
                        currentCategoryId = null;
                        updateScopeLabel();
                        knowledgeTable.ajax.reload();
                    }
                });

                $('#category-tree').on('select_node.jstree', function(e, data) {
                    currentCategoryId = data.node.id;
                    const info = categoryMap[String(data.node.id)] || {};
                    const isEmpty = (Number(info.doc_count) === 0);
                    $('#knowledge-list-title').html(
                        '지식 목록 (' + escapeHtml(data.node.text) + ')' +
                        (isEmpty ? ' <span class="k-none ms-1" style="font-size:.75rem;">문서 없음</span>' : '')
                    );
                    updateScopeLabel();
                    knowledgeTable.ajax.reload();
                });

                $('#category-tree').on('rename_node.jstree', function(e, data) {
                    const id = data.node.id;
                    const newName = data.text;
                    const parent_id = data.node.parent === '#' ? null : data.node.parent;
                    const url = id.startsWith('j') ? '/knowledge/api/categories' : `/knowledge/api/categories/${id}`;
                    const method = id.startsWith('j') ? 'POST' : 'PUT';

                    $.ajax({
                        url: url,
                        method: method,
                        contentType: 'application/json',
                        data: JSON.stringify({ name: newName, parent_id: parent_id }),
                        success: function(response) {
                            showNotification('success', response.message || '카테고리 저장 완료');
                            if (id.startsWith('j')) {
                                data.instance.set_id(data.node, response.id);
                            }
                            loadCategoriesForJSTree();
                        },
                        error: function(xhr) {
                            const errorMessage = xhr.responseJSON ? xhr.responseJSON.message : '카테고리 저장 오류';
                            showNotification('error', errorMessage);
                            loadCategoriesForJSTree();
                        }
                    });
                });

                const parentSelect = $('#category-parent');
                parentSelect.empty().append('<option value="">없음</option>');
                categories.forEach(cat => {
                    parentSelect.append(`<option value="${cat.id}">${cat.name}</option>`);
                });
            }).fail(function(xhr) {
                console.error('Category load error:', xhr.responseJSON || xhr.statusText);
                showNotification('error', '카테고리 로드 실패');
            });
        }

        loadCategoriesForJSTree();

        let to = null;
        $('#category-search-input').on('keyup', function() {
            if (to) clearTimeout(to);
            to = setTimeout(() => {
                const v = $(this).val();
                $('#category-tree').jstree(true).search(v);
            }, 250);
        });

        $('#expand-all-btn').on('click', () => {
            $('#category-tree').jstree(true).open_all();
        });

        $('#collapse-all-btn').on('click', () => {
            $('#category-tree').jstree(true).close_all();
        });

        $('#add-category-btn').on('click', function() {
            const tree = $('#category-tree').jstree(true);
            if (!tree) {
                showNotification('error', '트리가 초기화되지 않았습니다.');
                return;
            }
            const selectedNode = tree.get_selected(true)[0] || null;
            const newNode = tree.create_node(selectedNode, { text: '새 카테고리' });
            tree.edit(newNode);
        });

        $('#edit-category-btn').on('click', function() {
            const tree = $('#category-tree').jstree(true);
            if (!tree) {
                showNotification('error', '트리가 초기화되지 않았습니다.');
                return;
            }
            const selectedNode = tree.get_selected(true)[0];
            if (!selectedNode) {
                showNotification('warning', '수정할 카테고리를 선택해주세요.');
                return;
            }
            tree.edit(selectedNode);
        });

        $('#delete-category-btn').on('click', function() {
            const tree = $('#category-tree').jstree(true);
            if (!tree) {
                showNotification('error', '트리가 초기화되지 않았습니다.');
                return;
            }
            const selectedNode = tree.get_selected(true)[0];
            if (!selectedNode || !selectedNode.id) {
                showNotification('warning', '삭제할 카테고리를 선택하세요.');
                return;
            }
            $('#deleteConfirmModalBody').html('<p>이 카테고리를 삭제하시겠습니까? 하위 카테고리도 함께 삭제됩니다.</p>');
            $('#deleteConfirmModal').modal('show');
            $('#confirm-delete-btn').off('click').on('click', function() {
                $.ajax({
                    url: `/knowledge/api/categories/${selectedNode.id}`,
                    method: 'DELETE',
                    success: function(response) {
                        showNotification('success', response.message || '카테고리 삭제 완료');
                        $('#deleteConfirmModal').modal('hide');
                        tree.delete_node(selectedNode);
                        if (currentCategoryId === selectedNode.id) {
                            currentCategoryId = null;
                            $('#knowledge-list-title').text('지식 목록');
                            knowledgeTable.ajax.reload();
                        }
                    },
                    error: function(xhr) {
                        const errorMessage = xhr.responseJSON ? xhr.responseJSON.message : '카테고리 삭제 오류';
                        showNotification('error', errorMessage);
                        $('#deleteConfirmModal').modal('hide');
                    }
                });
            });
        });

        $('#save-category-btn').on('click', function() {
            const id = $('#category-id').val();
            const name = $('#category-name').val();
            const parent_id = $('#category-parent').val() || null;
            const url = id ? `/knowledge/api/categories/${id}` : '/knowledge/api/categories';
            const method = id ? 'PUT' : 'POST';

            $.ajax({
                url: url,
                method: method,
                contentType: 'application/json',
                data: JSON.stringify({ name, parent_id }),
                success: function(response) {
                    showNotification('success', response.message || '카테고리 저장 완료');
                    $('#category-modal').modal('hide');
                    loadCategoriesForJSTree();
                },
                error: function(xhr) {
                    const errorMessage = xhr.responseJSON ? xhr.responseJSON.message : '카테고리 저장 오류';
                    showNotification('error', errorMessage);
                }
            });
        });

        $('#delete-category-btn').on('click', function() {
            const id = $('#category-id').val();
            if (!id) {
                showNotification('warning', '삭제할 카테고리를 선택하세요.');
                return;
            }
            $('#deleteConfirmModal').modal('show');
            $('#confirm-delete-btn').off('click').on('click', function() {
                $.ajax({
                    url: `/knowledge/api/categories/${id}`,
                    method: 'DELETE',
                    success: function(response) {
                        showNotification('success', response.message || '카테고리 삭제 완료');
                        $('#deleteConfirmModal').modal('hide');
                        $('#category-modal').modal('hide');
                        loadCategoriesForJSTree();
                        if (currentCategoryId === id) {
                            currentCategoryId = null;
                            $('#knowledge-list-title').text('지식 목록');
                            knowledgeTable.ajax.reload();
                        }
                    },
                    error: function(xhr) {
                        const errorMessage = xhr.responseJSON ? xhr.responseJSON.message : '카테고리 삭제 오류';
                        showNotification('error', errorMessage);
                        $('#deleteConfirmModal').modal('hide');
                    }
                });
            });
        });

        $('#add-knowledge-btn').on('click', function() {
            if (!currentCategoryId) {
                showNotification('warning', '먼저 카테고리를 선택하세요.');
                return;
            }
            $('#knowledge-form')[0].reset();
            $('#knowledge-id').val('');
            $('#knowledge-category-id').val(currentCategoryId);
            $('#knowledge-modal-label').text('새 지식 등록');
            $('#delete-knowledge-btn').hide();
            $('#current-attachments').empty();
            uploadedFiles = [];
            renderFileList();
            $('#knowledge-modal').modal('show');
        });

        $('#knowledge-table tbody').on('click', '.delete-knowledge-btn', function() {
            const id = $(this).data('id');
            console.log(`Delete button clicked for knowledge item ${id} by user ${currentUser.id}`);
            $('#deleteConfirmModalBody').html('<p>이 지식을 삭제하시겠습니까? 삭제된 데이터는 복구할 수 없습니다.</p>');
            $('#deleteConfirmModal').modal('show');
            $('#confirm-delete-btn').off('click').on('click', function() {
                $.ajax({
                    url: `/knowledge/api/items/${id}`,
                    method: 'DELETE',
                    success: function(response) {
                        showNotification('success', response.message || '지식 삭제 완료');
                        $('#deleteConfirmModal').modal('hide');
                        knowledgeTable.ajax.reload();
                    },
                    error: function(xhr) {
                        const errorMessage = xhr.responseJSON ? xhr.responseJSON.message : '지식 삭제 오류';
                        showNotification('error', errorMessage);
                        $('#deleteConfirmModal').modal('hide');
                    }
                });
            });
        });

        const splitter = document.getElementById('splitter-bar');
        const treeCol = document.getElementById('tree-col');
        let isDragging = false;

        splitter.addEventListener('mousedown', function(e) {
            isDragging = true;
            document.body.style.cursor = 'col-resize';
            const startX = e.pageX;
            const initialTreeColWidth = treeCol.offsetWidth;

            function onMouseMove(e) {
                if (!isDragging) return;
                const dx = e.pageX - startX;
                let newWidth = initialTreeColWidth + dx;
                const minWidth = 200;
                const maxWidth = 600;
                newWidth = Math.max(minWidth, Math.min(maxWidth, newWidth));
                treeCol.style.flexBasis = `${newWidth}px`;
            }

            function onMouseUp() {
                isDragging = false;
                document.body.style.cursor = '';
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            }

            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
        });

        const fileInput = $('#knowledge-attachments');
        const dropZone = $('#drop-zone');

        function renderFileList() {
            const fileList = $('#file-list');
            fileList.empty();
            uploadedFiles.forEach((file, index) => {
                fileList.append(`
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span>${file.name}</span>
                        <button type="button" class="btn btn-sm btn-danger remove-file-btn" data-index="${index}">삭제</button>
                    </div>
                `);
            });
        }

        function updateFileList(files) {
            for (let file of files) {
                if (!uploadedFiles.some(f => f.name === file.name && f.size === file.size)) {
                    uploadedFiles.push(file);
                }
            }
            renderFileList();
            console.log('Uploaded files:', uploadedFiles.map(f => f.name));
        }

        fileInput.on('change', function(e) {
            const files = e.target.files;
            if (files.length > 0) {
                updateFileList(files);
                fileInput.val('');
            }
        });

        dropZone.on('click', function() {
            fileInput.trigger('click');
        });

        dropZone.on('dragover', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.addClass('dragover');
        });

        dropZone.on('dragenter', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.addClass('dragover');
        });

        dropZone.on('dragleave', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.removeClass('dragover');
        });

        dropZone.on('drop', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.removeClass('dragover');
            const files = e.originalEvent.dataTransfer.files;
            if (files.length > 0) {
                updateFileList(files);
            }
        });

        $(document).on('click', '.remove-file-btn', function() {
            const index = $(this).data('index');
            uploadedFiles.splice(index, 1);
            renderFileList();
        });

        $('#save-knowledge-btn').on('click', function() {
            const id = $('#knowledge-id').val();
            const url = id ? `/knowledge/api/items/${id}` : '/knowledge/api/items';
            const method = id ? 'PUT' : 'POST';
            const type = $('#knowledge-type').val();
            const startDate = $('#knowledge-start-date').val();
            const plannedDate = $('#knowledge-planned-date').val();
            const requiredTypes = ['회의', '보고', '이슈'];

            if (requiredTypes.includes(type)) {
                if (!startDate) {
                    showNotification('warning', '시작일은 필수 입력 항목입니다.');
                    $('#knowledge-start-date').focus();
                    return;
                }
                if (!plannedDate) {
                    showNotification('warning', '계획일은 필수 입력 항목입니다.');
                    $('#knowledge-planned-date').focus();
                    return;
                }
            }

            const formData = new FormData($('#knowledge-form')[0]);
            uploadedFiles.forEach(file => {
                formData.append('attachments', file);
            });

            if (id) {
                const attachmentsToDelete = [];
                $('#current-attachments .attachment-to-delete').each(function() {
                    attachmentsToDelete.push($(this).data('id'));
                });
                formData.append('attachments_to_delete', JSON.stringify(attachmentsToDelete));
            }

            $.ajax({
                url: url,
                method: method,
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    showNotification('success', response.message || '지식 저장 완료');
                    $('#knowledge-modal').modal('hide');
                    knowledgeTable.ajax.reload();
                },
                error: function(xhr) {
                    const errorMessage = xhr.responseJSON ? xhr.responseJSON.message : '지식 저장 오류';
                    showNotification('error', errorMessage);
                }
            });
        });
    });
</script>

<%- include('../partials/footer') %>