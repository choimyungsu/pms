                                    </thead>
                                    <tbody id="ca-model-body"></tbody>
                                </table>
                            </div>
                        </div>

                        <!-- 교차표 -->
                        <div data-pane="matrix" style="display:none">
                            <div class="table-responsive">
                                <table class="table table-sm ca-table ca-matrix mb-0" id="ca-matrix-table">
                                    <thead id="ca-matrix-head"></thead>
                                    <tbody id="ca-matrix-body"></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="ca-empty" id="ca-empty" style="display:none">
                            <i class="fa-regular fa-face-frown me-1"></i>조건에 맞는 데이터가 없습니다.
                        </div>
                    </div>
                </div>
            </section>

            <div class="row">
                <!-- 프로젝트 현황 -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">프로젝트 현황</h3>
                        </div>
                        <div class="card-body table-responsive p-0">
                            <table class="table table-striped table-valign-middle">
                                <thead>
                                    <tr>
                                        <th>프로젝트명</th>
                                        <th>PM</th>
                                        <th>영업</th>
                                        <th>진행율</th>
                                        <th>상태</th>
