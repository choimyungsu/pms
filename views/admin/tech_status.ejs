                                <table class="table table-sm table-hover ca-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>제조사</th>
                                            <th class="text-end">건수</th>
                                            <th>비중</th>
                                            <th class="text-center">품목 수</th>
                                            <th class="text-center">모델 수</th>
                                            <th>취급 품목</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ca-mfr-body"></tbody>
                                </table>
                            </div>
                        </div>

                        <!-- 품목 -->
                        <div data-pane="item" style="display:none">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover ca-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>품목</th>
                                            <th class="text-end">건수</th>
                                            <th>비중</th>
                                            <th class="text-center">제조사 수</th>
                                            <th class="text-center">모델 수</th>
                                            <th>제조사</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ca-item-body"></tbody>
                                </table>
                            </div>
                        </div>

                        <!-- 모델 -->
                        <div data-pane="model" style="display:none">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover ca-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>제조사</th>
                                            <th>품목</th>
                                            <th>모델</th>
                                            <th class="text-end">건수</th>
                                            <th>구성 모델</th>
