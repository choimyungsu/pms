                                            <div id="collapse<%= index %>" class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>" aria-labelledby="heading<%= index %>" data-bs-parent="#weeklyReportsAccordion">
                                                <div class="accordion-body" style="max-height: 600px; overflow-y: auto;">
