                                                    <pre class="p-2 bg-light"><%= report.previousWeekPerformance || '내용 없음' %></pre>
                                                    <hr>
                                                    <strong>금주 계획</strong>
                                                    <pre class="p-2 bg-light"><%= report.currentWeekPlan || '내용 없음' %></pre>
                                                    <div class="text-end mt-2">
                                                        <a href="/weekly-reports/<%= report.id %>" class="btn btn-sm btn-outline-primary">상세보기</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <p>최근 주간보고가 없습니다.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <!-- 일정 현황 -->
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header">
                            <h3 class="card-title">일정 현황</h3>
							<div class="ms-3 d-flex align-items-center">
								<button id="prev-month-btn" class="btn btn-sm btn-outline-secondary">&lt;</button>
								<span id="current-year-month" class="mx-2 fw-bold" style="font-size: 1.2rem; color: #6c757d;"></span>
								<button id="next-month-btn" class="btn btn-sm btn-outline-secondary">&gt;</button>
							</div>
                        </div>
                        <div class="card-body">
							<div class="date-selector" id="date-selector">
								<!-- Date buttons will be generated here -->
							</div>
							<div id="loading">로딩 중...</div>
							<div id="schedule-display">
								<!-- Schedules will be loaded here -->
							</div>
						</div>
                    </div>
                </div>

                <!-- 이슈 리스트 -->
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header">
                            <h3 class="card-title">이슈 리스트</h3>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <% if (issues && issues.length > 0) { %>
                                    <% issues.forEach(issue => { %>
                                        <li class="list-group-item">
                                            <a href="/issues/<%= issue.id %>"><%= issue.title %></a>
                                            <% if (issue.project_name) { %>
                                                <small>(프로젝트: <a href="/projects/<%= issue.project_id %>"><%= issue.project_name %></a>)</small>
                                            <% } %>
                                            <span class="badge bg-warning float-end"><%= issue.status %></span>
                                        </li>
                                    <% }) %>
                                <% } else { %>
                                    <li class="list-group-item">진행 중인 이슈가 없습니다.</li>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    // ===== 회사 전체 제조사 / 품목 / 모델 분석 =====
    // 서버가 내려준 모델 단위 원본 레코드(modelRecords)를 기준으로
    // 검색어 필터와 모델명 접두어 통합을 브라우저에서 즉시 재집계한다.
    window.__CA_DATA__ = <%- JSON.stringify(companyAnalysis).replace(/</g, '\\u003c') %>;
</script>
<script>
    (function () {
        const CA = window.__CA_DATA__;
        if (!CA || !document.getElementById('company-analysis')) return;

        const records = Array.isArray(CA.modelRecords) ? CA.modelRecords : [];

        const els = {
            search: document.getElementById('ca-search'),
            prefix: document.getElementById('ca-prefix'),
            hint: document.getElementById('ca-result-hint'),
            reset: document.getElementById('ca-reset'),
            seg: document.getElementById('ca-seg'),
            empty: document.getElementById('ca-empty'),
            mfrBody: document.getElementById('ca-mfr-body'),
            itemBody: document.getElementById('ca-item-body'),
            modelBody: document.getElementById('ca-model-body'),
            matrixHead: document.getElementById('ca-matrix-head'),
            matrixBody: document.getElementById('ca-matrix-body')
        };

        const state = { tab: 'mfr', query: '', prefix: 0 };

        const esc = (value) => String(value == null ? '' : value)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');

        const num = (value) => Number(value || 0).toLocaleString('ko-KR');

        // 접두어 길이 적용 시 모델명을 합칠 키로 변환
        const modelLabel = (record) => {
            if (!state.prefix) return record.model;
            return record.model.slice(0, state.prefix);
        };

        const filteredRecords = () => {
            const q = state.query.trim().toLowerCase();
            if (!q) return records;
            return records.filter(record =>
                `${record.mfr} ${record.item} ${record.model}`.toLowerCase().includes(q)
            );
        };

        const bump = (map, key, seed) => {
            if (!map.has(key)) map.set(key, Object.assign({ count: 0, active: 0 }, seed));
            return map.get(key);
        };

        const barHtml = (count, max) => {
            const width = max > 0 ? Math.max(3, Math.round((count / max) * 100)) : 0;
            return `<span class="ca-bar"><i style="width:${width}%"></i></span>`;
        };

        const detailHtml = (label, values) => {
            if (!values.length) return '<span class="ca-sub">-</span>';
            return `<details class="ca-details"><summary>${esc(label)} (${values.length})</summary>` +
                `<div class="ca-detail-list">${values.map(value => esc(value)).join(', ')}</div></details>`;
        };

        function renderManufacturers(list) {
            if (!list.length) { els.mfrBody.innerHTML = ''; return false; }
            const max = Math.max.apply(null, list.map(row => row.count));
            els.mfrBody.innerHTML = list.map(row => `
                <tr>
                    <td><span class="es-chip es-chip-mfr">${esc(row.name)}</span></td>
                    <td class="ca-num">${num(row.count)}</td>
                    <td style="white-space:nowrap">${barHtml(row.count, max)}<span class="ca-sub">${row.share}%</span></td>
                    <td class="text-center">${num(row.itemCount)}</td>
                    <td class="text-center">${num(row.modelCount)}</td>
                    <td>${detailHtml('품목 보기', row.items)}</td>
                </tr>
            `).join('');
            return true;
        }

        function renderItems(list) {
            if (!list.length) { els.itemBody.innerHTML = ''; return false; }
            const max = Math.max.apply(null, list.map(row => row.count));
            els.itemBody.innerHTML = list.map(row => `
                <tr>
                    <td><strong>${esc(row.name)}</strong></td>
                    <td class="ca-num">${num(row.count)}</td>
                    <td style="white-space:nowrap">${barHtml(row.count, max)}<span class="ca-sub">${row.share}%</span></td>
                    <td class="text-center">${num(row.manufacturerCount)}</td>
                    <td class="text-center">${num(row.modelCount)}</td>
                    <td>${detailHtml('제조사 보기', row.manufacturers)}</td>
                </tr>
            `).join('');
            return true;
        }

        function renderModels(list) {
            if (!list.length) { els.modelBody.innerHTML = ''; return false; }
            els.modelBody.innerHTML = list.map(row => {
                const variants = row.variants && row.variants.length > 1
                    ? `<details class="ca-details"><summary>${row.variants.length}개 모델</summary>` +
                      `<div class="ca-detail-list">${row.variants.map(value => esc(value)).join(', ')}</div></details>`
                    : '<span class="ca-sub">-</span>';
                return `
                    <tr>
                        <td><span class="es-chip es-chip-mfr">${esc(row.mfr)}</span></td>
                        <td>${esc(row.item)}</td>
                        <td><code>${esc(row.label)}</code></td>
                        <td class="ca-num">${num(row.count)}</td>
                        <td>${variants}</td>
                    </tr>
                `;
            }).join('');
            return true;
        }

        function renderMatrix(itemNames, rows, max) {
            if (!rows.length || !itemNames.length) {
                els.matrixHead.innerHTML = '';
                els.matrixBody.innerHTML = '';
                return false;
            }
            els.matrixHead.innerHTML = `<tr><th>제조사 \\ 품목</th>` +
                itemNames.map(name => `<th>${esc(name)}</th>`).join('') +
                `<th>합계</th></tr>`;
            els.matrixBody.innerHTML = rows.map(row => {
                const cells = row.cells.map(count => {
                    if (!count) return '<td><span class="ca-heat zero">·</span></td>';
                    const ratio = max > 0 ? count / max : 0;
                    const alpha = (0.12 + ratio * 0.72).toFixed(2);
                    const color = ratio > 0.55 ? '#fff' : '#14508a';
                    return `<td><span class="ca-heat" style="--ca-heat:${alpha};background:rgba(47,107,189,${alpha});color:${color}">${count}</span></td>`;
                }).join('');
                return `<tr><td>${esc(row.name)}</td>${cells}<td class="ca-heat-total">${num(row.total)}</td></tr>`;
            }).join('');
            return true;
        }

        function compute() {
            const selected = filteredRecords();

            // 제조사 집계
            const mfrMap = new Map();
            // 품목 집계
            const itemMap = new Map();
            // 모델 집계(접두어 통합 반영)
            const modelMap = new Map();
            // 교차표용 제조사 × 품목
            const pairMap = new Map();

            let totalCount = 0;

            selected.forEach(record => {
                totalCount += record.count;
                const label = modelLabel(record);

                const mfr = bump(mfrMap, record.mfr, { name: record.mfr, items: new Set(), models: new Set() });
                mfr.count += record.count;
                mfr.active += record.active || 0;
                mfr.items.add(record.item);
                mfr.models.add(label);

                const item = bump(itemMap, record.item, { name: record.item, manufacturers: new Set(), models: new Set() });
                item.count += record.count;
                item.active += record.active || 0;
                item.manufacturers.add(record.mfr);
                item.models.add(label);

                const modelKey = `${record.mfr}||${record.item}||${label}`;
                const model = bump(modelMap, modelKey, {
                    mfr: record.mfr, item: record.item, label, variants: new Set()
                });
                model.count += record.count;
                model.active += record.active || 0;
                model.variants.add(record.model);

                const pairKey = `${record.mfr}||${record.item}`;
                const pair = bump(pairMap, pairKey, {});
                pair.count += record.count;
            });

            const share = (count) => totalCount > 0 ? Math.round((count / totalCount) * 1000) / 10 : 0;

            const manufacturers = Array.from(mfrMap.values()).map(entry => ({
                name: entry.name,
                count: entry.count,
                share: share(entry.count),
                itemCount: entry.items.size,
                modelCount: entry.models.size,
                items: Array.from(entry.items).sort((a, b) => a.localeCompare(b, 'ko'))
            })).sort((a, b) => (b.count - a.count) || a.name.localeCompare(b.name, 'ko'));

            const items = Array.from(itemMap.values()).map(entry => ({
                name: entry.name,
                count: entry.count,
                share: share(entry.count),
                manufacturerCount: entry.manufacturers.size,
                modelCount: entry.models.size,
                manufacturers: Array.from(entry.manufacturers).sort((a, b) => a.localeCompare(b, 'ko'))
            })).sort((a, b) => (b.count - a.count) || a.name.localeCompare(b.name, 'ko'));

            const models = Array.from(modelMap.values()).map(entry => ({
                mfr: entry.mfr,
                item: entry.item,
                label: entry.label,
                count: entry.count,
                variants: Array.from(entry.variants).sort((a, b) => a.localeCompare(b, 'ko'))
            })).sort((a, b) => (b.count - a.count)
                || a.mfr.localeCompare(b.mfr, 'ko')
                || a.label.localeCompare(b.label, 'ko'));

            const matrixItems = items.map(entry => entry.name);
            let matrixMax = 0;
            const matrixRows = manufacturers.map(mfrRow => {
                const cells = matrixItems.map(itemName => {
                    const pair = pairMap.get(`${mfrRow.name}||${itemName}`);
                    const count = pair ? pair.count : 0;
                    if (count > matrixMax) matrixMax = count;
                    return count;
                });
                return { name: mfrRow.name, total: mfrRow.count, cells };
            });

            const visible = {
                mfr: renderManufacturers(manufacturers),
                item: renderItems(items),
                model: renderModels(models),
                matrix: renderMatrix(matrixItems, matrixRows, matrixMax)
            };

            // 선택된 탭 기준으로 빈 상태 표시
            els.empty.style.display = visible[state.tab] ? 'none' : '';
            els.hint.textContent = selected.length
                ? `조회 ${num(totalCount)}건 · 제조사 ${manufacturers.length}개 · 품목 ${items.length}종 · 모델 ${models.length}종`
                : '';
        }

        function selectTab(tab) {
            state.tab = tab;
            Array.from(els.seg.querySelectorAll('button')).forEach(button => {
                button.classList.toggle('active', button.dataset.tab === tab);
            });
            document.querySelectorAll('#company-analysis [data-pane]').forEach(pane => {
                pane.style.display = pane.dataset.pane === tab ? '' : 'none';
            });
            compute();
        }

        els.seg.addEventListener('click', event => {
            const button = event.target.closest('button[data-tab]');
            if (button) selectTab(button.dataset.tab);
        });

        els.search.addEventListener('input', function () {
            state.query = this.value;
            compute();
        });

        els.prefix.addEventListener('change', function () {
            state.prefix = parseInt(this.value, 10) || 0;
            compute();
        });

        els.reset.addEventListener('click', function () {
            state.query = '';
            state.prefix = 0;
            els.search.value = '';
            els.prefix.value = '0';
            selectTab('mfr');
        });

        compute();
    })();
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dateSelector = document.getElementById('date-selector');
        const scheduleDisplay = document.getElementById('schedule-display');
        const loadingIndicator = document.getElementById('loading');
        const yearMonthDisplay = document.getElementById('current-year-month');
        const prevMonthBtn = document.getElementById('prev-month-btn');
        const nextMonthBtn = document.getElementById('next-month-btn');

        let currentDate = new Date();

        function renderCalendar(date) {
            const year = date.getFullYear();
            const month = date.getMonth();
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            yearMonthDisplay.textContent = `${year}년 ${month + 1}월`;
            dateSelector.innerHTML = '';

            for (let i = 1; i <= daysInMonth; i++) {
                const dateBtn = document.createElement('button');
                dateBtn.classList.add('date-btn');
                dateBtn.innerHTML = `${new Date(year, month, i).toLocaleDateString('ko-KR', { weekday: 'short' })}<br>${month + 1}/${i}`;
                dateBtn.dataset.date = `${year}-${String(month + 1).padStart(2, '0')}-${String(i).padStart(2, '0')}`;
                dateSelector.appendChild(dateBtn);
            }
        }

        async function loadSchedulesForDate(dateString) {
            document.querySelectorAll('.date-btn').forEach(btn => btn.classList.remove('active'));
            const targetButton = document.querySelector(`.date-btn[data-date='${dateString}']`);
            if (targetButton) {
                targetButton.classList.add('active');
            }

            scheduleDisplay.innerHTML = '';
            loadingIndicator.style.display = 'block';

            try {
                const response = await fetch(`/admin/schedule/${dateString}`);
                if (!response.ok) throw new Error('Network response was not ok');
                const schedules = await response.json();
                loadingIndicator.style.display = 'none';

                if (schedules.length > 0) {
                    schedules.forEach(schedule => {
                        const card = document.createElement('div');
                        card.classList.add('schedule-card');
                        card.innerHTML = `
                            <div class="schedule-user-container">
                                <div class="schedule-user">${schedule.user_name}</div>
                            </div>
                            <div class="schedule-details">
                                <div class="schedule-title">${schedule.title}</div>
                                <div class="schedule-description">${schedule.description || '내용 없음'}</div>
                            </div>
                        `;
                        scheduleDisplay.appendChild(card);
                    });
                } else {
                    scheduleDisplay.innerHTML = '<p>해당 날짜에 등록된 일정이 없습니다.</p>';
                }
            } catch (error) {
                console.error('Error fetching schedules:', error);
                loadingIndicator.style.display = 'none';
                scheduleDisplay.innerHTML = '<p>일정을 불러오는 중 오류가 발생했습니다.</p>';
            }
        }

        prevMonthBtn.addEventListener('click', function () {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar(currentDate);
            const firstDayString = `${currentDate.getFullYear()}-${String(currentDate.getMonth() + 1).padStart(2, '0')}-01`;
            loadSchedulesForDate(firstDayString);
        });

        nextMonthBtn.addEventListener('click', function () {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar(currentDate);
            const firstDayString = `${currentDate.getFullYear()}-${String(currentDate.getMonth() + 1).padStart(2, '0')}-01`;
            loadSchedulesForDate(firstDayString);
        });

        dateSelector.addEventListener('click', function (e) {
            if (e.target.classList.contains('date-btn')) {
                const dateString = e.target.dataset.date;
                loadSchedulesForDate(dateString);
            }
        });

        // Initial Load
        renderCalendar(currentDate);
        const todayString = `${currentDate.getFullYear()}-${String(currentDate.getMonth() + 1).padStart(2, '0')}-${String(new Date().getDate()).padStart(2, '0')}`;
        loadSchedulesForDate(todayString);
    });
</script>

