<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">자산 정보 수정</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            <% if (error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h3 class="card-title"><i class="fa-solid fa-edit"></i> 자산 정보 수정</h3>
                </div>
                <div class="card-body">
                    <form action="/assets/edit/<%= asset.id %>" method="POST" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="name" class="form-label">자산명 <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="name" name="name" value="<%= asset.name %>" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="asset_management_number" class="form-label">자산관리번호</label>
                                <input type="text" class="form-control" id="asset_management_number" name="asset_management_number" value="<%= asset.asset_management_number || '' %>">
                            </div>
                        </div>
                        <div class="row">
                             <div class="col-md-6 mb-3">
                                <label for="serial_number" class="form-label">시리얼번호</label>
                                <input type="text" class="form-control" id="serial_number" name="serial_number" value="<%= asset.serial_number || '' %>">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="status" class="form-label">상태 <span class="text-danger">*</span></label>
                                <select class="form-control" id="status" name="status" required>
                                    <option value="사용중" <%= asset.status === '사용중' ? 'selected' : '' %>>사용중</option>
                                    <option value="대기" <%= asset.status === '대기' ? 'selected' : '' %>>대기</option>
                                    <option value="폐기" <%= asset.status === '폐기' ? 'selected' : '' %>>폐기</option>
                                    <option value="분실" <%= asset.status === '분실' ? 'selected' : '' %>>분실</option>
                                </select>
                            </div>
                        </div>
                         <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="handler_id" class="form-label">담당자</label>
                                <select class="form-control" id="handler_id" name="handler_id">
                                    <option value="">미지정</option>
                                    <% users.forEach(user => { %>
                                        <option value="<%= user.id %>" <%= asset.handler_id === user.id ? 'selected' : '' %>><%= user.name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="photo" class="form-label">사진</label>
                                <% if (asset.photo_path) { %>
                                    <div class="mb-2">
                                        <img src="<%= asset.photo_path %>" alt="<%= asset.name %>" style="width: 100px; height: 100px; object-fit: cover;">
                                        <p class="text-muted small">현재 사진</p>
                                    </div>
                                <% } %>
                                <input type="file" class="form-control" id="photo" name="photo">
                                <small class="form-text text-muted">새 사진을 업로드하면 기존 사진이 교체됩니다.</small>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="manufacturer" class="form-label">제조사</label>
                                <input type="text" class="form-control" id="manufacturer" name="manufacturer" value="<%= asset.manufacturer || '' %>">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="model_name" class="form-label">모델명</label>
                                <input type="text" class="form-control" id="model_name" name="model_name" value="<%= asset.model_name || '' %>">
                            </div>
                        </div>
                        <div class="row">
                             <div class="col-md-6 mb-3">
                                <label for="purchase_date" class="form-label">구매일</label>
                                <input type="date" class="form-control" id="purchase_date" name="purchase_date" value="<%= asset.purchase_date ? new Date(asset.purchase_date).toISOString().split('T')[0] : '' %>">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="purchase_price" class="form-label">구매금액</label>
                                <input type="number" class="form-control" id="purchase_price" name="purchase_price" step="0.01" value="<%= asset.purchase_price || '' %>">
                            </div>
                        </div>
                        <div class="row">
                             <div class="col-md-6 mb-3">
                                <label for="asset_value" class="form-label">장비가액</label>
                                <input type="number" class="form-control" id="asset_value" name="asset_value" step="0.01" value="<%= asset.asset_value || '' %>">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="warranty_end_date" class="form-label">보증종료일</label>
                                <input type="date" class="form-control" id="warranty_end_date" name="warranty_end_date" value="<%= asset.warranty_end_date ? new Date(asset.warranty_end_date).toISOString().split('T')[0] : '' %>">
                            </div>
                        </div>
                         <div class="mb-3">
                            <label for="notes" class="form-label">비고</label>
                            <textarea class="form-control" id="notes" name="notes" rows="3"><%= asset.notes || '' %></textarea>
                        </div>

                        <hr>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="is_vehicle" name="is_vehicle" value="true" <%= asset.is_vehicle ? 'checked' : '' %>>
                            <label class="form-check-label" for="is_vehicle">차량 여부</label>
                        </div>

                        <div id="vehicle_fields" style="<%= asset.is_vehicle ? 'display: block;' : 'display: none;' %>">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="engine_oil_change_date" class="form-label">엔진오일 점검일</label>
                                    <input type="date" class="form-control" id="engine_oil_change_date" name="engine_oil_change_date" value="<%= asset.engine_oil_change_date ? new Date(asset.engine_oil_change_date).toISOString().split('T')[0] : '' %>">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="tire_replacement_date" class="form-label">타이어 교체일</label>
                                    <input type="date" class="form-control" id="tire_replacement_date" name="tire_replacement_date" value="<%= asset.tire_replacement_date ? new Date(asset.tire_replacement_date).toISOString().split('T')[0] : '' %>">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">차량 관련 첨부파일</label>
                                <input type="hidden" name="attachments_to_delete" id="attachmentsToDelete" value="[]">
                                <div id="existing-vehicle-attachments">
                                    <% if (asset.vehicle_attachments && asset.vehicle_attachments.length > 0) { %>
                                        <% asset.vehicle_attachments.forEach(function(attachment) { %>
                                            <div class="d-flex justify-content-between align-items-center mb-1 existing-attachment-item" data-attachment-id="<%= attachment.id %>">
                                                <a href="<%= attachment.file_path %>" target="_blank"><%= attachment.original_name %></a>
                                                <button type="button" class="btn btn-sm btn-danger delete-existing-vehicle-attachment-btn" data-attachment-id="<%= attachment.id %>">삭제</button>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <p>첨부된 파일이 없습니다.</p>
                                    <% } %>
                                </div>
                                <div id="vehicle-drop-zone" class="border rounded p-5 text-center" style="border-style: dashed !important;">
                                    <p>여기로 파일을 드래그하거나 클릭하여 업로드하세요.</p>
                                    <input type="file" class="form-control" id="vehicle_attachment" name="vehicle_attachment" style="display: none;" multiple>
                                </div>
                                <div id="vehicle-file-list" class="mt-2"></div>
                                <small class="form-text text-muted">새 파일을 업로드하면 기존 파일이 교체됩니다.</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <a href="/assets" class="btn btn-secondary me-2">취소</a>
                            <button type="submit" class="btn btn-primary">저장</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
<style>
    #vehicle-drop-zone {
        transition: background-color 0.2s ease;
    }
    #vehicle-drop-zone.dragover {
        background-color: #e9ecef;
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const isVehicleCheckbox = document.getElementById('is_vehicle');
        const vehicleFields = document.getElementById('vehicle_fields');

        isVehicleCheckbox.addEventListener('change', function () {
            if (this.checked) {
                vehicleFields.style.display = 'block';
            } else {
                vehicleFields.style.display = 'none';
            }
        });
        
        const vehicleFileInput = document.getElementById('vehicle_attachment');
        const vehicleDropZone = document.getElementById('vehicle-drop-zone');
        const vehicleFileList = document.getElementById('vehicle-file-list');
        const attachmentsToDeleteInput = document.getElementById('attachmentsToDelete');
        let vehicleUploadedFiles = []; // For new files selected
        let attachmentsToDelete = []; // For existing attachments marked for deletion

        function renderVehicleFileList() {
            vehicleFileList.innerHTML = '';
            vehicleUploadedFiles.forEach((file, index) => {
                vehicleFileList.innerHTML += `
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span>${file.name}</span>
                        <button type="button" class="btn btn-sm btn-danger remove-vehicle-file-btn" data-index="${index}">삭제</button>
                    </div>
                `;
            });
        }

        function updateVehicleFiles(newFiles) {
            for (let i = 0; i < newFiles.length; i++) {
                const file = newFiles[i];
                if (!vehicleUploadedFiles.some(f => f.name === file.name && f.size === file.size)) {
                    vehicleUploadedFiles.push(file);
                }
            }
            // Update the actual file input with the combined list
            const dataTransfer = new DataTransfer();
            vehicleUploadedFiles.forEach(file => dataTransfer.items.add(file));
            vehicleFileInput.files = dataTransfer.files;

            renderVehicleFileList();
        }

        vehicleFileInput.addEventListener('change', function(e) {
            if (e.target.files.length > 0) {
                updateVehicleFiles(e.target.files);
                e.target.value = ''; // Clear input to allow re-uploading same file
            }
        });

        vehicleDropZone.addEventListener('click', function() {
            vehicleFileInput.click();
        });

        vehicleDropZone.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.stopPropagation();
            vehicleDropZone.classList.add('dragover');
        });

        vehicleDropZone.addEventListener('dragenter', function(e) {
            e.preventDefault();
            e.stopPropagation();
            vehicleDropZone.classList.add('dragover');
        });

        vehicleDropZone.addEventListener('dragleave', function(e) {
            e.preventDefault();
            e.stopPropagation();
            vehicleDropZone.classList.remove('dragover');
        });

        vehicleDropZone.addEventListener('drop', function(e) {
            e.preventDefault();
            e.stopPropagation();
            vehicleDropZone.classList.remove('dragover');
            if (e.dataTransfer.files.length > 0) {
                updateVehicleFiles(e.dataTransfer.files);
            }
        });

        vehicleFileList.addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-vehicle-file-btn')) {
                const index = e.target.dataset.index;
                vehicleUploadedFiles.splice(index, 1);
                
                const dataTransfer = new DataTransfer();
                vehicleUploadedFiles.forEach(file => dataTransfer.items.add(file));
                vehicleFileInput.files = dataTransfer.files;

                renderVehicleFileList();
            }
        });

        // Handle deletion of existing attachments
        document.querySelectorAll('.delete-existing-vehicle-attachment-btn').forEach(button => {
            button.addEventListener('click', function() {
                const attachmentId = this.dataset.attachmentId;
                attachmentsToDelete.push(attachmentId);
                attachmentsToDeleteInput.value = JSON.stringify(attachmentsToDelete);
                this.closest('.existing-attachment-item').remove();
            });
        });

        // Initial render of new files (empty for edit form initially)
        renderVehicleFileList();
    });
</script>

<%- include('../partials/footer') %>
