<!DOCTYPE html>
<html lang="ko">
<head>
    <%- include('../partials/head') %>
    <title><%= title %></title>
</head>
<body>
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

    <div class="main-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"><%= title %></h4>
                        </div>
                        <div class="card-body">
                            <form action="/research-projects" method="POST">
                                <div class="form-group">
                                    <label for="project_name">과제명</label>
                                    <input type="text" class="form-control" id="project_name" name="project_name" required>
                                </div>
                                <div class="form-group">
                                    <label for="start_date">시작일</label>
                                    <input type="date" class="form-control" id="start_date" name="start_date">
                                </div>
                                <div class="form-group">
                                    <label for="end_date">종료일</label>
                                    <input type="date" class="form-control" id="end_date" name="end_date">
                                </div>
                                <div class="form-group">
                                    <label for="participants">참여자</label>
                                    <textarea class="form-control" id="participants" name="participants" rows="3"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">등록</button>
                                <a href="/research-projects" class="btn btn-secondary">취소</a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
    <%- include('../partials/scripts') %>
</body>
</html>