<script>
    // Client-side helper function to format date for MySQL
    function formatDateForMySQLClient(date) {
        if (!date) return null;
        let d = new Date(date);
        if (isNaN(d.getTime())) {
            return null;
        }

        // 로컬 시간을 그대로 사용하여 MySQL DATETIME 형식으로 변환
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        const hours = String(d.getHours()).padStart(2, '0');
        const minutes = String(d.getMinutes()).padStart(2, '0');
        const seconds = String(d.getSeconds()).padStart(2, '0');
        return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
    }

    // 알림 모달을 표시하는 함수
    function showNotification(type, message) {
        const icon = document.getElementById('notificationIcon');
        const title = document.getElementById('notificationModalLabel');
        const messageEl = document.getElementById('notificationMessage');

        if (type === 'success') {
            icon.className = 'fas fa-check-circle fa-3x mb-3';
            icon.style.color = '#28a745';
            title.textContent = '성공!';
        } else if (type === 'error') {
            icon.className = 'fas fa-exclamation-circle fa-3x mb-3';
            icon.style.color = '#dc3545';
            title.textContent = '오류!';
        } else if (type === 'warning') {
            icon.className = 'fas fa-exclamation-triangle fa-3x mb-3';
            icon.style.color = '#ffc107';
            title.textContent = '경고!';
        }

        messageEl.textContent = message;

        const notificationModal = new bootstrap.Modal(document.getElementById('notificationModal'));
        notificationModal.show();

        // 2초 후 자동으로 닫기
        setTimeout(() => {
            notificationModal.hide();
        }, 2000);
    }
</script>
