<%- include('../partials/header', { page: 'weekly-reports' }) %>
<%- include('../partials/sidebar', { page: 'weekly-reports' }) %>

<main class="app-main">
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0">주간보고서 상세</h3>
        </div>
      </div>
    </div>
  </div>
  <div class="app-content">
    <div class="container-fluid">
      <div class="card">
        <div class="card-header">
          <h4>주간보고서 상세</h4>
        </div>
        <div class="card-body">
          <% if (error && error.length > 0) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>
          <% if (success && success.length > 0) { %>
            <div class="alert alert-success"><%= success %></div>
          <% } %>
          <% if (report) { %>
            <div class="form-group">
              <label><strong>보고 주차:</strong></label>
              <p><%= report.reportWeek %></p>
            </div>
            <div class="form-group">
              <label><strong>전주 실적:</strong></label>
              <pre class="form-control-static"><%= report.previousWeekPerformance %></pre>
            </div>
            <div class="form-group">
              <label><strong>금주 계획:</strong></label>
              <pre class="form-control-static"><%= report.currentWeekPlan %></pre>
            </div>
            <div class="form-group">
              <label><strong>다음주 계획:</strong></label>
              <pre class="form-control-static"><%= report.nextWeekPlan %></pre>
            </div>
            <div class="form-group">
              <label><strong>작성일:</strong></label>
              <p><%= report.createdAt.toLocaleDateString('ko-KR') %></p>
            </div>
            <a href="/weekly-reports" class="btn btn-secondary">목록으로 돌아가기</a>
            <% if (locals.user && locals.user.role === 'admin') { %>
            <a href="/weekly-reports/<%= report.id %>/edit" class="btn btn-warning">수정</a>
            <form action="/weekly-reports/<%= report.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('정말로 이 주간보고서를 삭제하시겠습니까?');">
              <button type="submit" class="btn btn-danger">삭제</button>
            </form>
            <% } %>
          <% } else { %>
            <p>주간보고서를 찾을 수 없습니다.</p>
            <a href="/weekly-reports" class="btn btn-secondary">목록으로 돌아가기</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
