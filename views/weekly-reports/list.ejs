<%- include('../partials/header', { page: 'weekly-reports' }) %>
<%- include('../partials/sidebar', { page: 'weekly-reports' }) %>

<main class="app-main">
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0">주간보고서 목록</h3>
        </div>
      </div>
    </div>
  </div>
  <div class="app-content">
    <div class="container-fluid">
      <div class="card">
        <div class="card-header">
          <h4>주간보고서 목록</h4>
        </div>
        <div class="card-body">
          <% if (error && error.length > 0) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>
          <% if (success && success.length > 0) { %>
            <div class="alert alert-success"><%= success %></div>
          <% } %>
          <div class="table-responsive">
            <table class="table table-striped table-bordered">
              <thead>
                <tr>
                  <th>보고 주차</th>
                  <th>작성일</th>
                  <th>액션</th>
                </tr>
              </thead>
              <tbody>
                <% if (reports && reports.length > 0) { %>
                  <% reports.forEach(function(report) { %>
                    <tr>
                      <td><%= report.reportWeek %></td>
                      <td><%= report.createdAt.toLocaleDateString('ko-KR') %></td>
                      <td>
                        <a href="/weekly-reports/<%= report.id %>" class="btn btn-info btn-sm">보기</a>
                        <% if (locals.user && locals.user.role === 'admin') { %>
                        <a href="/weekly-reports/<%= report.id %>/edit" class="btn btn-warning btn-sm">수정</a>
                        <form action="/weekly-reports/<%= report.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('정말로 이 주간보고서를 삭제하시겠습니까?');">
                          <button type="submit" class="btn btn-danger btn-sm">삭제</button>
                        </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="3">주간보고서가 없습니다.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <a href="/weekly-reports/create" class="btn btn-primary">새 주간보고서 작성</a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
