<%- include('../partials/header', { page: 'card_list' }) %>
<%- include('../partials/sidebar', { page: 'card_list' }) %>

<!-- Main content -->
<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">명함 목록</h3>
                </div>
                <div class="col-sm-6 text-end">
                    <a href="/cards/register" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i> 명함 등록</a>
                </div>
            </div>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <table id="cardTable" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>이름</th>
                                <th>회사명</th>
                                <th>고객구분</th>
                                <th>제조사</th>
                                <th>계약여부</th>
                                <th>관련명함</th>
                                <th>이메일</th>
                                <th>핸드폰</th>
                                <th>이미지</th>
                                <th>저장일</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% cards.forEach(card => { %>
                                <tr>
                                    <td><%= card.id %></td>
                                    <td><a href="/cards/<%= card.id %>"><%= card.name %></a></td>
                                    <td><%= card.company %></td>
                                    <td><%= card.customer_type %><% if (card.customer_subtype) { %>(<%= card.customer_subtype %>) <% } %></td>
                                    <td><%= card.manufacturer || '' %></td>
                                    <td><%= card.contract_status || '' %></td>
                                    <td>
                                        <% if (card.related_cards && card.related_cards.length) { %>
                                            <% card.related_cards.forEach(function(rc, idx) { %>
                                                <span><%= rc.name %> (<%= rc.company %>)</span><%= idx < card.related_cards.length-1 ? ', ' : '' %>
                                            <% }); %>
                                        <% } %>
                                    </td>
                                    <td><%= card.email %></td>
                                    <td><%= card.mobile %></td>
                                    <td>
                                        <% if (card.image_path) { %>
                                            <img src="<%= card.image_path %>" alt="명함 이미지" style="width: 100px; height: auto; border-radius: 5px;">
                                        <% } %>
                                    </td>
                                    <td><%= new Date(card.created_at).toLocaleString() %></td>
                                    <td>
                                        <a href="/cards/<%= card.id %>" class="btn btn-info btn-sm">View</a>

                                        <% if (currentUser && (currentUser.role === 'admin' || currentUser.id === card.userId)) { %>
                                            <a href="/cards/edit/<%= card.id %>" class="btn btn-primary btn-sm">Edit</a>
                                            <form action="/cards/delete/<%= card.id %>?_method=DELETE" method="POST" style="display:inline;">
                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                            </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>

<style>
    #cardTable {
        font-size: 0.8em; /* 글자 크기 줄이기 */
    }
</style>

<script>
$(function () {
    var table = $('#cardTable').DataTable({
        "responsive": true, 
        "lengthChange": false, 
        "autoWidth": false,
        "pageLength": 20, /* 한 페이지에 20줄 표시 */
        "buttons": ["excel", "colvis"],
        "order": [[ 0, "desc" ]]
    });

    table.buttons().container().appendTo('#cardTable_wrapper .col-md-6:eq(0)');
});
</script>