    .gantt .bar-label {
        font-weight: bold;
        fill: #fff;
        dominant-baseline: central;
        text-anchor: middle;
    }
    .gantt .bar-progress {
        fill: rgba(255, 255, 255, 0.5);
    }
    .gantt .bar-milestone .bar {
        fill: #f8a543;
    }
</style>