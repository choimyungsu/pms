<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>ISMS 인증기준 수정</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">항목 수정</h3>
                </div>
                <div class="card-body">
                    <form action="/isms/edit/<%= item.checklist_id %>" method="POST">
                        <div class="form-group">
                            <label>구분번호</label>
                            <input type="text" name="gubun_no" class="form-control" value="<%= item.gubun_no %>" required>
                        </div>
                        <div class="form-group">
                            <label>구분</label>
                            <input type="text" name="gubun" class="form-control" value="<%= item.gubun %>" required>
                        </div>
                        <div class="form-group">
                            <label>항목번호</label>
                            <input type="text" name="item_no" class="form-control" value="<%= item.item_no %>" readonly>
                        </div>
                        <div class="form-group">
                            <label>항목</label>
                            <input type="text" name="item" class="form-control" value="<%= item.item %>" required>
                        </div>
                        <div class="form-group">
                            <label>상세내용</label>
                            <textarea name="item_detail" class="form-control"><%= item.item_detail %></textarea>
                        </div>
                        <div class="form-group">
                            <label>체크리스트</label>
                            <input type="text" name="checklist" class="form-control" value="<%= item.checklist %>" required>
                        </div>
                        <button type="submit" class="btn btn-primary">수정 완료</button>
                        <a href="/isms" class="btn btn-secondary">취소</a>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/footer') %>
