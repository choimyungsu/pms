<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/dropzone.css">
<%- include('../partials/sidebar') %>

<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">유지보수(요약) 수정</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item"><a href="/maintenance/summary">유지보수(요약)</a></li>
                        <li class="breadcrumb-item active">수정</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            <% 
                const isAdmin = user && user.role === 'admin';
                const isOpsManager = user && user.role === 'operations_manager';
                const isCreator = user && user.id === summary.creator_id;
                const isRestricted = !(isAdmin || isOpsManager || isCreator);
                const ro = isRestricted ? 'readonly' : '';
            %>
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">유지보수 요약 정보 수정</h3>
                </div>
                <div class="card-body">
                    <form id="edit-summary-form" action="/maintenance/summary/edit/<%= summary.id %>" method="POST">

                        <!-- 기본 정보 -->
                        <h6 class="text-primary border-bottom pb-2 mb-3">기본 정보</h6>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label for="division" class="form-label">구분</label>
                                <input type="text" class="form-control" id="division" name="division" value="<%= summary.division || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="customer_company" class="form-label">고객사</label>
                                <input type="text" class="form-control" id="customer_company" name="customer_company" value="<%= summary.customer_company || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="project_name" class="form-label">사업명</label>
                                <input type="text" class="form-control" id="project_name" name="project_name" value="<%= summary.project_name || '' %>" <%= ro %>>
                            </div>
                            <% if (isAdmin) { %>
                            <div class="col-md-3 mb-3">
                                <label for="cost" class="form-label">비용</label>
                                <input type="text" class="form-control" id="cost" name="cost" value="<%= summary.cost || '' %>">
                            </div>
                            <% } %>
                        </div>

                        <!-- 기간 정보 -->
                        <h6 class="text-primary border-bottom pb-2 mb-3">기간 정보</h6>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label for="inspection_date" class="form-label">검수일</label>
                                <input type="text" class="form-control" id="inspection_date" name="inspection_date" value="<%= summary.inspection_date || '' %>" placeholder="YYYY-MM-DD" <%= ro %>>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="introduction_date" class="form-label">도입일</label>
                                <input type="text" class="form-control" id="introduction_date" name="introduction_date" value="<%= summary.introduction_date || '' %>" placeholder="YYYY-MM-DD" <%= ro %>>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="maintenance_start_date" class="form-label">유지보수 시작일</label>
                                <input type="date" class="form-control" id="maintenance_start_date" name="maintenance_start_date" value="<%= summary.maintenance_start_date || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="maintenance_end_date" class="form-label">유지보수 종료일</label>
                                <input type="date" class="form-control" id="maintenance_end_date" name="maintenance_end_date" value="<%= summary.maintenance_end_date || '' %>" <%= ro %>>
                            </div>
                        </div>

                        <!-- 담당 정보 -->
                        <h6 class="text-primary border-bottom pb-2 mb-3">담당 정보</h6>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label for="main_engineer" class="form-label">정엔지니어</label>
                                <input type="text" class="form-control" id="main_engineer" name="main_engineer" value="<%= summary.main_engineer || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="sub_engineer" class="form-label">부엔지니어</label>
                                <input type="text" class="form-control" id="sub_engineer" name="sub_engineer" value="<%= summary.sub_engineer || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="sales_manager" class="form-label">영업담당</label>
                                <input type="text" class="form-control" id="sales_manager" name="sales_manager" value="<%= summary.sales_manager || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="inspection_method" class="form-label">점검방식</label>
                                <input type="text" class="form-control" id="inspection_method" name="inspection_method" value="<%= summary.inspection_method || '' %>" <%= ro %>>
                            </div>
                        </div>

                        <!-- 유지보수 업체 -->
                        <h6 class="text-primary border-bottom pb-2 mb-3">유지보수 업체 정보</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="vendor_name" class="form-label">업체명</label>
                                <input type="text" class="form-control" id="vendor_name" name="vendor_name" value="<%= summary.vendor_name || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="vendor_contact_person" class="form-label">업체 담당자</label>
                                <input type="text" class="form-control" id="vendor_contact_person" name="vendor_contact_person" value="<%= summary.vendor_contact_person || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="vendor_contact" class="form-label">업체 연락처 / 이메일</label>
                                <input type="text" class="form-control" id="vendor_contact" name="vendor_contact" value="<%= summary.vendor_contact || '' %>" <%= ro %>>
                            </div>
                        </div>

                        <!-- 고객 정보 -->
                        <h6 class="text-primary border-bottom pb-2 mb-3">고객 정보</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="customer_department" class="form-label">고객 부서명</label>
                                <input type="text" class="form-control" id="customer_department" name="customer_department" value="<%= summary.customer_department || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="customer_contact_person" class="form-label">고객 담당자</label>
                                <input type="text" class="form-control" id="customer_contact_person" name="customer_contact_person" value="<%= summary.customer_contact_person || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="customer_contact" class="form-label">고객 연락처</label>
                                <input type="text" class="form-control" id="customer_contact" name="customer_contact" value="<%= summary.customer_contact || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="customer_email" class="form-label">고객 이메일</label>
                                <input type="email" class="form-control" id="customer_email" name="customer_email" value="<%= summary.customer_email || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="inspection_location" class="form-label">점검위치</label>
                                <input type="text" class="form-control" id="inspection_location" name="inspection_location" value="<%= summary.inspection_location || '' %>" <%= ro %>>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="quote_file" class="form-label">견적서 파일명</label>
                                <input type="text" class="form-control" id="quote_file" name="quote_file" value="<%= summary.quote_file || '' %>" <%= ro %>>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label for="customer_location" class="form-label">고객사 위치</label>
                                <input type="text" class="form-control" id="customer_location" name="customer_location" value="<%= summary.customer_location || '' %>" <%= ro %>>
                            </div>
                        </div>

                        <!-- 품목 -->
                        <h6 class="text-primary border-bottom pb-2 mb-3">품목 정보</h6>
                        <%- include('./partials/_item_table', { items: summary.items || [], isRestricted: isRestricted }) %>

                        <div class="mb-3 mt-4">
                            <label class="form-label">기존 첨부파일</label>
                            <% if (summary.attachments && summary.attachments.length > 0) { %>
                                <div id="existing-attachments">
                                    <% summary.attachments.forEach(attachment => { %>
                                        <div class="attachment-item d-flex justify-content-between align-items-center">
                                            <a href="/<%= attachment.file_path %>" target="_blank"><%= attachment.file_name %></a>
                                            <button type="button" class="btn btn-sm btn-danger delete-attachment-btn" data-attachment-id="<%= attachment.id %>">삭제</button>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <div class="text-muted small">첨부파일이 없습니다.</div>
                            <% } %>
                        </div>

                        <div class="mb-3">
                            <label for="attachments" class="form-label">새 첨부파일 추가</label>
                            <div id="drop-zone">
                                <div>파일을 드래그하거나 여기를 클릭하여 파일을 선택하세요.</div>
                            </div>
                            <input type="file" id="file-input" name="attachments" multiple style="display: none;">
                            <div id="file-list" class="mt-2"></div>
                        </div>

                        <div class="mb-3">
                            <label for="remarks" class="form-label">비고</label>
                            <textarea class="form-control" id="remarks" name="remarks" rows="3"><%= summary.remarks || '' %></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">수정</button>
                        <a href="/maintenance/summary" class="btn btn-secondary">취소</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="/js/maintenanceSummaryFormHandler.js"></script>
<script src="https://cdn.ckeditor.com/ckeditor5/35.3.2/classic/ckeditor.js"></script>
<script>
    // Custom Upload Adapter Plugin
    function MyUploadAdapterPlugin(editor) {
        editor.plugins.get('FileRepository').createUploadAdapter = (loader) => {
            return new MyUploadAdapter(loader);
        };
    }

    // Custom Upload Adapter Class
    class MyUploadAdapter {
        constructor(loader) {
            this.loader = loader;
        }

        upload() {
            return this.loader.file
                .then(file => new Promise((resolve, reject) => {
                    const formData = new FormData();
                    formData.append('image', file);

                    fetch('/memo/upload-image', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => {
                        if (response.ok) {
                            return response.json();
                        } else {
                            return response.text().then(text => {
                                throw new Error(`Server responded with ${response.status}: ${text}`);
                            });
                        }
                    })
                    .then(data => {
                        if (data.success && data.filePath) {
                            resolve({
                                default: data.filePath
                            });
                        } else {
                            reject(data.message || 'Upload failed');
                        }
                    })
                    .catch(error => {
                        console.error('CKEditor image upload failed:', error);
                        reject(error);
                    });
                }));
        }

        abort() {
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        let remarksEditor;

        ClassicEditor
            .create(document.querySelector('#remarks'), {
                extraPlugins: [MyUploadAdapterPlugin],
            })
            .then(editor => {
                remarksEditor = editor;

                initializeMaintenanceSummaryForm({
                    formId: 'edit-summary-form',
                    dropZoneId: 'drop-zone',
                    fileInputId: 'file-input',
                    fileListId: 'file-list',
                    attachmentsToDeleteInputId: 'attachments_to_delete',
                    isEdit: true,
                    summaryId: '<%= summary.id %>',
                    editor: remarksEditor,
                    itemTableId: 'items-container-table',
                    pasteBtnId: 'item-paste-btn',
                    addItemBtnId: 'add-item',
                    itemRowCountId: 'item-row-count'
                });
            })
            .catch(error => {
                console.error(error);
            });
    });
</script>

<%- include('../partials/footer') %>
