<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0"><%= page_title %></h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/">홈</a></li>
                        <li class="breadcrumb-item"><a href="/maintenance/summary">유지보수(요약)</a></li>
                        <li class="breadcrumb-item active"><%= summary.project_name %></li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><%= summary.project_name %></h3>
                    <div class="card-tools">
                        <a href="/maintenance/summary/edit/<%= summary.id %>" class="btn btn-primary">수정</a>
                    </div>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab" aria-controls="info" aria-selected="true">일반정보</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="attachments-tab" data-bs-toggle="tab" data-bs-target="#attachments" type="button" role="tab" aria-controls="attachments" aria-selected="false">첨부파일</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="remarks-tab" data-bs-toggle="tab" data-bs-target="#remarks" type="button" role="tab" aria-controls="remarks" aria-selected="false">비고</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
                            <table class="table table-bordered mt-3">
                                <tbody>
                                    <tr>
                                        <th style="width: 150px;">구분</th>
                                        <td><%= summary.division %></td>
                                    </tr>
                                    <tr>
                                        <th>고객사</th>
                                        <td><%= summary.customer_company %></td>
                                    </tr>
                                    <tr>
                                        <th>사업명</th>
                                        <td><%= summary.project_name %></td>
                                    </tr>
                                    <% if (user && user.role === 'admin') { %>
                                    <tr>
                                        <th>비용</th>
                                        <td><%= summary.cost %></td>
                                    </tr>
                                    <% } %>
                                    <tr>
                                        <th>유지보수 시작일</th>
                                        <td><%= summary.maintenance_start_date %></td>
                                    </tr>
                                    <tr>
                                        <th>유지보수 종료일</th>
                                        <td><%= summary.maintenance_end_date %></td>
                                    </tr>
                                    <tr>
                                        <th>품목</th>
                                        <td>
                                            <% if (summary.items && summary.items.length > 0) { %>
                                                <ul class="mb-0">
                                                    <% summary.items.forEach(item => { %>
                                                        <li><strong><%= item.item_name %></strong>: <%= item.item_detail %></li>
                                                    <% }); %>
                                                </ul>
                                            <% } else { %>
                                                정보 없음
                                            <% } %>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>정 엔지니어</th>
                                        <td><%= summary.main_engineer %></td>
                                    </tr>
                                    <tr>
                                        <th>부 엔지니어</th>
                                        <td><%= summary.sub_engineer %></td>
                                    </tr>
                                    <tr>
                                        <th>영업담당</th>
                                        <td><%= summary.sales_manager %></td>
                                    </tr>
                                    <tr>
                                        <th>점검방식</th>
                                        <td><%= summary.inspection_method %></td>
                                    </tr>
                                    <tr>
                                        <th>고객 담당자</th>
                                        <td><%= summary.customer_contact_person %></td>
                                    </tr>
                                    <tr>
                                        <th>고객 연락처</th>
                                        <td><%= summary.customer_contact %></td>
                                    </tr>
                                    <tr>
                                        <th>고객 이메일</th>
                                        <td><%= summary.customer_email %></td>
                                    </tr>
                                    <tr>
                                        <th>점검위치</th>
                                        <td><%= summary.inspection_location %></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="tab-pane fade" id="attachments" role="tabpanel" aria-labelledby="attachments-tab">
                            <div class="mt-3">
                                <% if (summary.attachments && summary.attachments.length > 0) { %>
                                    <ul class="list-group">
                                        <% summary.attachments.forEach(attachment => { %>
                                            <li class="list-group-item">
                                                <a href="/maintenance/summary/attachments/<%= attachment.id %>/download" target="_blank"><%= attachment.file_name %></a>
                                            </li>
                                        <% }); %>
                                    </ul>
                                <% } else { %>
                                    <p>첨부파일이 없습니다.</p>
                                <% } %>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="remarks" role="tabpanel" aria-labelledby="remarks-tab">
                            <div class="mt-3 p-3 border rounded bg-white" style="min-height: 200px;">
                                <%- summary.remarks %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>