<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0"><%= page_title %></h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/">홈</a></li>
                        <li class="breadcrumb-item"><a href="/maintenance/summary">유지보수(요약)</a></li>
                        <li class="breadcrumb-item active"><%= summary.project_name %></li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><%= summary.project_name %></h3>
                    <div class="card-tools">
                        <a href="/maintenance/summary/edit/<%= summary.id %>" class="btn btn-primary">수정</a>
                    </div>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab" aria-controls="info" aria-selected="true">일반정보</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="attachments-tab" data-bs-toggle="tab" data-bs-target="#attachments" type="button" role="tab" aria-controls="attachments" aria-selected="false">첨부파일</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="remarks-tab" data-bs-toggle="tab" data-bs-target="#remarks" type="button" role="tab" aria-controls="remarks" aria-selected="false">비고</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
                            <table class="table table-bordered mt-3">
                                <tbody>
                                    <tr>
                                        <th style="width: 150px;">구분</th>
                                        <td><%= summary.division %></td>
                                    </tr>
                                    <tr>
                                        <th>고객사</th>
                                        <td><%= summary.customer_company %></td>
                                    </tr>
                                    <tr>
                                        <th>사업명</th>
                                        <td><%= summary.project_name %></td>
                                    </tr>
                                    <% if (user && user.role === 'admin') { %>
                                    <tr>
                                        <th>비용</th>
                                        <td><%= summary.cost %></td>
                                    </tr>
                                    <% } %>
                                    <tr>
                                        <th>검수일</th>
                                        <td><%= summary.inspection_date || '-' %></td>
                                    </tr>
                                    <tr>
                                        <th>도입일</th>
                                        <td><%= summary.introduction_date || '-' %></td>
                                    </tr>
                                    <tr>
                                        <th>유지보수 시작일</th>
                                        <td><%= summary.maintenance_start_date || '-' %></td>
                                    </tr>
                                    <tr>
                                        <th>유지보수 종료일</th>
                                        <td><%= summary.maintenance_end_date || '-' %></td>
                                    </tr>
                                    <tr>
                                        <th>업체명</th>
                                        <td><%= summary.vendor_name || '-' %></td>
                                    </tr>
                                    <tr>
                                        <th>업체 담당자</th>
                                        <td><%= summary.vendor_contact_person || '-' %></td>
                                    </tr>
                                    <tr>
                                        <th>업체 연락처</th>
                                        <td><%= summary.vendor_contact || '-' %></td>
                                    </tr>
                                    <tr>
                                        <th>고객 부서명</th>
                                        <td><%= summary.customer_department || '-' %></td>
                                    </tr>
                                    <tr>
                                        <th>고객사 위치</th>
                                        <td><%= summary.customer_location || '-' %></td>
                                    </tr>
                                    <tr>
                                        <th>견적서 파일</th>
                                        <td><%= summary.quote_file || '-' %></td>
                                    </tr>
                                    <tr>
                                        <th>품목</th>
                                        <td>
                                            <% if (summary.items && summary.items.length > 0) { %>
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-bordered mb-0 align-middle">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th style="min-width: 120px;">품목명</th>
                                                                <th style="min-width: 100px;">제조사</th>
                                                                <th style="min-width: 140px;">모델명</th>
                                                                <th style="min-width: 60px;">수량</th>
                                                                <th style="min-width: 130px;">S/N</th>
                                                                <th style="min-width: 90px;">FW</th>
                                                                <th style="min-width: 100px;">OS</th>
                                                                <th style="min-width: 100px;">EoS</th>
                                                                <th style="min-width: 100px;">EoL</th>
                                                                <th style="min-width: 120px;">점검위치</th>
                                                                <th style="min-width: 120px;">백계약업체</th>
                                                                <th style="min-width: 100px;">백계약</th>
                                                                <th style="min-width: 110px;">계약일</th>
                                                                <th style="min-width: 110px;">종료일</th>
                                                                <th style="min-width: 110px;">담당자</th>
                                                                <th style="min-width: 120px;">연락처</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% summary.items.forEach(item => { %>
                                                            <tr>
                                                                <td>
                                                                    <strong><%= item.item_name || '-' %></strong>
                                                                    <% if (item.patch_required) { %><span class="badge text-bg-warning ms-1">패치필요</span><% } %>
                                                                    <% if (item.item_version) { %><div class="small text-muted">버전: <%= item.item_version %></div><% } %>
                                                                    <% if (item.item_detail) { %><div class="small text-muted"><%= item.item_detail %></div><% } %>
                                                                </td>
                                                                <td><%= item.manufacturer || '-' %></td>
                                                                <td><%= item.model_name || '-' %></td>
                                                                <td class="text-center"><%= (item.quantity === null || item.quantity === undefined) ? '-' : item.quantity %></td>
                                                                <td><%= item.serial_number || '-' %></td>
                                                                <td><%= item.fw_version || '-' %></td>
                                                                <td><%= item.os_version || '-' %></td>
                                                                <td><%= item.eos_date || '-' %></td>
                                                                <td><%= item.eol_date || '-' %></td>
                                                                <td><%= item.inspection_location_item || '-' %></td>
                                                                <td><%= item.contractor_company || '-' %></td>
                                                                <td><%= item.contractor_contract || '-' %></td>
                                                                <td><%= item.contractor_start_date || '-' %></td>
                                                                <td><%= item.contractor_end_date || '-' %></td>
                                                                <td><%= item.contractor_contact_person || '-' %></td>
                                                                <td><%= item.contractor_contact || '-' %></td>
                                                            </tr>
                                                            <% }); %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            <% } else { %>
                                                정보 없음
                                            <% } %>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>정 엔지니어</th>
                                        <td><%= summary.main_engineer %></td>
                                    </tr>
                                    <tr>
                                        <th>부 엔지니어</th>
                                        <td><%= summary.sub_engineer %></td>
                                    </tr>
                                    <tr>
                                        <th>영업담당</th>
                                        <td><%= summary.sales_manager %></td>
                                    </tr>
                                    <tr>
                                        <th>점검방식</th>
                                        <td><%= summary.inspection_method %></td>
                                    </tr>
                                    <tr>
                                        <th>고객 담당자</th>
                                        <td><%= summary.customer_contact_person %></td>
                                    </tr>
                                    <tr>
                                        <th>고객 연락처</th>
                                        <td><%= summary.customer_contact %></td>
                                    </tr>
                                    <tr>
                                        <th>고객 이메일</th>
                                        <td><%= summary.customer_email %></td>
                                    </tr>
                                    <tr>
                                        <th>점검위치</th>
                                        <td><%= summary.inspection_location %></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="tab-pane fade" id="attachments" role="tabpanel" aria-labelledby="attachments-tab">
                            <div class="mt-3">
                                <% if (summary.attachments && summary.attachments.length > 0) { %>
                                    <ul class="list-group">
                                        <% summary.attachments.forEach(attachment => { %>
                                            <li class="list-group-item">
                                                <a href="/maintenance/summary/attachments/<%= attachment.id %>/download" target="_blank"><%= attachment.file_name %></a>
                                            </li>
                                        <% }); %>
                                    </ul>
                                <% } else { %>
                                    <p>첨부파일이 없습니다.</p>
                                <% } %>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="remarks" role="tabpanel" aria-labelledby="remarks-tab">
                            <div class="mt-3 p-3 border rounded bg-white" style="min-height: 200px;">
                                <%- summary.remarks %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>