<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<style>
    .patch-toolbar { gap: .5rem; flex-wrap: wrap; }
    .patch-table { font-size: 0.82rem; }
    .patch-table th, .patch-table td { vertical-align: middle; white-space: nowrap; }
    .patch-table td.patch-cell { text-align: center; }
    .patch-needed { background-color: #fff3cd !important; }
    .patch-check { width: 18px; height: 18px; cursor: pointer; }
    .condition-panel { border: 1px solid rgba(0,0,0,.125); border-radius: .375rem; padding: .75rem; }
    .condition-group { border-right: 1px solid rgba(0,0,0,.1); }
    .condition-group:last-child { border-right: 0; }
    .condition-title { font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .02em; }
    .multi-select { min-height: 132px; font-size: .8rem; }
    .chosen-tag { display:inline-block; font-size:.72rem; padding:.15rem .4rem; border-radius:.25rem; background:#e9ecef; margin:.1rem .15rem 0 0; }
    .summary-pill { font-size: .8rem; }
</style>

<%
    // 필터 유지 링크 생성 (패치필요 필터만 교체)
    const baseParams = new URLSearchParams();
    if (filters.search) baseParams.set('search', filters.search);
    filters.items.forEach(function (v) { baseParams.append('items', v); });
    filters.versions.forEach(function (v) { baseParams.append('versions', v); });
    filters.customers.forEach(function (v) { baseParams.append('customers', v); });
    if (filters.activeOnly) baseParams.set('active_only', '1');
    const buildUrl = function (patchVal) {
        const p = new URLSearchParams(baseParams.toString());
        if (patchVal) p.set('patch', patchVal);
        const s = p.toString();
        return '/maintenance/patch' + (s ? '?' + s : '');
    };
%>

<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0"><%= page_title %></h3>
                    <div class="text-muted small mt-1">
                        고객사 · 품목 · 버전 · 담당자(정/부) 현황 및 패치필요 판정
                    </div>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item">유지보수 관리</li>
                        <li class="breadcrumb-item active"><%= page_title %></li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">

            <% if (notice) { %>
            <div class="alert alert-<%= noticeType === 'error' ? 'danger' : (noticeType === 'warning' ? 'warning' : 'success') %> alert-dismissible fade show" role="alert">
                <%= notice %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <!-- 요약 -->
            <div class="row g-2 mb-3">
                <div class="col-6 col-md-3">
                    <div class="card mb-0">
                        <div class="card-body py-2">
                            <div class="text-muted small">전체 대상</div>
                            <div class="fs-5 fw-semibold"><%= globalTotal %>건</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card mb-0">
                        <div class="card-body py-2">
                            <div class="text-muted small">전체 패치필요</div>
                            <div class="fs-5 fw-semibold text-danger"><%= globalRequired %>건</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card mb-0">
                        <div class="card-body py-2">
                            <div class="text-muted small">조회 결과</div>
                            <div class="fs-5 fw-semibold"><%= filteredTotal %>건</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card mb-0">
                        <div class="card-body py-2">
                            <div class="text-muted small">조회 결과 중 패치필요</div>
                            <div class="fs-5 fw-semibold text-danger"><%= filteredRequired %>건</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 조건 설정 -->
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold"><i class="fa-solid fa-filter me-1"></i>패치필요 조건 설정</span>
                    <span class="text-muted small">품목 / 버전은 복수 선택 가능 (Ctrl 또는 Shift + 클릭), 버전은 펌웨어·OS 모두 매칭</span>
                </div>
                <div class="card-body">
                    <form id="conditionForm" method="POST" action="/maintenance/patch/apply-condition">
                        <div class="row g-3">
                            <div class="col-12 col-lg-4 condition-group">
                                <div class="condition-title mb-2">고객사 (선택)</div>
                                <select class="form-select multi-select" id="condCustomers" name="customers" multiple size="6">
                                    <% customerOptions.forEach(function(c) { %>
                                    <option value="<%= c %>"><%= c %></option>
                                    <% }) %>
                                </select>
                                <div class="d-flex justify-content-between mt-1">
                                    <button type="button" class="btn btn-link btn-sm p-0" data-clear="condCustomers">선택 해제</button>
                                    <span class="text-muted small" id="cntCustomers">0개 선택</span>
                                </div>
                            </div>

                            <div class="col-12 col-lg-4 condition-group">
                                <div class="condition-title mb-2">품목 (복수 선택)</div>
                                <select class="form-select multi-select" id="condItems" name="items" multiple size="6">
                                    <% itemOptions.forEach(function(v) { %>
                                    <option value="<%= v %>"><%= v %></option>
                                    <% }) %>
                                </select>
                                <div class="d-flex justify-content-between mt-1">
                                    <button type="button" class="btn btn-link btn-sm p-0" data-clear="condItems">선택 해제</button>
                                    <span class="text-muted small" id="cntItems">0개 선택</span>
                                </div>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="condition-title mb-2">버전 (복수 선택)</div>
                                <select class="form-select multi-select" id="condVersions" name="versions" multiple size="6">
                                    <% versionOptions.forEach(function(v) { %>
                                    <option value="<%= v %>"><%= v %></option>
                                    <% }) %>
                                </select>
                                <div class="d-flex justify-content-between mt-1">
                                    <button type="button" class="btn btn-link btn-sm p-0" data-clear="condVersions">선택 해제</button>
                                    <span class="text-muted small" id="cntVersions">0개 선택</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap align-items-center mt-3 patch-toolbar">
                            <span class="badge text-bg-light border summary-pill" id="previewBadge">조건 미리보기: 품목 또는 버전을 선택하세요</span>
                            <div class="ms-auto d-flex gap-2">
                                <button type="submit" name="mode" value="check" class="btn btn-primary btn-sm">
                                    <i class="fa-solid fa-check me-1"></i>조건 항목 체크
                                </button>
                                <button type="submit" name="mode" value="replace" class="btn btn-dark btn-sm"
                                        onclick="return confirm('기존 패치필요 체크를 모두 해제하고, 이 조건에 해당하는 항목만 다시 체크합니다. 진행할까요?');">
                                    <i class="fa-solid fa-rotate me-1"></i>조건 기준 재설정
                                </button>
                                <button type="submit" name="mode" value="uncheck" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa-solid fa-xmark me-1"></i>조건 항목 체크 해제
                                </button>
                            </div>
                        </div>
                        <div class="text-muted small mt-2">
                            선택한 조건에 해당하는 행의 <strong>패치필요</strong> 필드만 체크됩니다. (그 외 행의 값은 유지)
                        </div>
                    </form>
                </div>
            </div>

            <!-- 목록 -->
            <div class="card">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <form action="/maintenance/patch" method="GET" class="d-flex gap-1" style="width: 320px;">
                        <input type="text" name="search" class="form-control form-control-sm" placeholder="고객사 / 품목 / 모델 / 담당자 검색" value="<%= filters.search %>">
                        <% filters.items.forEach(function(v) { %><input type="hidden" name="items" value="<%= v %>"><% }) %>
                        <% filters.versions.forEach(function(v) { %><input type="hidden" name="versions" value="<%= v %>"><% }) %>
                        <% filters.customers.forEach(function(v) { %><input type="hidden" name="customers" value="<%= v %>"><% }) %>
                        <% if (filters.patch) { %><input type="hidden" name="patch" value="<%= filters.patch %>"><% } %>
                        <% if (filters.activeOnly) { %><input type="hidden" name="active_only" value="1"><% } %>
                        <button type="submit" class="btn btn-default btn-sm"><i class="fas fa-search"></i></button>
                    </form>

                    <div class="d-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm">
                            <a href="<%= buildUrl('1') %>"
                               class="btn btn-<%= filters.patch === '1' ? 'danger' : 'outline-danger' %>">패치필요만</a>
                            <a href="<%= buildUrl('0') %>"
                               class="btn btn-<%= filters.patch === '0' ? 'success' : 'outline-success' %>">패치불필요만</a>
                            <a href="<%= buildUrl('') %>" class="btn btn-<%= !filters.patch ? 'secondary' : 'outline-secondary' %>">전체</a>
                        </div>
                        <a href="/maintenance/patch/download-excel<%= queryString %>" class="btn btn-success btn-sm">
                            <i class="fa-solid fa-file-excel me-1"></i>엑셀 다운로드
                        </a>
                        <form action="/maintenance/patch/reset" method="POST" class="d-inline"
                              onsubmit="return confirm('모든 행의 패치필요 체크를 초기화합니다. 계속할까요?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fa-solid fa-eraser me-1"></i>전체 초기화
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover patch-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>NO</th>
                                    <th>고객사</th>
                                    <th>품목</th>
                                    <th>제조사 / 모델</th>
                                    <th>버전</th>
                                    <th>담당자(정)</th>
                                    <th>담당자(부)</th>
                                    <th>유지보수 기간</th>
                                    <th class="text-center">패치필요</th>
                                    <th>판정 정보</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (rows.length === 0) { %>
                                <tr>
                                    <td colspan="10" class="text-center text-muted py-4">
                                        조회된 대상이 없습니다. 유지보수(상세) 데이터를 먼저 등록해 주세요.
                                    </td>
                                </tr>
                                <% } %>
                                <% rows.forEach(function(r, idx) { %>
                                <tr class="<%= Number(r.patch_required) === 1 ? 'patch-needed' : '' %>">
                                    <td><%= (currentPage - 1) * 30 + idx + 1 %></td>
                                    <td><%= r.customer_company || '-' %></td>
                                    <td><%= r.item || '-' %></td>
                                    <td>
                                        <div><%= r.manufacturer || '-' %></div>
                                        <div class="text-muted small"><%= r.model || '' %></div>
                                    </td>
                                    <td class="text-nowrap"><%= r.version_display || '-' %></td>
                                    <td><%= r.manager_primary || '-' %></td>
                                    <td><%= r.manager_secondary || '-' %></td>
                                    <td class="text-nowrap">
                                        <%= r.maintenance_start_date || '-' %> ~ <%= r.maintenance_end_date || '-' %>
                                    </td>
                                    <td class="patch-cell">
                                        <input type="checkbox" class="form-check-input patch-check"
                                               data-id="<%= r.id %>"
                                               <%= Number(r.patch_required) === 1 ? 'checked' : '' %>>
                                    </td>
                                    <td class="small text-muted">
                                        <% if (Number(r.patch_required) === 1) { %>
                                            <div>판정자: <%= r.patch_required_by || '-' %></div>
                                            <div>판정일: <%= r.patch_required_at || '-' %></div>
                                            <% if (r.patch_condition) { %>
                                            <div title="<%= r.patch_condition %>">조건: <%= r.patch_condition.length > 28 ? r.patch_condition.slice(0, 28) + '…' : r.patch_condition %></div>
                                            <% } %>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer clearfix">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">총 <%= totalRecords %>건 / <%= totalPages %>페이지</span>
                        <ul class="pagination pagination-sm m-0">
                            <% if (currentPage > 1) { %>
                            <li class="page-item"><a class="page-link" href="/maintenance/patch<%= queryString %><%= queryString ? '&' : '?' %>page=<%= currentPage - 1 %>">«</a></li>
                            <% } %>
                            <% var startP = Math.max(1, currentPage - 4); var endP = Math.min(totalPages, startP + 9); %>
                            <% for (var i = startP; i <= endP; i++) { %>
                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                <a class="page-link" href="/maintenance/patch<%= queryString %><%= queryString ? '&' : '?' %>page=<%= i %>"><%= i %></a>
                            </li>
                            <% } %>
                            <% if (currentPage < totalPages) { %>
                            <li class="page-item"><a class="page-link" href="/maintenance/patch<%= queryString %><%= queryString ? '&' : '?' %>page=<%= currentPage + 1 %>">»</a></li>
                            <% } %>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</main>

<%- include('../partials/footer') %>

<script>
(function () {
    const selects = {
        customers: document.getElementById('condCustomers'),
        items: document.getElementById('condItems'),
        versions: document.getElementById('condVersions')
    };
    const counters = {
        customers: document.getElementById('cntCustomers'),
        items: document.getElementById('cntItems'),
        versions: document.getElementById('cntVersions')
    };
    const previewBadge = document.getElementById('previewBadge');

    function selectedValues(sel) {
        return Array.from(sel.selectedOptions).map(function (o) { return o.value; });
    }

    function updateCounter(key) {
        counters[key].textContent = selectedValues(selects[key]).length + '개 선택';
    }

    let debounceTimer = null;

    function refreshPreview() {
        const items = selectedValues(selects.items);
        const versions = selectedValues(selects.versions);
        const customers = selectedValues(selects.customers);

        if (items.length === 0 && versions.length === 0) {
            previewBadge.className = 'badge text-bg-light border summary-pill';
            previewBadge.textContent = '조건 미리보기: 품목 또는 버전을 선택하세요';
            return;
        }

        const params = new URLSearchParams();
        items.forEach(function (v) { params.append('items', v); });
        versions.forEach(function (v) { params.append('versions', v); });
        customers.forEach(function (v) { params.append('customers', v); });

        previewBadge.className = 'badge text-bg-secondary summary-pill';
        previewBadge.textContent = '조건 미리보기 계산 중...';

        fetch('/maintenance/patch/preview-count?' + params.toString(), { headers: { 'Accept': 'application/json' } })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (!data.success) {
                    previewBadge.className = 'badge text-bg-warning summary-pill';
                    previewBadge.textContent = '미리보기를 불러오지 못했습니다';
                    return;
                }
                previewBadge.className = 'badge text-bg-info summary-pill';
                previewBadge.textContent = '조건 해당 ' + data.count + '건 (현재 패치필요 ' + data.checked + '건)';
            })
            .catch(function () {
                previewBadge.className = 'badge text-bg-warning summary-pill';
                previewBadge.textContent = '미리보기를 불러오지 못했습니다';
            });
    }

    function schedulePreview() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(refreshPreview, 180);
    }

    Object.keys(selects).forEach(function (key) {
        selects[key].addEventListener('change', function () {
            updateCounter(key);
            schedulePreview();
        });
    });

    document.querySelectorAll('[data-clear]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const sel = document.getElementById(btn.getAttribute('data-clear'));
            Array.from(sel.options).forEach(function (o) { o.selected = false; });
            const key = btn.getAttribute('data-clear').replace('cond', '').toLowerCase();
            updateCounter(key);
            schedulePreview();
        });
    });

    // 기존 필터를 조건 UI 에 반영 (재조회 시 선택 상태 유지)
    const preItems = <%- JSON.stringify(filters.items) %>;
    const preVersions = <%- JSON.stringify(filters.versions) %>;
    const preCustomers = <%- JSON.stringify(filters.customers) %>;

    function preselect(sel, values) {
        Array.from(sel.options).forEach(function (o) {
            if (values.indexOf(o.value) !== -1) o.selected = true;
        });
    }
    preselect(selects.items, preItems);
    preselect(selects.versions, preVersions);
    preselect(selects.customers, preCustomers);
    Object.keys(selects).forEach(updateCounter);
    if (preItems.length || preVersions.length) refreshPreview();

    // 개별 체크 토글
    document.querySelectorAll('.patch-check').forEach(function (cb) {
        cb.addEventListener('change', function () {
            const id = cb.getAttribute('data-id');
            const value = cb.checked ? 1 : 0;
            cb.disabled = true;
            fetch('/maintenance/patch/toggle/' + id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ patch_required: value })
            })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.success) throw new Error(data.message || 'failed');
                    const tr = cb.closest('tr');
                    if (value === 1) tr.classList.add('patch-needed');
                    else tr.classList.remove('patch-needed');
                    if (window.showNotification) {
                        window.showNotification('success', value === 1 ? '패치필요로 설정했습니다.' : '패치필요를 해제했습니다.');
                    }
                })
                .catch(function () {
                    cb.checked = !cb.checked;
                    if (window.showNotification) window.showNotification('error', '변경에 실패했습니다.');
                })
                .finally(function () { cb.disabled = false; });
        });
    });
})();
</script>
