<script>
(function () {
    const selects = {
        customers: document.getElementById('condCustomers'),
        items: document.getElementById('condItems'),
        versions: document.getElementById('condVersions')
    };
    const counters = {
        customers: document.getElementById('cntCustomers'),
        items: document.getElementById('cntItems'),
        versions: document.getElementById('cntVersions')
    };
    const previewBadge = document.getElementById('previewBadge');

    function selectedValues(sel) {
        return Array.from(sel.selectedOptions).map(function (o) { return o.value; });
    }

    function updateCounter(key) {
        counters[key].textContent = selectedValues(selects[key]).length + '개 선택';
    }

    let debounceTimer = null;

    function refreshPreview() {
        const items = selectedValues(selects.items);
        const versions = selectedValues(selects.versions);
        const customers = selectedValues(selects.customers);

        if (items.length === 0 && versions.length === 0) {
            previewBadge.className = 'badge text-bg-light border summary-pill';
            previewBadge.textContent = '조건 미리보기: 품목 또는 버전을 선택하세요';
            return;
        }

        const params = new URLSearchParams();
        items.forEach(function (v) { params.append('items', v); });
        versions.forEach(function (v) { params.append('versions', v); });
        customers.forEach(function (v) { params.append('customers', v); });

        previewBadge.className = 'badge text-bg-secondary summary-pill';
        previewBadge.textContent = '조건 미리보기 계산 중...';

        fetch('/maintenance/patch/preview-count?' + params.toString(), { headers: { 'Accept': 'application/json' } })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (!data.success) {
                    previewBadge.className = 'badge text-bg-warning summary-pill';
                    previewBadge.textContent = '미리보기를 불러오지 못했습니다';
                    return;
                }
                previewBadge.className = 'badge text-bg-info summary-pill';
                previewBadge.textContent = '조건 해당 ' + data.count + '건 (현재 패치필요 ' + data.checked + '건)';
            })
            .catch(function () {
                previewBadge.className = 'badge text-bg-warning summary-pill';
                previewBadge.textContent = '미리보기를 불러오지 못했습니다';
            });
    }

    function schedulePreview() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(refreshPreview, 180);
    }

    if (selects.customers && selects.items && selects.versions) {
        Object.keys(selects).forEach(function (key) {
            selects[key].addEventListener('change', function () {
                updateCounter(key);
                schedulePreview();
            });
        });

        document.querySelectorAll('[data-clear]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const sel = document.getElementById(btn.getAttribute('data-clear'));
                Array.from(sel.options).forEach(function (o) { o.selected = false; });
                const key = btn.getAttribute('data-clear').replace('cond', '').toLowerCase();
                updateCounter(key);
                schedulePreview();
            });
        });

        // 기존 필터를 조건 UI 에 반영
        const pre = {
            condCustomers: <%- JSON.stringify(filters.customers) %>,
            condItems: <%- JSON.stringify(filters.items) %>,
            condVersions: <%- JSON.stringify(filters.versions) %>
        };
        Object.keys(pre).forEach(function (id) {
            const sel = document.getElementById(id);
            if (!sel) return;
            Array.from(sel.options).forEach(function (o) {
                if (pre[id].indexOf(o.value) !== -1) o.selected = true;
            });
            updateCounter(id.replace('cond', '').toLowerCase());
        });
        if (pre.condItems.length || pre.condVersions.length) refreshPreview();
    }

    // 개별 체크 토글
    document.querySelectorAll('.patch-check').forEach(function (cb) {
        cb.addEventListener('change', function () {
            const id = cb.getAttribute('data-id');
            const value = cb.checked ? 1 : 0;
            cb.disabled = true;
            fetch('/maintenance/patch/toggle/' + id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ patch_required: value })
            })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.success) throw new Error(data.message || 'failed');
                    const tr = cb.closest('tr');
                    if (value === 1) tr.classList.add('patch-needed');
                    else tr.classList.remove('patch-needed');
                    if (window.showNotification) {
                        window.showNotification('success', value === 1 ? '패치필요로 설정했습니다.' : '패치필요를 해제했습니다.');
                    }
                })
                .catch(function () {
                    cb.checked = !cb.checked;
                    if (window.showNotification) window.showNotification('error', '변경에 실패했습니다.');
                })
                .finally(function () { cb.disabled = false; });
        });
    });
})();
</script>

<script>
/* ------------------------------------------------------------------
 * 품목 / 제조사 / 버전 복수행 인라인 편집 + 일괄 저장
 *
 *  - 편집 가능 필드: item_name(품목), manufacturer(제조사), item_version(버전)
 *  - 각 input 은 data-id / data-field / data-original 을 가짐
 *  - 변경된 필드만 모아서 POST /maintenance/patch/save-fields 로 전송
 * ------------------------------------------------------------------ */
(function () {
    const inputs = Array.from(document.querySelectorAll('.field-input'));
    const saveBtn = document.getElementById('saveFieldsBtn');
    const revertBtn = document.getElementById('revertFieldsBtn');
    const dirtyBadge = document.getElementById('dirtyBadge');

    if (!saveBtn || inputs.length === 0) return;

    // 품목명은 DB 상 NOT NULL 이므로 빈 값 저장 불가
    const REQUIRED_FIELDS = ['item_name'];
    const LABELS = { item_name: '품목', manufacturer: '제조사', item_version: '버전' };

    function rowOf(input) { return input.closest('tr'); }
    function fieldOf(input) { return input.getAttribute('data-field'); }
    function idOf(input) { return parseInt(input.getAttribute('data-id'), 10); }
    function originalOf(input) { return input.getAttribute('data-original') || ''; }

    function isDirty(input) {
        return input.value.trim() !== originalOf(input);
    }

    function isInvalid(input) {
        return REQUIRED_FIELDS.indexOf(fieldOf(input)) !== -1 && input.value.trim() === '';
    }

    // 변경된 필드만 수집: [{ id, item_name?, manufacturer?, item_version? }]
    function collectDirty() {
        const byId = new Map();
        inputs.forEach(function (input) {
            if (!isDirty(input)) return;
            const id = idOf(input);
            if (!byId.has(id)) byId.set(id, { id: id });
            byId.get(id)[fieldOf(input)] = input.value.trim();
        });
        return Array.from(byId.values());
    }

    function refreshDirtyState() {
        const dirtyIds = new Set();
        inputs.forEach(function (input) {
            const dirty = isDirty(input);
            input.classList.toggle('is-dirty', dirty);
            input.classList.toggle('is-invalid-name', isInvalid(input));
            if (dirty) dirtyIds.add(idOf(input));
        });

        document.querySelectorAll('tr[data-row-id]').forEach(function (tr) {
            tr.classList.toggle('row-dirty', dirtyIds.has(parseInt(tr.getAttribute('data-row-id'), 10)));
        });

        const rowCount = dirtyIds.size;
        dirtyBadge.textContent = '변경 ' + rowCount + '건';
        dirtyBadge.classList.toggle('show', rowCount > 0);
        saveBtn.disabled = rowCount === 0;
        if (revertBtn) revertBtn.disabled = rowCount === 0;
        return rowCount;
    }

    inputs.forEach(function (input) {
        input.addEventListener('input', refreshDirtyState);
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                input.blur();
            } else if (e.key === 'Escape') {
                input.value = originalOf(input);
                refreshDirtyState();
                input.blur();
            }
        });
    });

    function notify(type, message) {
        if (window.showNotification) window.showNotification(type, message);
        else alert(message);
    }

    // 되돌리기
    if (revertBtn) {
        revertBtn.addEventListener('click', function () {
            if (collectDirty().length === 0) return;
            if (!confirm('편집 중인 내용을 모두 되돌릴까요?')) return;
            inputs.forEach(function (input) {
                input.value = originalOf(input);
            });
            refreshDirtyState();
        });
    }

    saveBtn.addEventListener('click', async function () {
        const rows = collectDirty();
        if (rows.length === 0) return;

        // 필수값 검증 (품목명)
        const invalid = inputs.filter(isInvalid);
        if (invalid.length > 0) {
            notify('error', '품목명은 비워둘 수 없습니다. 값을 입력한 뒤 다시 저장해 주세요.');
            invalid[0].focus();
            return;
        }

        if (!confirm('변경된 ' + rows.length + '개 행을 저장할까요?')) return;

        const originalLabel = saveBtn.innerHTML;
        saveBtn.disabled = true;
        if (revertBtn) revertBtn.disabled = true;
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>저장 중...';

        try {
            const res = await fetch('/maintenance/patch/save-fields', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ rows: rows })
            });
            const data = await res.json();
            if (!res.ok || !data.success) throw new Error(data.message || '저장에 실패했습니다.');

            // 저장 성공 → 해당 필드의 기준값 갱신
            rows.forEach(function (row) {
                inputs.forEach(function (input) {
                    if (idOf(input) !== row.id) return;
                    const field = fieldOf(input);
                    if (!Object.prototype.hasOwnProperty.call(row, field)) return;
                    input.setAttribute('data-original', row[field]);
                    input.value = row[field];
                });
            });
            notify('success', data.message || '저장했습니다.');
        } catch (err) {
            notify('error', err.message || '저장 중 오류가 발생했습니다.');
        } finally {
            saveBtn.innerHTML = originalLabel;
            refreshDirtyState();
        }
    });

    // 저장하지 않고 이탈 시 경고
    window.addEventListener('beforeunload', function (e) {
        if (collectDirty().length > 0) {
            e.preventDefault();
            e.returnValue = '';
            return '';
        }
    });

    refreshDirtyState();
})();
</script>

<script>
/* ------------------------------------------------------------------
 * 컬럼 순서(드래그) / 표시 항목 선택
 *
 *  - 헤더(th)를 드래그하면 헤더와 각 행의 셀을 함께 이동시켜 정렬을 유지합니다.
 *  - 변경된 순서는 `cols` 파라미터로 모든 내부 링크(필터/페이지/엑셀)에 반영됩니다.
 *  - 표시 항목 변경은 서버 렌더링이 필요하므로 "적용" 시 페이지를 이동합니다.
 * ------------------------------------------------------------------ */
(function () {
    const STORAGE_KEY = 'patch:cols';
    const table = document.getElementById('patchTable');
    const headRow = document.getElementById('patchHeadRow');
    const pickerList = document.getElementById('columnPickerList');
    const applyBtn = document.getElementById('applyColumnsBtn');
    const resetBtn = document.getElementById('resetColumnsBtn');
    const countBadge = document.getElementById('columnCountBadge');
    const searchColsInput = document.getElementById('searchColsInput');

    if (!table || !headRow) return;

    const headCells = function () {
        return Array.from(headRow.querySelectorAll('th.col-head'));
    };

    function currentKeys() {
        return headCells().map(function (th) { return th.dataset.colKey; });
    }

    /* --- `cols` 파라미터를 링크/히든필드에 반영 --- */
    function syncColsParam(keys) {
        const joined = keys.join(',');

        if (searchColsInput) searchColsInput.value = joined;

        document.querySelectorAll('a[href*="/maintenance/patch"]').forEach(function (a) {
            const raw = a.getAttribute('href');
            if (!raw) return;
            const url = new URL(raw, window.location.origin);
            if (url.pathname === '/maintenance/patch' || url.pathname === '/maintenance/patch/download-excel') {
                url.searchParams.set('cols', joined);
                a.setAttribute('href', url.pathname + '?' + url.searchParams.toString());
            }
        });

        try { localStorage.setItem(STORAGE_KEY, joined); } catch (e) { /* ignore */ }
        if (countBadge) countBadge.textContent = keys.length;
    }

    /* --- 헤더 + 본문 셀을 새 순서로 재배치 (DOM 노드 이동 → 이벤트/입력값 보존) ---
     *  셀도 data-col-key 로 매핑하므로 여러 번 드래그해도 순서가 어긋나지 않습니다.
     */
    function applyOrder(keys) {
        const ths = headCells();
        const byKey = {};
        ths.forEach(function (th) { byKey[th.dataset.colKey] = th; });

        // 새 순서에 없는(존재하지 않는) key 는 무시
        const orderedKeys = keys.filter(function (k) { return Boolean(byKey[k]); });
        if (orderedKeys.length !== ths.length) return; // 불완전한 순서는 적용하지 않음

        // 헤더 재배치
        orderedKeys.forEach(function (k) { headRow.appendChild(byKey[k]); });

        // 각 행의 셀 재배치 (0번 셀은 NO, 나머지는 data-col-key 로 매핑)
        Array.from(table.querySelectorAll('tbody tr[data-row-id]')).forEach(function (tr) {
            const cells = Array.from(tr.children);
            if (!cells.length) return;

            const noCell = cells[0];
            const cellByKey = {};
            cells.slice(1).forEach(function (td) {
                const k = td.dataset.colKey;
                if (k) cellByKey[k] = td;
            });

            const frag = document.createDocumentFragment();
            frag.appendChild(noCell);
            orderedKeys.forEach(function (k) {
                if (cellByKey[k]) frag.appendChild(cellByKey[k]);
            });

            while (tr.firstChild) tr.removeChild(tr.firstChild);
            tr.appendChild(frag);
        });

        syncColsParam(orderedKeys);
    }

    /* --- 드래그 & 드롭 --- */
    let dragKey = null;

    headRow.addEventListener('dragstart', function (e) {
        const th = e.target.closest('th.col-head');
        if (!th) return;
        dragKey = th.dataset.colKey;
        th.classList.add('col-dragging');
        if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = 'move';
            try { e.dataTransfer.setData('text/plain', dragKey); } catch (err) { /* ignore */ }
        }
    });

    headRow.addEventListener('dragover', function (e) {
        const th = e.target.closest('th.col-head');
        if (!th || !dragKey || th.dataset.colKey === dragKey) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';

        headCells().forEach(function (h) { h.classList.remove('col-dragover'); });
        th.classList.add('col-dragover');
    });

    headRow.addEventListener('dragleave', function (e) {
        const th = e.target.closest('th.col-head');
        if (th) th.classList.remove('col-dragover');
    });

    headRow.addEventListener('drop', function (e) {
        const target = e.target.closest('th.col-head');
        if (!target || !dragKey || target.dataset.colKey === dragKey) return;
        e.preventDefault();

        const keys = currentKeys();
        const from = keys.indexOf(dragKey);
        const to = keys.indexOf(target.dataset.colKey);
        if (from < 0 || to < 0) return;

        // 대상 셀의 좌/우 절반을 기준으로 앞/뒤 삽입
        const rect = target.getBoundingClientRect();
        const insertAfter = e.clientX > rect.left + rect.width / 2;

        keys.splice(from, 1);
        let insertAt = keys.indexOf(target.dataset.colKey);
        if (insertAfter) insertAt += 1;
        keys.splice(insertAt, 0, dragKey);

        applyOrder(keys);
        dragKey = null;
    });

    headRow.addEventListener('dragend', function () {
        dragKey = null;
        headCells().forEach(function (h) {
            h.classList.remove('col-dragging');
            h.classList.remove('col-dragover');
        });
    });

    /* --- 컬럼 선택 적용 --- */
    if (applyBtn && pickerList) {
        applyBtn.addEventListener('click', function () {
            const checked = Array.from(pickerList.querySelectorAll('.col-toggle:checked'))
                .map(function (cb) { return cb.value; });

            if (checked.length === 0) {
                alert('최소 1개 이상의 항목을 선택해 주세요.');
                return;
            }

            // 현재 화면 순서를 우선 유지하고, 새로 추가된 항목은 뒤에 붙인다.
            const visible = currentKeys();
            const ordered = visible.filter(function (k) { return checked.indexOf(k) !== -1; });
            checked.forEach(function (k) {
                if (ordered.indexOf(k) === -1) ordered.push(k);
            });

            const url = new URL(window.location.href);
            url.searchParams.set('cols', ordered.join(','));
            url.searchParams.delete('page');
            window.location.href = url.pathname + '?' + url.searchParams.toString();
        });
    }

    if (resetBtn) {
        resetBtn.addEventListener('click', function () {
            try { localStorage.removeItem(STORAGE_KEY); } catch (e) { /* ignore */ }
            const url = new URL(window.location.href);
            url.searchParams.delete('cols');
            url.searchParams.delete('page');
            const qs = url.searchParams.toString();
            window.location.href = url.pathname + (qs ? '?' + qs : '');
        });
    }

    /* --- 저장된 순서 복원 (동일한 컬럼 집합일 때만) --- */
    (function restoreStoredOrder() {
        let stored = null;
        try { stored = localStorage.getItem(STORAGE_KEY); } catch (e) { return; }
        if (!stored) return;

        const storedKeys = stored.split(',').filter(Boolean);
        const now = currentKeys();
        if (storedKeys.length !== now.length) return;

        // 같은 컬럼 집합인지 확인 (순서만 다를 수 있음)
        const sortedStored = storedKeys.slice().sort().join(',');
        const sortedNow = now.slice().sort().join(',');
        if (sortedStored !== sortedNow) return;

        applyOrder(storedKeys);
    })();

    // 최초 로드 시 링크에 현재 컬럼 순서를 반영
    syncColsParam(currentKeys());
})();
</script>


<script>
/* ------------------------------------------------------------------
 * 라인 선택 + 품목 추가 (행추가)
 *
 *  1) 목록의 행(고객사 라인)을 클릭하면 선택되고, "품목 추가" 버튼이 활성화됩니다.
 *  2) 모달에서 "행 추가" 로 여러 품목을 한 번에 입력할 수 있습니다.
 *     POST /maintenance/patch/add-item  →  { summary_id, items: [ {item_name, manufacturer, item_version, item_detail} ] }
 *  3) 추가 성공 시 목록을 다시 불러와 새 행이 바로 보이도록 합니다.
 *
 *  ※ 입력은 항상 .value 로만 읽고, 화면 표시는 createElement/textContent 로 처리합니다.
 * ------------------------------------------------------------------ */
(function () {
    const table = document.getElementById('patchTable');
    const addBtn = document.getElementById('addItemBtn');
    const selectionInfo = document.getElementById('selectionInfo');
    const modalEl = document.getElementById('addItemModal');

    if (!table || !addBtn || !modalEl) return;

    const summarySelect = modalEl.querySelector('#addItemSummary');
    const rowsBox = modalEl.querySelector('#addItemRows');
    const addRowBtn = modalEl.querySelector('#addItemRowBtn');
    const submitBtn = modalEl.querySelector('#addItemSubmitBtn');
    const hint = modalEl.querySelector('#addItemHint');

    let activeRow = null;
    let modal = null;
    if (window.bootstrap && window.bootstrap.Modal) {
        modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
    }

    function notify(type, message) {
        if (window.showNotification) window.showNotification(type, message);
        else alert(message);
    }

    /* ------------------------- 라인 선택 ------------------------- */

    function clearSelection() {
        table.querySelectorAll('tbody tr.row-selected').forEach(function (tr) {
            tr.classList.remove('row-selected');
        });
        activeRow = null;
        addBtn.disabled = true;
        addBtn.setAttribute('title', '목록에서 고객사 라인을 먼저 클릭하세요');
        if (selectionInfo) {
            selectionInfo.textContent = '선택된 라인 없음';
            selectionInfo.setAttribute('title', '선택된 고객사(라인)');
        }
    }

    function selectRow(tr) {
        table.querySelectorAll('tbody tr[data-row-id]').forEach(function (other) {
            other.classList.toggle('row-selected', other === tr);
        });

        activeRow = tr;
        addBtn.disabled = false;
        addBtn.setAttribute('title', '선택한 라인에 품목을 추가합니다');

        const customer = tr.getAttribute('data-customer') || '(고객사 없음)';
        if (selectionInfo) {
            selectionInfo.textContent = customer;
            selectionInfo.setAttribute('title', customer);
        }
    }

    table.addEventListener('click', function (e) {
        const tr = e.target.closest('tbody tr[data-row-id]');
        if (!tr) return;
        // 편집 입력/체크박스/버튼 클릭은 라인 선택으로 처리하지 않음
        if (e.target.closest('input, textarea, select, a, button, label')) return;
        if (tr === activeRow) clearSelection();
        else selectRow(tr);
    });

    clearSelection();

    /* ---------------------- 모달 입력 행 ------------------------- */

    const FIELDS = [
        { field: 'item_name', label: '품목명', required: true, col: 'col-md-3', list: 'dlItemNames', placeholder: '예) FortiGate 100F' },
        { field: 'manufacturer', label: '제조사', required: false, col: 'col-md-3', list: 'dlManufacturers', placeholder: '예) Fortinet' },
        { field: 'item_version', label: '버전', required: false, col: 'col-md-3', list: 'dlVersions', placeholder: '예) v7.0.12' },
        { field: 'item_detail', label: '상세내용', required: false, col: 'col-md-3', list: null, placeholder: '예) 방화벽' }
    ];

    function rowsList() {
        return Array.prototype.slice.call(rowsBox.querySelectorAll('[data-add-row]'));
    }

    function renumberRows() {
        const rows = rowsBox.querySelectorAll('[data-add-row]');
        Array.prototype.forEach.call(rows, function (row, i) {
            const idx = row.querySelector('.row-index');
            if (idx) idx.textContent = '품목 ' + (i + 1);
        });
        if (submitBtn) submitBtn.disabled = rows.length === 0;
        if (hint) hint.textContent = rows.length + '건 입력';
    }

    function createRow(focus) {
        const wrap = document.createElement('div');
        wrap.className = 'add-item-row border rounded p-2 mb-2';
        wrap.setAttribute('data-add-row', '');

        // 머리글: 순번 + 삭제
        const head = document.createElement('div');
        head.className = 'd-flex justify-content-between align-items-center mb-1';

        const idx = document.createElement('span');
        idx.className = 'row-index text-muted fw-semibold';

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'btn btn-link btn-sm text-danger p-0';
        remove.setAttribute('data-remove-row', '');
        remove.textContent = '삭제';
        remove.addEventListener('click', function () {
            wrap.remove();
            if (rowsList().length === 0) createRow(false);
            renumberRows();
        });

        head.appendChild(idx);
        head.appendChild(remove);
        wrap.appendChild(head);

        // 입력 4칸
        const grid = document.createElement('div');
        grid.className = 'row g-2';

        FIELDS.forEach(function (def) {
            const cell = document.createElement('div');
            cell.className = def.col;

            const label = document.createElement('label');
            label.className = 'form-label';
            label.textContent = def.label;
            if (def.required) {
                const star = document.createElement('span');
                star.className = 'text-danger';
                star.textContent = ' *';
                label.appendChild(star);
            }

            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'form-control form-control-sm';
            input.setAttribute('data-field', def.field);
            input.setAttribute('maxlength', '255');
            input.setAttribute('autocomplete', 'off');
            if (def.placeholder) input.setAttribute('placeholder', def.placeholder);
            if (def.list) input.setAttribute('list', def.list);
            input.addEventListener('input', function () {
                input.classList.remove('is-invalid');
                wrap.classList.remove('is-invalid-name');
                updateSubmitState();
            });

            cell.appendChild(label);
            cell.appendChild(input);
            grid.appendChild(cell);
        });

        wrap.appendChild(grid);

        // Enter: 다음 행 이동 / 마지막 행이면 새 행 추가
        wrap.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter') return;
            e.preventDefault();
            const rows = rowsList();
            const pos = rows.indexOf(wrap);
            if (pos >= 0 && pos < rows.length - 1) {
                const next = rows[pos + 1].querySelector('[data-field="item_name"]');
                if (next) next.focus();
            } else {
                const created = createRow(true);
                const next = created.querySelector('[data-field="item_name"]');
                if (next) next.focus();
            }
        });

        rowsBox.appendChild(wrap);
        renumberRows();

        if (focus) {
            const first = wrap.querySelector('[data-field="item_name"]');
            if (first) first.focus();
        }
        updateSubmitState();
        return wrap;
    }

    function valueOf(row, field) {
        const input = row.querySelector('[data-field="' + field + '"]');
        return input ? input.value.trim() : '';
    }

    function readRows() {
        const items = [];
        const invalid = [];

        rowsList().forEach(function (row, i) {
            const item = {
                item_name: valueOf(row, 'item_name'),
                manufacturer: valueOf(row, 'manufacturer'),
                item_version: valueOf(row, 'item_version'),
                item_detail: valueOf(row, 'item_detail')
            };
            const blank = !item.item_name && !item.manufacturer && !item.item_version && !item.item_detail;
            if (blank) return; // 완전히 빈 행은 전송하지 않음

            if (!item.item_name) {
                invalid.push({ index: i, row: row });
                return;
            }
            items.push(item);
        });

        return { items: items, invalid: invalid };
    }

    function updateSubmitState() {
        if (!submitBtn) return;
        const parsed = readRows();
        // 입력값이 하나라도 있으면 버튼은 활성화하고, 검증은 클릭 시점에 안내합니다.
        submitBtn.disabled = parsed.items.length === 0 && parsed.invalid.length === 0;
    }

    if (addRowBtn) {
        addRowBtn.addEventListener('click', function () { createRow(true); });
    }

    /* ------------------- 모달 열기 / 닫기 ------------------------ */

    function activeSummaryId() {
        return activeRow ? (activeRow.getAttribute('data-summary-id') || '') : '';
    }

    function openModal() {
        rowsBox.innerHTML = '';
        createRow(false);

        if (summarySelect) {
            summarySelect.value = activeSummaryId();
            summarySelect.classList.remove('is-invalid');
        }
        renumberRows();
        updateSubmitState();

        if (modal) modal.show();
        else modalEl.classList.add('show');
    }

    addBtn.addEventListener('click', function () {
        if (!activeRow) {
            notify('warning', '목록에서 품목을 추가할 고객사 라인을 먼저 클릭해 주세요.');
            return;
        }
        openModal();
    });

    /* ------------------------- 저장 ----------------------------- */

    if (submitBtn) {
        submitBtn.addEventListener('click', async function () {
            const summaryId = summarySelect ? summarySelect.value : '';
            if (!summaryId) {
                if (summarySelect) summarySelect.classList.add('is-invalid');
                notify('error', '품목을 추가할 고객사를 선택해 주세요.');
                return;
            }

            const parsed = readRows();
            if (parsed.invalid.length > 0) {
                parsed.invalid.forEach(function (entry) {
                    entry.row.classList.add('is-invalid-name');
                    const input = entry.row.querySelector('[data-field="item_name"]');
                    if (input) input.classList.add('is-invalid');
                });
                const first = parsed.invalid[0].row.querySelector('[data-field="item_name"]');
                if (first) first.focus();
                notify('error', '품목명은 필수 입력 항목입니다. 입력 후 다시 시도해 주세요.');
                return;
            }
            if (parsed.items.length === 0) {
                notify('warning', '추가할 품목을 1건 이상 입력해 주세요.');
                return;
            }

            const originalLabel = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>추가 중...';

            try {
                const res = await fetch('/maintenance/patch/add-item', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ summary_id: summaryId, items: parsed.items })
                });

                const text = await res.text();
                let data = {};
                try { data = JSON.parse(text); } catch (e) { data = { success: false, message: '응답을 해석할 수 없습니다.' }; }

                if (!res.ok || !data.success) {
                    throw new Error(data.message || '품목 추가에 실패했습니다.');
                }

                if (modal) modal.hide();
                notify('success', data.message || '품목을 추가했습니다.');

                // 목록 갱신 → 추가된 품목 행이 바로 보임
                setTimeout(function () { window.location.reload(); }, 200);
            } catch (err) {
                notify('error', err.message || '품목 추가 중 오류가 발생했습니다.');
                submitBtn.disabled = false;
            } finally {
                submitBtn.innerHTML = originalLabel;
            }
        });
    }
})();
</script>


<script>
/* ------------------------------------------------------------------
 * 엑셀 복사&붙여넣기 — 대량 일괄 업데이트
 *
 *  1) 엑셀에서 머리글 포함 셀 범위를 복사해 textarea 에 붙여넣기
 *  2) 미리보기 → POST /maintenance/patch/paste-preview  (DB 변경 없음)
 *  3) 적용     → POST /maintenance/patch/paste-apply    (서버 재매칭 후 트랜잭션 UPDATE)
 *
 *  ※ 모든 화면 출력은 createElement / textContent 로만 처리 (붙여넣은 값 = 사용자 입력)
 * ------------------------------------------------------------------ */
(function () {
    const btn = document.getElementById('pasteBtn');
    const modalEl = document.getElementById('pasteModal');
    if (!btn || !modalEl || !window.bootstrap) return;

    const modal = new bootstrap.Modal(modalEl);

    const step1 = document.getElementById('pasteStep1');
    const step2 = document.getElementById('pasteStep2');
    const textarea = document.getElementById('pasteText');
    const hasHeaderSel = document.getElementById('pasteHasHeader');
    const orderInput = document.getElementById('pasteColumnOrder');
    const fillOrderBtn = document.getElementById('pasteFillOrderBtn');
    const clearBtn = document.getElementById('pasteClearBtn');
    const textStat = document.getElementById('pasteTextStat');

    const previewBtn = document.getElementById('pastePreviewBtn');
    const applyBtn = document.getElementById('pasteApplyBtn');
    const backBtn = document.getElementById('pasteBackBtn');
    const footerHint = document.getElementById('pasteFooterHint');

    const body = document.getElementById('pastePreviewBody');
    const badgeTotal = document.getElementById('pasteBadgeTotal');
    const badgeChanged = document.getElementById('pasteBadgeChanged');
    const badgeUnchanged = document.getElementById('pasteBadgeUnchanged');
    const badgeNotFound = document.getElementById('pasteBadgeNotFound');
    const badgeAmbiguous = document.getElementById('pasteBadgeAmbiguous');
    const parseInfo = document.getElementById('pasteParseInfo');
    const warnBox = document.getElementById('pasteWarnBox');

    const DEFAULT_ORDER = '품목, 제조사, 모델명, EoS, EoL, S/N, FW버전, OS버전, 점검위치';
    const DELIM_LABEL = { TAB: '탭(Tab) 구분', COMMA: '쉼표(,) 구분' };

    let lastPayload = null;     // 미리보기 성공 시 요청 본문 캐시 (적용 시 동일 본문 재사용)
    let lastChangedCount = 0;   // 미리보기에서 계산된 변경 예정 건수

    function notify(type, message) {
        if (window.showNotification) window.showNotification(type, message);
        else if (type === 'error') alert(message);
    }

    function el(tag, className, text) {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined && text !== null) node.textContent = String(text);
        return node;
    }

    /* ---------------- 붙여넣기 통계 ---------------- */
    function updateTextStat() {
        const raw = textarea.value || '';
        const lines = raw.trim() === '' ? 0 : raw.replace(/\r\n/g, '\n').replace(/\s+$/, '').split('\n').length;
        textStat.textContent = lines + '줄 · ' + raw.length.toLocaleString() + '자';
        if (previewBtn) previewBtn.disabled = raw.trim() === '';
    }

    textarea.addEventListener('input', updateTextStat);

    fillOrderBtn.addEventListener('click', function () {
        orderInput.value = DEFAULT_ORDER;
        if (hasHeaderSel.value === 'auto') hasHeaderSel.value = '0';
        orderInput.focus();
    });

    clearBtn.addEventListener('click', function () {
        textarea.value = '';
        orderInput.value = '';
        hasHeaderSel.value = 'auto';
        resetToStep1();
        updateTextStat();
        textarea.focus();
    });

    /* ---------------- 단계 전환 ---------------- */
    function resetToStep1() {
        clearPreview();
        step1.classList.remove('d-none');
        step2.classList.add('d-none');
        previewBtn.classList.remove('d-none');
        previewBtn.disabled = (textarea.value || '').trim() === '';
        applyBtn.classList.add('d-none');
        backBtn.classList.add('d-none');
        footerHint.textContent = '';
    }

    function showStep2() {
        step1.classList.add('d-none');
        step2.classList.remove('d-none');
        previewBtn.classList.add('d-none');
        backBtn.classList.remove('d-none');
    }

    function clearPreview() {
        while (body.firstChild) body.removeChild(body.firstChild);
        lastPayload = null;
        warnBox.classList.add('d-none');
        warnBox.textContent = '';
        parseInfo.textContent = '';
        [badgeTotal, badgeChanged, badgeUnchanged, badgeNotFound, badgeAmbiguous].forEach(function (b) {
            b.textContent = b.dataset.base || b.textContent;
        });
        applyBtn.disabled = false;
    }

    /* ---------------- 미리보기 렌더링 ---------------- */
    function statusBadge(status, strategy) {
        const map = {
            matched: ['text-bg-success', '일치'],
            not_found: ['text-bg-warning', '미매칭'],
            ambiguous: ['text-bg-danger', '중복']
        };
        const conf = map[status] || ['text-bg-secondary', status || '-'];
        const wrap = el('span', 'd-inline-flex flex-column gap-1');
        wrap.appendChild(el('span', 'badge ' + conf[0], conf[1]));
        if (strategy) {
            const s = String(strategy);
            let label = s;
            if (s === 'serial') label = 'S/N';
            else if (s === 'item') label = '품목명';
            wrap.appendChild(el('span', 'text-muted', label));
        }
        return wrap;
    }

    function renderChangeList(changes) {
        const wrap = el('div', 'd-flex flex-column gap-1');
        if (!changes || changes.length === 0) {
            wrap.appendChild(el('span', 'text-muted fst-italic', '변경 없음'));
            return wrap;
        }

        changes.forEach(function (chg) {
            const line = el('div', 'small d-flex flex-wrap align-items-center gap-1');

            const key = el('span', 'fw-semibold text-secondary', (chg.label || chg.key) + ':');
            line.appendChild(key);

            const before = (chg.before === null || chg.before === undefined || chg.before === '')
                ? '(빈값)'
                : String(chg.before);
            const after = (chg.after === null || chg.after === undefined || chg.after === '')
                ? '(빈값)'
                : String(chg.after);

            const b = el('span', 'text-danger text-decoration-line-through paste-before', before);
            b.title = '변경 전: ' + before;
            line.appendChild(b);

            line.appendChild(el('span', 'text-muted', '→'));

            const a = el('span', 'text-success fw-semibold paste-after', after);
            a.title = '변경 후: ' + after;
            line.appendChild(a);

            wrap.appendChild(line);
        });

        return wrap;
    }

    function renderPreview(data) {
        clearPreview();

        const counts = data.counts || {};
        const total = Number(counts.total) || 0;
        const changed = Number(counts.changed) || 0;
        const unchanged = Number(counts.unchanged) || 0;
        const notFound = Number(counts.notFound) || 0;
        const ambiguous = Number(counts.ambiguous) || 0;

        badgeTotal.textContent = '전체 ' + total;
        badgeChanged.textContent = '변경 ' + changed;
        badgeUnchanged.textContent = '변경없음 ' + unchanged;
        badgeNotFound.textContent = '미매칭 ' + notFound;
        badgeAmbiguous.textContent = '중복매칭 ' + ambiguous;

        [badgeTotal, badgeChanged, badgeUnchanged, badgeNotFound, badgeAmbiguous].forEach(function (b) {
            b.dataset.base = b.textContent;
        });

        const info = [];
        info.push('헤더 ' + (data.headerDetected ? '자동 인식' : '없음'));
        info.push(DELIM_LABEL[data.delimiter] || '구분자 자동');
        if (Array.isArray(data.fields) && data.fields.length) {
            info.push('인식 컬럼 ' + data.fields.length + '개');
        }
        if (data.previewLimited) info.push('결과는 최대 ' + data.rows.length + '건만 표시');
        parseInfo.textContent = info.join(' · ');

        const warnings = [];
        if (Array.isArray(data.ignoredHeaders) && data.ignoredHeaders.length) {
            warnings.push('무시된 헤더: ' + data.ignoredHeaders.join(', '));
        }
        if (data.truncated) {
            warnings.push('입력한 행이 너무 많아 일부만 처리했습니다.');
        }
        if (notFound > 0 || ambiguous > 0) {
            warnings.push('미매칭/중복매칭 ' + (notFound + ambiguous) + '건은 반영되지 않습니다. S/N 또는 품목명을 확인해 주세요.');
        }
        if (warnings.length) {
            warnBox.textContent = warnings.join(' ');
            warnBox.classList.remove('d-none');
        }

        (data.rows || []).forEach(function (row) {
            const tr = el('tr');
            if (row.status === 'not_found') tr.className = 'table-warning';
            if (row.status === 'ambiguous') tr.className = 'table-danger';
            if (row.status === 'matched' && row.changeCount > 0) tr.className = 'table-success-subtle';

            tr.appendChild(el('td', 'text-center text-muted', row.index));
            tr.appendChild(el('td', 'text-center text-muted', row.line));

            const tdStatus = el('td', 'text-center');
            tdStatus.appendChild(statusBadge(row.status, row.strategy));
            tr.appendChild(tdStatus);

            const customer = row.customerCompany || '';
            tr.appendChild(el('td', '', customer || '-'));

            const tdItem = el('td');
            tdItem.appendChild(el('div', 'fw-semibold', row.itemName || '-'));
            const sub = [];
            if (row.modelName) sub.push('모델 ' + row.modelName);
            if (row.serialNumber) sub.push('S/N ' + row.serialNumber);
            if (sub.length) tdItem.appendChild(el('div', 'text-muted small', sub.join(' · ')));
            if (row.status === 'ambiguous') {
                tdItem.appendChild(el('div', 'text-danger small', '후보 ' + row.candidateCount + '건 — S/N을 함께 입력해 주세요'));
            }
            tr.appendChild(tdItem);

            const tdChg = el('td');
            tdChg.appendChild(renderChangeList(row.changes));
            tr.appendChild(tdChg);

            body.appendChild(tr);
        });

        if (!body.firstChild) {
            const tr = el('tr');
            const td = el('td', 'text-center text-muted py-4', '표시할 결과가 없습니다.');
            td.colSpan = 6;
            tr.appendChild(td);
            body.appendChild(tr);
        }

        if (changed > 0) {
            lastChangedCount = changed;
            applyBtn.disabled = false;
            while (applyBtn.firstChild) applyBtn.removeChild(applyBtn.firstChild);
            const icon = document.createElement('i');
            icon.className = 'fa-solid fa-cloud-arrow-up me-1';
            applyBtn.appendChild(icon);
            applyBtn.appendChild(document.createTextNode('적용 (' + changed + '건)'));
            footerHint.textContent = '적용하면 ' + changed + '건의 값이 실제로 변경됩니다.';
        } else {
            lastChangedCount = 0;
            applyBtn.disabled = true;
            applyBtn.textContent = '적용 (변경 0건)';
            footerHint.textContent = '변경되는 값이 없습니다. 붙여넣은 값이 기존 값과 동일합니다.';
        }
    }

    /* ---------------- 서버 통신 ---------------- */
    async function postJson(url, payload) {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(payload)
        });
        const text = await res.text();
        let data = {};
        try {
            data = JSON.parse(text);
        } catch (e) {
            data = { success: false, message: '응답을 해석할 수 없습니다. (HTTP ' + res.status + ')' };
        }
        return { ok: res.ok, data: data };
    }

    previewBtn.addEventListener('click', async function () {
        const raw = (textarea.value || '').trim();
        if (raw === '') {
            notify('warning', '붙여넣은 내용이 없습니다. 엑셀에서 셀 범위를 복사해 붙여넣어 주세요.');
            textarea.focus();
            return;
        }

        const original = previewBtn.innerHTML;
        previewBtn.disabled = true;
        previewBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>확인 중...';

        try {
            const payload = {
                text: textarea.value,
                has_header: hasHeaderSel.value,
                column_order: (orderInput.value || '').trim()
            };

            const { ok, data } = await postJson('/maintenance/patch/paste-preview', payload);

            if (!ok || !data.success) {
                notify('error', data.message || '미리보기에 실패했습니다.');
                return;
            }

            lastPayload = payload;
            showStep2();
            renderPreview(data);
        } catch (err) {
            notify('error', err.message || '미리보기 중 오류가 발생했습니다.');
        } finally {
            previewBtn.innerHTML = original;
            previewBtn.disabled = false;
        }
    });

    backBtn.addEventListener('click', function () {
        resetToStep1();
    });

    applyBtn.addEventListener('click', async function () {
        if (!lastPayload) {
            notify('warning', '먼저 미리보기를 실행해 주세요.');
            return;
        }

        const ok = window.confirm('미리보기 결과대로 DB에 반영합니다.\n변경 ' + lastChangedCount + '건이 업데이트됩니다. 계속할까요?');
        if (!ok) return;

        const original = applyBtn.innerHTML;
        const originalWidth = applyBtn.offsetWidth;
        applyBtn.disabled = true;
        applyBtn.style.minWidth = originalWidth + 'px';
        applyBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>적용 중...';

        try {
            const { ok: httpOk, data } = await postJson('/maintenance/patch/paste-apply', lastPayload);

            if (!httpOk || !data.success) {
                notify('error', data.message || '적용에 실패했습니다.');
                return;
            }

            notify('success', data.message || '업데이트했습니다.');
            modal.hide();
            setTimeout(function () { window.location.reload(); }, 400);
        } catch (err) {
            notify('error', err.message || '적용 중 오류가 발생했습니다.');
        } finally {
            applyBtn.innerHTML = original;
            applyBtn.disabled = false;
            applyBtn.style.minWidth = '';
        }
    });

    /* ---------------- 열기/닫기 ---------------- */
    btn.addEventListener('click', function () {
        resetToStep1();
        updateTextStat();
        modal.show();
        setTimeout(function () { textarea.focus(); }, 300);
    });

    modalEl.addEventListener('shown.bs.modal', function () {
        updateTextStat();
        textarea.focus();
    });

    modalEl.addEventListener('hidden.bs.modal', function () {
        resetToStep1();
    });

    // 최초 상태
    updateTextStat();
})();
</script>
