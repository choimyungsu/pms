<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<%
    // 필터 유지 링크 생성 (patch 필터만 교체)
    const baseParams = new URLSearchParams();
    if (filters.search) baseParams.set('search', filters.search);
    filters.customers.forEach(function (v) { baseParams.append('customers', v); });
    filters.items.forEach(function (v) { baseParams.append('items', v); });
    filters.versions.forEach(function (v) { baseParams.append('versions', v); });
    if (filters.cols) baseParams.set('cols', filters.cols);
    const buildUrl = function (patchVal) {
        const p = new URLSearchParams(baseParams.toString());
        if (patchVal) p.set('patch', patchVal);
        const s = p.toString();
        return '/maintenance/patch' + (s ? '?' + s : '');
    };

    // 컬럼 렌더링 헬퍼
    const pad2 = function (n) { return String(n).padStart(2, '0'); };
    const fmtDate = function (v) {
        if (!v) return '';
        const d = new Date(v);
        if (isNaN(d.getTime())) return String(v);
        return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
    };
    const fmtDateTime = function (v) {
        if (!v) return '';
        const d = new Date(v);
        if (isNaN(d.getTime())) return String(v);
        return fmtDate(d) + ' ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes());
    };
    const colSpan = columns.length + 1;

    // 읽기 전용 컬럼 값 표시
    const textValue = function (r, col) {
        const raw = r[col.key];
        if (col.type === 'date') return fmtDate(raw) || '-';
        if (col.type === 'datetime') return fmtDateTime(raw) || '-';
        if (raw === null || raw === undefined || raw === '') return '-';
        return String(raw);
    };
%>

<style>
    .patch-toolbar { gap: .5rem; flex-wrap: wrap; }
    .patch-table { font-size: 0.85rem; }
    .patch-table th, .patch-table td { vertical-align: middle; }
    .patch-table td.patch-cell { text-align: center; }
    .patch-needed { background-color: #fff3cd !important; }
    .patch-check { width: 18px; height: 18px; cursor: pointer; }
    .condition-group { border-right: 1px solid rgba(0,0,0,.1); }
    .condition-group:last-child { border-right: 0; }
    .condition-title { font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .02em; }
    .multi-select { min-height: 132px; font-size: .8rem; }
    .summary-pill { font-size: .8rem; }
    .field-input { min-width: 120px; font-size: .82rem; }
    .field-input.field-item_name { min-width: 130px; }
    .field-input.field-item_version { min-width: 130px; }
    .field-input.is-dirty { border-color: #ffc107; background-color: #fffdf3; box-shadow: 0 0 0 .15rem rgba(255,193,7,.25); }
    .field-input.is-invalid-name { border-color: #dc3545; background-color: #fff5f5; }
    tr.row-dirty > td { background-color: #fffdf3; }
    .dirty-badge { display: none; }
    .dirty-badge.show { display: inline-block; }
    /* 컬럼 이동(드래그) */
    .patch-table th.col-head { cursor: grab; user-select: none; white-space: nowrap; }
    .patch-table th.col-head:active { cursor: grabbing; }
    .patch-table th.col-head .col-drag-handle { color: #adb5bd; margin-right: .25rem; font-size: .8em; }
    .patch-table th.col-dragging { opacity: .35; }
    .patch-table th.col-dragover { background-color: #e7f1ff !important; box-shadow: inset 2px 0 0 #0d6efd; }
    .column-picker-menu { min-width: 320px; max-height: 440px; overflow-y: auto; }
    .col-hint { font-size: .78rem; }
    /* 라인(행) 선택 → 품목 추가 */
    .patch-table tbody tr[data-row-id] { cursor: pointer; }
    .patch-table tbody tr.row-selected > td { background-color: #e7f1ff !important; box-shadow: inset 2px 0 0 #0d6efd; }
    .patch-table tr.patch-needed.row-selected > td { background-color: #fff0c2 !important; }
    .selection-info { max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; }
    .add-item-row { transition: border-color .15s ease-in-out, background-color .15s ease-in-out; }
    .add-item-row .form-label { font-size: .78rem; margin-bottom: .15rem; }
    .add-item-row.is-invalid-name { border-color: #dc3545 !important; background-color: #fff5f5 !important; }
    .add-item-row .row-index { font-size: .75rem; }
    @media (max-width: 991.98px) {
        .condition-group { border-right: 0; border-bottom: 1px solid rgba(0,0,0,.1); padding-bottom: .75rem; }
    }
</style>

<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0"><%= page_title %></h3>
                    <div class="text-muted small mt-1">
                        유지보수(요약) 기준 · 고객사 / 품목 / 버전 현황 및 패치필요 판정
                    </div>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item">유지보수 관리</li>
                        <li class="breadcrumb-item active"><%= page_title %></li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">

            <% if (notice) { %>
            <div class="alert alert-<%= noticeType === 'error' ? 'danger' : (noticeType === 'warning' ? 'warning' : 'success') %> alert-dismissible fade show" role="alert">
                <%= notice %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <!-- 요약 -->
            <div class="row g-2 mb-3">
                <div class="col-6 col-md-3">
                    <div class="card mb-0">
                        <div class="card-body py-2">
                            <div class="text-muted small">전체 품목</div>
                            <div class="fs-5 fw-semibold"><%= globalTotal %>건</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card mb-0">
                        <div class="card-body py-2">
                            <div class="text-muted small">전체 패치필요</div>
                            <div class="fs-5 fw-semibold text-danger"><%= globalRequired %>건</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card mb-0">
                        <div class="card-body py-2">
                            <div class="text-muted small">조회 결과</div>
                            <div class="fs-5 fw-semibold"><%= filteredTotal %>건</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card mb-0">
                        <div class="card-body py-2">
                            <div class="text-muted small">조회 결과 중 패치필요</div>
                            <div class="fs-5 fw-semibold text-danger"><%= filteredRequired %>건</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 조건 설정 -->
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold"><i class="fa-solid fa-filter me-1"></i>패치필요 조건 설정</span>
                    <span class="text-muted small">품목 / 버전 복수 선택 (Ctrl 또는 Shift + 클릭)</span>
                </div>
                <div class="card-body">
                    <form id="conditionForm" method="POST" action="/maintenance/patch/apply-condition">
                        <div class="row g-3">
                            <div class="col-12 col-lg-4 condition-group">
                                <div class="condition-title mb-2">고객사 (선택)</div>
                                <select class="form-select multi-select" id="condCustomers" name="customers" multiple size="6">
                                    <% customerOptions.forEach(function (c) { %>
                                    <option value="<%= c %>"><%= c %></option>
                                    <% }) %>
                                </select>
                                <div class="d-flex justify-content-between mt-1">
                                    <button type="button" class="btn btn-link btn-sm p-0" data-clear="condCustomers">선택 해제</button>
                                    <span class="text-muted small" id="cntCustomers">0개 선택</span>
                                </div>
                            </div>

                            <div class="col-12 col-lg-4 condition-group">
                                <div class="condition-title mb-2">품목 (복수 선택)</div>
                                <select class="form-select multi-select" id="condItems" name="items" multiple size="6">
                                    <% itemOptions.forEach(function (v) { %>
                                    <option value="<%= v %>"><%= v %></option>
                                    <% }) %>
                                </select>
                                <div class="d-flex justify-content-between mt-1">
                                    <button type="button" class="btn btn-link btn-sm p-0" data-clear="condItems">선택 해제</button>
                                    <span class="text-muted small" id="cntItems">0개 선택</span>
                                </div>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="condition-title mb-2">버전 (복수 선택)</div>
                                <select class="form-select multi-select" id="condVersions" name="versions" multiple size="6">
                                    <% versionOptions.forEach(function (v) { %>
                                    <option value="<%= v %>"><%= v %></option>
                                    <% }) %>
                                </select>
                                <div class="d-flex justify-content-between mt-1">
                                    <button type="button" class="btn btn-link btn-sm p-0" data-clear="condVersions">선택 해제</button>
                                    <span class="text-muted small" id="cntVersions">0개 선택</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap align-items-center mt-3 patch-toolbar">
                            <span class="badge text-bg-light border summary-pill" id="previewBadge">조건 미리보기: 품목 또는 버전을 선택하세요</span>
                            <div class="ms-auto d-flex gap-2">
                                <button type="submit" name="mode" value="check" class="btn btn-primary btn-sm">
                                    <i class="fa-solid fa-check me-1"></i>조건 항목 체크
                                </button>
                                <button type="submit" name="mode" value="replace" class="btn btn-dark btn-sm"
                                        onclick="return confirm('기존 패치필요 체크를 모두 해제하고, 이 조건에 해당하는 품목/버전만 다시 체크합니다. 진행할까요?');">
                                    <i class="fa-solid fa-rotate me-1"></i>조건 기준 재설정
                                </button>
                                <button type="submit" name="mode" value="uncheck" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa-solid fa-xmark me-1"></i>조건 항목 체크 해제
                                </button>
                            </div>
                        </div>
                        <div class="text-muted small mt-2">
                            선택한 조건에 해당하는 <strong>품목 행</strong>의 패치필요 필드만 체크됩니다. (그 외 행의 값은 유지)
                        </div>
                    </form>
                </div>
            </div>

            <!-- 목록 -->
            <div class="card">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <form action="/maintenance/patch" method="GET" class="d-flex gap-1" style="width: 300px;">
                        <input type="text" name="search" class="form-control form-control-sm" placeholder="고객사 / 품목 / 제조사 / 버전 검색" value="<%= filters.search %>">
                        <% filters.customers.forEach(function (v) { %><input type="hidden" name="customers" value="<%= v %>"><% }) %>
                        <% filters.items.forEach(function (v) { %><input type="hidden" name="items" value="<%= v %>"><% }) %>
                        <% filters.versions.forEach(function (v) { %><input type="hidden" name="versions" value="<%= v %>"><% }) %>
                        <% if (filters.patch) { %><input type="hidden" name="patch" value="<%= filters.patch %>"><% } %>
                        <input type="hidden" name="cols" id="searchColsInput" value="<%= columns.map(function (c) { return c.key; }).join(',') %>">
                        <button type="submit" class="btn btn-default btn-sm"><i class="fas fa-search"></i></button>
                    </form>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- 컬럼 표시/순서 선택 -->
                        <div class="dropdown">
                            <button type="button" class="btn btn-outline-dark btn-sm dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="columnPickerBtn">
                                <i class="fa-solid fa-table-columns me-1"></i>컬럼 선택
                                <span class="badge text-bg-secondary ms-1" id="columnCountBadge"><%= columns.length %></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end column-picker-menu p-0" id="columnPickerMenu">
                                <div class="px-3 py-2 border-bottom bg-light">
                                    <div class="fw-semibold small">표시할 항목 선택</div>
                                    <div class="text-muted col-hint">체크 후 적용하면 컬럼이 표시됩니다. 헤더를 드래그하면 순서를 바꿀 수 있습니다.</div>
                                </div>
                                <div class="p-2" id="columnPickerList">
                                    <% columnCatalog.forEach(function (group) { %>
                                    <div class="mb-2">
                                        <div class="text-uppercase text-muted fw-semibold px-1" style="font-size:.72rem; letter-spacing:.03em;"><%= group.label %></div>
                                        <% group.columns.forEach(function (col) { %>
                                        <div class="form-check">
                                            <input class="form-check-input col-toggle" type="checkbox"
                                                   id="colchk-<%= col.key %>"
                                                   value="<%= col.key %>"
                                                   data-key="<%= col.key %>"
                                                   data-order="<%= columnKeys.indexOf(col.key) %>"
                                                   <%= columnKeys.indexOf(col.key) >= 0 ? 'checked' : '' %>
                                                   <%= col.key === 'patch_required' ? 'disabled' : '' %>>
                                            <label class="form-check-label col-hint" for="colchk-<%= col.key %>">
                                                <%= col.label %>
                                                <% if (col.key === 'patch_required') { %><span class="badge text-bg-light border ms-1">필수</span><% } %>
                                                <% if (col.editable) { %><span class="badge text-bg-info text-dark ms-1">편집</span><% } %>
                                            </label>
                                        </div>
                                        <% }) %>
                                    </div>
                                    <% }) %>
                                </div>
                                <div class="px-2 py-2 border-top bg-light d-flex gap-2">
                                    <button type="button" class="btn btn-primary btn-sm flex-grow-1" id="applyColumnsBtn">적용</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="resetColumnsBtn" title="기본 컬럼 구성으로 되돌립니다">기본값</button>
                                </div>
                            </div>
                        </div>

                        <span class="badge text-bg-warning dirty-badge" id="dirtyBadge">변경 0건</span>
                        <button type="button" class="btn btn-primary btn-sm" id="saveFieldsBtn" disabled>
                            <i class="fa-solid fa-floppy-disk me-1"></i>변경사항 저장
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="revertFieldsBtn" disabled title="편집 중인 값을 되돌립니다">
                            <i class="fa-solid fa-rotate-left me-1"></i>되돌리기
                        </button>
                        <span class="selection-info text-muted small" id="selectionInfo" title="선택된 고객사(라인)">선택된 라인 없음</span>
                        <button type="button" class="btn btn-outline-success btn-sm" id="addItemBtn" disabled title="목록에서 고객사 라인을 먼저 클릭하세요">
                            <i class="fa-solid fa-plus me-1"></i>품목 추가
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="pasteBtn"
                                title="엑셀에서 복사한 셀 범위를 붙여넣어 여러 품목을 한 번에 업데이트합니다">
                            <i class="fa-solid fa-clipboard-list me-1"></i>엑셀 붙여넣기
                        </button>
                        <div class="btn-group btn-group-sm">
                            <a href="<%= buildUrl('1') %>" class="btn btn-<%= filters.patch === '1' ? 'danger' : 'outline-danger' %>">패치필요만</a>
                            <a href="<%= buildUrl('0') %>" class="btn btn-<%= filters.patch === '0' ? 'success' : 'outline-success' %>">패치불필요만</a>
                            <a href="<%= buildUrl('') %>" class="btn btn-<%= !filters.patch ? 'secondary' : 'outline-secondary' %>">전체</a>
                        </div>
                        <a href="/maintenance/patch/download-excel<%= queryString %>" class="btn btn-success btn-sm">
                            <i class="fa-solid fa-file-excel me-1"></i>엑셀 다운로드
                        </a>
                        <form action="/maintenance/patch/reset" method="POST" class="d-inline"
                              onsubmit="return confirm('모든 품목의 패치필요 체크를 초기화합니다. 계속할까요?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fa-solid fa-eraser me-1"></i>전체 초기화
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover patch-table mb-0" id="patchTable">
                            <thead class="table-light">
                                <tr id="patchHeadRow">
                                    <th style="width:64px;" class="text-center">NO</th>
                                    <% columns.forEach(function (col, ci) { %>
                                    <th class="col-head <%= col.type === 'patch' ? 'text-center' : '' %> <%= col.align === 'center' ? 'text-center' : '' %>"
                                        draggable="true"
                                        data-col-key="<%= col.key %>"
                                        data-col-index="<%= ci %>"
                                        title="드래그하여 컬럼 순서를 변경할 수 있습니다"
                                        style="width:<%= col.width %>px;">
                                        <i class="fa-solid fa-grip-vertical col-drag-handle"></i><%= col.label %>
                                        <% if (col.editable) { %><i class="fa-solid fa-pen-to-square ms-1 text-muted" style="font-size:.72em;"></i><% } %>
                                    </th>
                                    <% }) %>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (rows.length === 0) { %>
                                <tr>
                                    <td colspan="<%= colSpan %>" class="text-center text-muted py-4">
                                        조회된 대상이 없습니다. 유지보수(요약)에 품목과 버전을 먼저 등록해 주세요.
                                    </td>
                                </tr>
                                <% } %>
                                <% rows.forEach(function (r, idx) { %>
                                <tr class="row-selectable <%= Number(r.patch_required) === 1 ? 'patch-needed' : '' %>"
                                    data-row-id="<%= r.id %>"
                                    data-summary-id="<%= r.summary_id %>"
                                    data-customer="<%= r.customer_company || '' %>"
                                    title="클릭하면 이 고객사(라인)를 선택합니다">
                                    <td class="text-center"><%= (currentPage - 1) * 30 + idx + 1 %></td>
                                    <% columns.forEach(function (col) { %>
                                    <% if (col.editable) { %>
                                    <td data-col-key="<%= col.key %>" class="<%= col.align === 'center' ? 'text-center' : '' %>">
                                        <input type="text"
                                               class="form-control form-control-sm field-input field-<%= col.key %>"
                                               data-id="<%= r.id %>"
                                               data-field="<%= col.key %>"
                                               data-original="<%= r[col.key] || '' %>"
                                               value="<%= r[col.key] || '' %>"
                                               placeholder="<%= col.label %> 입력"
                                               autocomplete="off">
                                        <% if (col.key === 'item_version' && Number(r.patch_required) === 1 && r.patch_condition) { %>
                                        <div class="text-muted small mt-1" id="cond-note-<%= r.id %>" title="<%= r.patch_condition %>">
                                            <%= r.patch_required_by || '' %>
                                            <%= r.patch_required_at ? '(' + String(r.patch_required_at).slice(0, 10) + ')' : '' %>
                                        </div>
                                        <% } %>
                                    </td>
                                    <% } else if (col.type === 'patch') { %>
                                    <td data-col-key="<%= col.key %>" class="patch-cell">
                                        <input type="checkbox" class="form-check-input patch-check"
                                               data-id="<%= r.id %>"
                                               <%= Number(r.patch_required) === 1 ? 'checked' : '' %>>
                                    </td>
                                    <% } else { %>
                                    <td data-col-key="<%= col.key %>" class="<%= col.align === 'center' ? 'text-center' : '' %> <%= col.type === 'date' || col.type === 'datetime' ? 'text-nowrap' : '' %>"
                                        title="<%= textValue(r, col) %>">
                                        <%= textValue(r, col) %>
                                    </td>
                                    <% } %>
                                    <% }) %>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer clearfix">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">총 <%= totalRecords %>건 / <%= totalPages %>페이지</span>
                        <ul class="pagination pagination-sm m-0">
                            <% if (currentPage > 1) { %>
                            <li class="page-item"><a class="page-link" href="/maintenance/patch<%= queryString %><%= queryString ? '&' : '?' %>page=<%= currentPage - 1 %>">«</a></li>
                            <% } %>
                            <% var startP = Math.max(1, currentPage - 4); var endP = Math.min(totalPages, startP + 9); %>
                            <% for (var i = startP; i <= endP; i++) { %>
                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                <a class="page-link" href="/maintenance/patch<%= queryString %><%= queryString ? '&' : '?' %>page=<%= i %>"><%= i %></a>
                            </li>
                            <% } %>
                            <% if (currentPage < totalPages) { %>
                            <li class="page-item"><a class="page-link" href="/maintenance/patch<%= queryString %><%= queryString ? '&' : '?' %>page=<%= currentPage + 1 %>">»</a></li>
                            <% } %>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
